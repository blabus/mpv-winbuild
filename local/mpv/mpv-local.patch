+
+/* ======================================================================== cross-device transfer */
+
+/* With NVVFX_XFER_NO_FLUSH: how long a put may wait for the peer's own next
+ * submission before the run side flushes the peer itself (for a peer that has
+ * stopped submitting: a paused or idle VO). A presenting peer gets there
+ * first: its copies were measured complete within 95 ms at a 20 Hz present
+ * rate, and a flush while it presents would block (see the transfer notes). */
+#define NVVFX_PEER_FLUSH_AFTER_MS 150.0
+
+#ifndef CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
+#define CREATE_WAITABLE_TIMER_HIGH_RESOLUTION 0x00000002
+#endif
+
+struct nvvfx_xfer {
+    nvvfx_pipeline *p;
+    nvvfx_runtime *rt;
+    int slots;
+    int in_w, in_h, out_w, out_h;
+    ID3D11Texture2D *in[NVVFX_XFER_MAX_SLOTS], *out[NVVFX_XFER_MAX_SLOTS];
+    HANDLE in_share[NVVFX_XFER_MAX_SLOTS], out_share[NVVFX_XFER_MAX_SLOTS];
+    ID3D11Query *q[NVVFX_XFER_MAX_SLOTS];
+    int keyed;                     /* NVVFX_XFER_KEYED_MUTEX */
+    int no_flush;                  /* NVVFX_XFER_NO_FLUSH */
+    IDXGIKeyedMutex *in_km[NVVFX_XFER_MAX_SLOTS], *out_km[NVVFX_XFER_MAX_SLOTS];
+    int held[NVVFX_XFER_MAX_SLOTS];/* the run side holds both keys of the slot */
+    HANDLE timer;                  /* the run side's naps */
+    volatile LONG peers;
+    CRITICAL_SECTION stats_lock;
+    struct ring wall[NVVFX_XFER_STAT_COUNT];
+};
+
+struct nvvfx_peer {
+    nvvfx_xfer *x;
+    ID3D11Device *dev;
+    ID3D11DeviceContext *ctx;
+    ID3D11Texture2D *in[NVVFX_XFER_MAX_SLOTS], *out[NVVFX_XFER_MAX_SLOTS];
+    ID3D11Query *q[NVVFX_XFER_MAX_SLOTS];
+    IDXGIKeyedMutex *in_km[NVVFX_XFER_MAX_SLOTS], *out_km[NVVFX_XFER_MAX_SLOTS];
+    double put_ms[3];              /* the last put: copy, query end, flush (CPU) */
+};
+
+static int make_shared(nvvfx_xfer *x, int w, int h, UINT bind, ID3D11Texture2D **tex, HANDLE *share,
+                       IDXGIKeyedMutex **km, int level)
+{
+    D3D11_TEXTURE2D_DESC d = {
+        .Width = (UINT)w,
+        .Height = (UINT)h,
+        .MipLevels = 1,
+        .ArraySize = 1,
+        .Format = DXGI_FORMAT_R10G10B10A2_UNORM,
+        .SampleDesc = {1, 0},
+        .Usage = D3D11_USAGE_DEFAULT,
+        .BindFlags = bind,
+        .MiscFlags = x->keyed ? D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX : D3D11_RESOURCE_MISC_SHARED,
+    };
+    IDXGIResource *res = NULL;
+    HRESULT hr = ID3D11Device_CreateTexture2D(x->p->dev, &d, NULL, tex);
+    if (SUCCEEDED(hr))
+        hr = ID3D11Texture2D_QueryInterface(*tex, &nv_iid_dxgi_resource, (void **)&res);
+    if (SUCCEEDED(hr))
+        hr = IDXGIResource_GetSharedHandle(res, share);
+    if (SUCCEEDED(hr) && x->keyed)
+        hr = ID3D11Texture2D_QueryInterface(*tex, &nv_iid_keyed_mutex, (void **)km);
+    if (res)
+        IDXGIResource_Release(res);
+    if (FAILED(hr)) {
+        if (*km)
+            IDXGIKeyedMutex_Release(*km);
+        *km = NULL;
+        if (*tex)
+            ID3D11Texture2D_Release(*tex);
+        *tex = NULL;
+        return fail_at(&x->rt->lg, level, NVVFX_E_D3D, 0, 1, "shared R10G10B10A2_UNORM %dx%d texture "
+                       "(bind 0x%x): HRESULT 0x%08lx", w, h, (unsigned)bind, (unsigned long)hr);
+    }
+    return NVVFX_OK;
+}
+
+nvvfx_xfer *nvvfx_xfer_create(nvvfx_pipeline *p, int slots)
+{
+    return nvvfx_xfer_create_ex(p, slots, NVVFX_XFER_DEFAULT);
+}
+
+nvvfx_xfer *nvvfx_xfer_create_ex(nvvfx_pipeline *p, int slots, int flags)
+{
+    nvvfx_xfer *x;
+    UINT out_bind = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_UNORDERED_ACCESS;
+    int s;
+    if (!p)
+        return NULL;
+    if (slots < 1 || slots > NVVFX_XFER_MAX_SLOTS) {
+        fail(&p->rt->lg, NVVFX_E_ARG, "nvvfx_xfer_create: %d slots (want 1..%d)", slots,
+             NVVFX_XFER_MAX_SLOTS);
+        return NULL;
+    }
+    x = calloc(1, sizeof(*x));
+    if (!x) {
+        fail(&p->rt->lg, NVVFX_E_NOMEM, "out of memory");
+        return NULL;
+    }
+    x->p = p;
+    x->rt = p->rt;
+    x->slots = slots;
+    x->keyed = !!(flags & NVVFX_XFER_KEYED_MUTEX);
+    x->no_flush = !!(flags & NVVFX_XFER_NO_FLUSH);
+    x->in_w = p->info.in_w;
+    x->in_h = p->info.in_h;
+    x->out_w = p->info.out_w;
+    x->out_h = p->info.out_h;
+    InitializeCriticalSection(&x->stats_lock);
+    for (s = 0; s < slots; s++) {
+        D3D11_QUERY_DESC qd = {D3D11_QUERY_EVENT, 0};
+        HRESULT hr;
+        if (make_shared(x, x->in_w, x->in_h, D3D11_BIND_SHADER_RESOURCE, &x->in[s], &x->in_share[s],
+                        &x->in_km[s], NVVFX_LOG_ERROR))
+            goto fail;
+        if (make_shared(x, x->out_w, x->out_h, out_bind, &x->out[s], &x->out_share[s], &x->out_km[s],
+                        (out_bind & D3D11_BIND_UNORDERED_ACCESS) ? NVVFX_LOG_DEBUG : NVVFX_LOG_ERROR)) {
+            if (!(out_bind & D3D11_BIND_UNORDERED_ACCESS))
+                goto fail;
+            /* No shared UAV here: the pipeline then unpacks into a texture of
+             * its own and copies (nvvfx_pipeline_run handles an `out` without
+             * UNORDERED_ACCESS). */
+            out_bind = D3D11_BIND_SHADER_RESOURCE;
+            logm(&x->rt->lg, NVVFX_LOG_INFO, "xfer: the driver refuses a shared UAV texture; "
+                 "unpacking through a private one");
+            if (make_shared(x, x->out_w, x->out_h, out_bind, &x->out[s], &x->out_share[s],
+                            &x->out_km[s], NVVFX_LOG_ERROR))
+                goto fail;
+        }
+        hr = ID3D11Device_CreateQuery(p->dev, &qd, &x->q[s]);
+        if (FAILED(hr)) {
+            d3d_fail(&x->rt->lg, hr, "xfer: CreateQuery(EVENT)");
+            goto fail;
+        }
+    }
+    x->timer = CreateWaitableTimerExW(NULL, NULL, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+                                      TIMER_ALL_ACCESS);
+    if (!x->timer)
+        x->timer = CreateWaitableTimerExW(NULL, NULL, 0, TIMER_ALL_ACCESS);
+    logm(&x->rt->lg, NVVFX_LOG_DEBUG, "xfer: %d slot(s) of shared %dx%d -> %dx%d R10G10B10A2_UNORM, "
+         "output %s", slots, x->in_w, x->in_h, x->out_w, x->out_h,
+         (out_bind & D3D11_BIND_UNORDERED_ACCESS) ? "written directly (shared UAV)" : "copied in");
+    return x;
+
+fail:
+    nvvfx_xfer_destroy(x);
+    return NULL;
+}
+
+void nvvfx_xfer_destroy(nvvfx_xfer *x)
+{
+    int s;
+    if (!x)
+        return;
+    if (InterlockedCompareExchange(&x->peers, 0, 0)) {
+        logm(&x->rt->lg, NVVFX_LOG_ERROR, "nvvfx_xfer_destroy with %ld peer(s) open; leaking it",
+             (long)InterlockedCompareExchange(&x->peers, 0, 0));
+        return;
+    }
+    /* (Legacy shared handles are not kernel handles: nothing to close.) */
+    for (s = 0; s < NVVFX_XFER_MAX_SLOTS; s++) {
+        if (x->in_km[s])
+            IDXGIKeyedMutex_Release(x->in_km[s]);
+        if (x->out_km[s])
+            IDXGIKeyedMutex_Release(x->out_km[s]);
+        if (x->in[s])
+            ID3D11Texture2D_Release(x->in[s]);
+        if (x->out[s])
+            ID3D11Texture2D_Release(x->out[s]);
+        if (x->q[s])
+            ID3D11Query_Release(x->q[s]);
+    }
+    if (x->timer)
+        CloseHandle(x->timer);
+    DeleteCriticalSection(&x->stats_lock);
+    free(x);
+}
+
+int nvvfx_xfer_slots(const nvvfx_xfer *x)
+{
+    return x ? x->slots : 0;
+}
+
+nvvfx_pipeline *nvvfx_xfer_pipeline(const nvvfx_xfer *x)
+{
+    return x ? x->p : NULL;
+}
+
+ID3D11Texture2D *nvvfx_xfer_texture(const nvvfx_xfer *x, int slot, int out)
+{
+    if (!x || slot < 0 || slot >= x->slots)
+        return NULL;
+    return out ? x->out[slot] : x->in[slot];
+}
+
+nvvfx_peer *nvvfx_peer_open(nvvfx_xfer *x, ID3D11Device *peer)
+{
+    nvvfx_peer *pr;
+    int s;
+    if (!x || !peer)
+        return NULL;
+    pr = calloc(1, sizeof(*pr));
+    if (!pr) {
+        fail(&x->rt->lg, NVVFX_E_NOMEM, "out of memory");
+        return NULL;
+    }
+    pr->x = x;
+    pr->dev = peer;
+    ID3D11Device_AddRef(peer);
+    ID3D11Device_GetImmediateContext(peer, &pr->ctx);
+    InterlockedIncrement(&x->peers);
+    for (s = 0; s < x->slots; s++) {
+        D3D11_QUERY_DESC qd = {D3D11_QUERY_EVENT, 0};
+        HRESULT hr = ID3D11Device_OpenSharedResource(peer, x->in_share[s], &nv_iid_texture2d,
+                                                     (void **)&pr->in[s]);
+        if (SUCCEEDED(hr))
+            hr = ID3D11Device_OpenSharedResource(peer, x->out_share[s], &nv_iid_texture2d,
+                                                 (void **)&pr->out[s]);
+        if (SUCCEEDED(hr) && x->keyed)
+            hr = ID3D11Texture2D_QueryInterface(pr->in[s], &nv_iid_keyed_mutex, (void **)&pr->in_km[s]);
+        if (SUCCEEDED(hr) && x->keyed)
+            hr = ID3D11Texture2D_QueryInterface(pr->out[s], &nv_iid_keyed_mutex, (void **)&pr->out_km[s]);
+        if (FAILED(hr)) {
+            d3d_fail(&x->rt->lg, hr, "peer: OpenSharedResource");
+            nvvfx_peer_close(pr);
+            return NULL;
+        }
+        hr = ID3D11Device_CreateQuery(peer, &qd, &pr->q[s]);
+        if (FAILED(hr)) {
+            d3d_fail(&x->rt->lg, hr, "peer: CreateQuery(EVENT)");
+            nvvfx_peer_close(pr);
+            return NULL;
+        }
+    }
+    return pr;
+}
+
+void nvvfx_peer_close(nvvfx_peer *pr)
+{
+    int s;
+    if (!pr)
+        return;
+    for (s = 0; s < NVVFX_XFER_MAX_SLOTS; s++) {
+        if (pr->in_km[s])
+            IDXGIKeyedMutex_Release(pr->in_km[s]);
+        if (pr->out_km[s])
+            IDXGIKeyedMutex_Release(pr->out_km[s]);
+        if (pr->in[s])
+            ID3D11Texture2D_Release(pr->in[s]);
+        if (pr->out[s])
+            ID3D11Texture2D_Release(pr->out[s]);
+        if (pr->q[s])
+            ID3D11Query_Release(pr->q[s]);
+    }
+    if (pr->ctx)
+        ID3D11DeviceContext_Release(pr->ctx);
+    if (pr->dev)
+        ID3D11Device_Release(pr->dev);
+    InterlockedDecrement(&pr->x->peers);
+    free(pr);
+}
+
+/* A peer-side texture argument: R10G10B10A2, single-sample, on the peer
+ * device, subresource `sub` at least w x h. */
+static int check_peer_tex(nvvfx_peer *pr, ID3D11Texture2D *t, UINT sub, int w, int h, const char *what)
+{
+    const struct nv_log *lg = &pr->x->rt->lg;
+    D3D11_TEXTURE2D_DESC d;
+    ID3D11Device *td = NULL;
+    UINT mip;
+    int same;
+    if (!t)
+        return fail(lg, NVVFX_E_ARG, "peer %s: NULL texture", what);
+    ID3D11Texture2D_GetDesc(t, &d);
+    if (!is_rgb10(d.Format) || d.SampleDesc.Count != 1 || !d.MipLevels ||
+        sub >= d.MipLevels * d.ArraySize)
+        return fail(lg, NVVFX_E_ARG, "peer %s: DXGI format %d, %u samples, subresource %u of %u",
+                    what, (int)d.Format, d.SampleDesc.Count, sub, d.MipLevels * d.ArraySize);
+    mip = sub % d.MipLevels;
+    if ((int)(d.Width >> mip) < w || (int)(d.Height >> mip) < h)
+        return fail(lg, NVVFX_E_ARG, "peer %s: subresource %u is %ux%u, smaller than %dx%d", what, sub,
+                    d.Width >> mip, d.Height >> mip, w, h);
+    ID3D11Texture2D_GetDevice(t, &td);
+    same = td == pr->dev;
+    if (td)
+        ID3D11Device_Release(td);
+    if (!same)
+        return fail(lg, NVVFX_E_ARG, "peer %s: the texture is not on the peer device", what);
+    return NVVFX_OK;
+}
+
+int nvvfx_peer_put(nvvfx_peer *pr, int slot, ID3D11Texture2D *src, UINT sub)
+{
+    nvvfx_xfer *x;
+    D3D11_BOX box;
+    int r;
+    if (!pr || slot < 0 || slot >= pr->x->slots)
+        return NVVFX_E_ARG;
+    x = pr->x;
+    r = check_peer_tex(pr, src, sub, x->in_w, x->in_h, "put");
+    if (r)
+        return r;
+    box.left = 0;
+    box.top = 0;
+    box.front = 0;
+    box.right = (UINT)x->in_w;
+    box.bottom = (UINT)x->in_h;
+    box.back = 1;
+    {
+        double t0 = now_ms(), t1, t2;
+        if (pr->in_km[slot]) {
+            /* By the slot rules the run side does not hold it, so this never
+             * waits (see xfer_acquire). */
+            HRESULT hr = IDXGIKeyedMutex_AcquireSync(pr->in_km[slot], 0, 0);
+            if (hr != S_OK)
+                return fail(&x->rt->lg, hr == DXGI_ERROR_DEVICE_REMOVED ? NVVFX_E_PEER_LOST : NVVFX_E_ARG,
+                            "peer put: slot %d input not free (AcquireSync 0x%08lx)", slot, (unsigned long)hr);
+        }
+        ID3D11DeviceContext_CopySubresourceRegion(pr->ctx, (ID3D11Resource *)pr->in[slot], 0, 0, 0, 0,
+                                                  (ID3D11Resource *)src, sub, &box);
+        if (pr->in_km[slot])
+            IDXGIKeyedMutex_ReleaseSync(pr->in_km[slot], 0);
+        t1 = now_ms();
+        ID3D11DeviceContext_End(pr->ctx, (ID3D11Asynchronous *)pr->q[slot]);
+        t2 = now_ms();
+        if (!x->no_flush)
+            ID3D11DeviceContext_Flush(pr->ctx);
+        pr->put_ms[0] = t1 - t0;
+        pr->put_ms[1] = t2 - t1;
+        pr->put_ms[2] = now_ms() - t2;
+    }
+    return NVVFX_OK;
+}
+
+int nvvfx_peer_get(nvvfx_peer *pr, int slot, ID3D11Texture2D *dst, UINT sub)
+{
+    nvvfx_xfer *x;
+    D3D11_BOX box;
+    int r;
+    if (!pr || slot < 0 || slot >= pr->x->slots)
+        return NVVFX_E_ARG;
+    x = pr->x;
+    r = check_peer_tex(pr, dst, sub, x->out_w, x->out_h, "get");
+    if (r)
+        return r;
+    box.left = 0;
+    box.top = 0;
+    box.front = 0;
+    box.right = (UINT)x->out_w;
+    box.bottom = (UINT)x->out_h;
+    box.back = 1;
+    if (pr->out_km[slot]) {
+        /* The run side released it after the private device had finished, so
+         * this never waits (see xfer_acquire). */
+        HRESULT hr = IDXGIKeyedMutex_AcquireSync(pr->out_km[slot], 0, 0);
+        if (hr != S_OK)
+            return fail(&x->rt->lg, hr == DXGI_ERROR_DEVICE_REMOVED ? NVVFX_E_PEER_LOST : NVVFX_E_ARG,
+                        "peer get: slot %d output not ready (AcquireSync 0x%08lx)", slot, (unsigned long)hr);
+    }
+    ID3D11DeviceContext_CopySubresourceRegion(pr->ctx, (ID3D11Resource *)dst, sub, 0, 0, 0,
+                                              (ID3D11Resource *)pr->out[slot], 0, &box);
+    if (pr->out_km[slot])
+        IDXGIKeyedMutex_ReleaseSync(pr->out_km[slot], 0);
+    return NVVFX_OK;
+}
+
+/* ~0.25 ms on a high-resolution waitable timer (Windows 10 1803+), else a
+ * plain one, else Sleep(1). */
+static void xfer_nap(nvvfx_xfer *x)
+{
+    LARGE_INTEGER due;
+    due.QuadPart = -2500;   /* 100-ns units, relative */
+    if (x->timer && SetWaitableTimer(x->timer, &due, 0, NULL, NULL, FALSE)) {
+        WaitForSingleObject(x->timer, 100);
+        return;
+    }
+    Sleep(1);
+}
+
+/* CPU-wait for an event query, polling with GetData(DONOTFLUSH): the device
+ * lock is taken by the runtime for the length of each GetData and never held
+ * here. */
+/* flush_every_ms > 0: a read that may flush the context (GetData without
+ * DONOTFLUSH) is made once the query has not completed for that long, and
+ * again every that long, for a peer whose own submissions have stopped (a
+ * paused or idle VO). */
+static int query_wait(nvvfx_xfer *x, ID3D11Device *dev, ID3D11DeviceContext *ctx, ID3D11Query *q,
+                      int timeout_ms, int lost, const char *what, double flush_every_ms)
+{
+    double t0 = now_ms(), deadline = t0 + (timeout_ms > 0 ? timeout_ms : 0);
+    double next_flush = flush_every_ms > 0 ? t0 + flush_every_ms : deadline + 1;
+    int n = 0;
+    for (;;) {
+        BOOL done = FALSE;
+        UINT gflags = D3D11_ASYNC_GETDATA_DONOTFLUSH;
+        HRESULT hr;
+        if (now_ms() >= next_flush) {
+            gflags = 0;
+            next_flush = now_ms() + flush_every_ms;
+        }
+        hr = ID3D11DeviceContext_GetData(ctx, (ID3D11Asynchronous *)q, &done, sizeof(done), gflags);
+        if (hr == S_OK)
+            return NVVFX_OK;
+        if (FAILED(hr)) {
+            HRESULT why = ID3D11Device_GetDeviceRemovedReason(dev);
+            return fail(&x->rt->lg, lost, "%s: GetData failed: HRESULT 0x%08lx (device removed "
+                        "reason 0x%08lx)", what, (unsigned long)hr, (unsigned long)why);
+        }
+        if (now_ms() >= deadline) {
+            HRESULT why = ID3D11Device_GetDeviceRemovedReason(dev);
+            if (why != S_OK)
+                return fail(&x->rt->lg, lost, "%s: the device was removed (HRESULT 0x%08lx)", what,
+                            (unsigned long)why);
+            return fail(&x->rt->lg, NVVFX_E_TIMEOUT, "%s: not finished after %d ms", what, timeout_ms);
+        }
+        if (n++ < 8)
+            SwitchToThread();
+        else
+            xfer_nap(x);
+    }
+}
+
+int nvvfx_xfer_wait_peer(nvvfx_xfer *x, nvvfx_peer *pr, int slot, int timeout_ms)
+{
+    if (!x || !pr || pr->x != x || slot < 0 || slot >= x->slots)
+        return NVVFX_E_ARG;
+    return query_wait(x, pr->dev, pr->ctx, pr->q[slot], timeout_ms, NVVFX_E_PEER_LOST,
+                      "the video device's copy into the shared texture",
+                      x->no_flush ? NVVFX_PEER_FLUSH_AFTER_MS : 0.0);
+}
+
+/*
+ * Keyed mutexes (NVVFX_XFER_KEYED_MUTEX; not the default). They would not
+ * order anything: the event queries do, on the CPU. Every access, on either
+ * device, is AcquireSync(0) .. ReleaseSync(0), and by the slot rules the other
+ * device never holds the key then, so no acquire waits for the key, and the
+ * GPU wait an acquire implies is on work already seen finished; a single key
+ * also means a frame cancelled after its put, or a result never fetched,
+ * leaves nothing to undo. Kept for diagnosis only: on the peer, AcquireSync
+ * and ReleaseSync submit the peer's commands, and while the peer presents at
+ * vsync a submission from another thread blocks for up to two refreshes with
+ * the device lock held (nvvfx-harness "vo": get median 2.5 ms, worst 33 ms),
+ * which is what NVVFX_XFER_NO_FLUSH exists to avoid.
+ */
+static int xfer_acquire(nvvfx_xfer *x, int slot)
+{
+    HRESULT hr;
+    if (!x->keyed || x->held[slot])
+        return NVVFX_OK;
+    hr = IDXGIKeyedMutex_AcquireSync(x->in_km[slot], 0, 1000);
+    if (hr == S_OK) {
+        hr = IDXGIKeyedMutex_AcquireSync(x->out_km[slot], 0, 1000);
+        if (hr != S_OK)
+            IDXGIKeyedMutex_ReleaseSync(x->in_km[slot], 0);
+    }
+    if (hr != S_OK)
+        return fail(&x->rt->lg, hr == DXGI_ERROR_DEVICE_REMOVED ? NVVFX_E_LOST : NVVFX_E_TIMEOUT,
+                    "xfer: slot %d is held by the peer (AcquireSync 0x%08lx)", slot, (unsigned long)hr);
+    x->held[slot] = 1;
+    return NVVFX_OK;
+}
+
+static void xfer_release_keys(nvvfx_xfer *x, int slot)
+{
+    if (!x->keyed || !x->held[slot])
+        return;
+    IDXGIKeyedMutex_ReleaseSync(x->in_km[slot], 0);
+    IDXGIKeyedMutex_ReleaseSync(x->out_km[slot], 0);
+    x->held[slot] = 0;
+}
+
+int nvvfx_xfer_submit(nvvfx_xfer *x, int slot)
+{
+    nvvfx_pipeline *p;
+    int r;
+    if (!x || slot < 0 || slot >= x->slots)
+        return NVVFX_E_ARG;
+    p = x->p;
+    r = xfer_acquire(x, slot);
+    if (r)
+        return r;
+    r = nvvfx_pipeline_run(p, x->in[slot], x->out[slot]);
+    if (r) {
+        xfer_release_keys(x, slot);
+        HRESULT why = ID3D11Device_GetDeviceRemovedReason(p->dev);
+        if (why != S_OK) {
+            p->broken = 1;
+            return fail(&x->rt->lg, NVVFX_E_LOST, "the NVIDIA device was removed (HRESULT 0x%08lx)",
+                        (unsigned long)why);
+        }
+        return r;
+    }
+    ID3D11DeviceContext_End(p->ctx, (ID3D11Asynchronous *)x->q[slot]);
+    ID3D11DeviceContext_Flush(p->ctx);
+    return NVVFX_OK;
+}
+
+int nvvfx_xfer_wait_done(nvvfx_xfer *x, int slot, int timeout_ms)
+{
+    int r;
+    if (!x || slot < 0 || slot >= x->slots)
+        return NVVFX_E_ARG;
+    r = query_wait(x, x->p->dev, x->p->ctx, x->q[slot], timeout_ms, NVVFX_E_LOST,
+                   "the NVIDIA device's processing", 0.0);
+    /* Finished (or given up on): the keys go back only now, so the peer's
+     * GPU never waits on unfinished work of the private device. */
+    xfer_release_keys(x, slot);
+    return r;
+}
+
+void nvvfx_peer_put_times(const nvvfx_peer *pr, double ms[3])
+{
+    int i;
+    for (i = 0; i < 3; i++)
+        ms[i] = pr ? pr->put_ms[i] : 0;
+}
+
+void nvvfx_xfer_note_times(nvvfx_xfer *x, double wait_peer_ms, double submit_ms, double wait_done_ms)
+{
+    if (!x)
+        return;
+    EnterCriticalSection(&x->stats_lock);
+    ring_push(&x->wall[NVVFX_XFER_WAIT_PEER], wait_peer_ms);
+    ring_push(&x->wall[NVVFX_XFER_SUBMIT], submit_ms);
+    ring_push(&x->wall[NVVFX_XFER_WAIT_DONE], wait_done_ms);
+    ring_push(&x->wall[NVVFX_XFER_CYCLE], wait_peer_ms + submit_ms + wait_done_ms);
+    LeaveCriticalSection(&x->stats_lock);
+}
+
+double nvvfx_now_ms(void)
+{
+    return now_ms();
+}
+
+int nvvfx_xfer_run(nvvfx_xfer *x, nvvfx_peer *pr, int slot, int timeout_ms)
+{
+    double t0 = now_ms(), t1, t2, t3;
+    int r = nvvfx_xfer_wait_peer(x, pr, slot, timeout_ms);
+    t1 = now_ms();
+    if (!r)
+        r = nvvfx_xfer_submit(x, slot);
+    t2 = now_ms();
+    if (!r)
+        r = nvvfx_xfer_wait_done(x, slot, timeout_ms);
+    t3 = now_ms();
+    if (!r)
+        nvvfx_xfer_note_times(x, t1 - t0, t2 - t1, t3 - t2);
+    return r;
+}
+
+void nvvfx_xfer_stats(const nvvfx_xfer *x, int which, nvvfx_stage_stats *out)
+{
+    if (!out)
+        return;
+    memset(out, 0, sizeof(*out));
+    if (!x || which < 0 || which >= NVVFX_XFER_STAT_COUNT)
+        return;
+    EnterCriticalSection((CRITICAL_SECTION *)&x->stats_lock);
+    ring_stats(&x->wall[which], &out->count, &out->median_ms, &out->p99_ms, &out->max_ms,
+               &out->last_ms);
+    LeaveCriticalSection((CRITICAL_SECTION *)&x->stats_lock);
+}
+
+void nvvfx_xfer_reset_stats(nvvfx_xfer *x)
+{
+    if (!x)
+        return;
+    EnterCriticalSection(&x->stats_lock);
+    memset(x->wall, 0, sizeof(x->wall));
+    LeaveCriticalSection(&x->stats_lock);
+}
diff --git a/video/filter/nvvfx_core.h b/video/filter/nvvfx_core.h
new file mode 100644
index 0000000..309d01f
--- /dev/null
+++ b/video/filter/nvvfx_core.h
@@ -0,0 +1,535 @@
+/*
+ * nvvfx_core.h - the NVIDIA-facing core of vf_nvvfx: NVIDIA Video Effects SDK
+ * 1.3 "VideoSuperRes" on Direct3D 11 R10G10B10A2 frames, entirely on the GPU.
+ *
+ * This part has no mpv dependency. It is shared by vf_nvvfx.c (the mp_filter
+ * glue) and by nvvfx-harness, the standalone test program.
+ *
+ * Nothing NVIDIA is linked or shipped: the runtime (NVVideoEffects.dll,
+ * NVCVImage.dll, the CUDA runtime, the VideoSuperRes feature) is found and
+ * loaded at run time with LoadLibrary/GetProcAddress, and every NVIDIA type
+ * is declared privately in nvvfx_core.c.
+ *
+ * Pipeline per frame (all GPU work; the CPU never touches a pixel):
+ *
+ *   in (R10G10B10A2_UNORM, caller's)
+ *     -> transport in  : D3D11 side + CUDA map/copy/unmap into a linear CUDA buffer
+ *     -> stage 1       : Deblur at the input size          (QualityLevel 12..15)
+ *     -> stage 2       : HighBitrate (16..19) or VSR (1..4) upscale to the output size
+ *     -> transport out : CUDA map/copy/unmap + D3D11 side
+ *   out (R10G10B10A2_UNORM, caller's)
+ *
+ * Either stage can be off; with both off the pipeline is a transport round
+ * trip (used to prove bit-exactness).
+ *
+ * Transports (nvvfx_config.transport):
+ *   DIRECT - an internal R10G10B10A2_UNORM texture is registered with CUDA and
+ *            the caller's textures are copied to/from it (CopySubresourceRegion).
+ *            On the 1.3 runtime NvCVImage_InitFromD3D11Texture refuses it
+ *            (NVCV_ERR_PIXELFORMAT; NvCVImage_FromD3DFormat has no mapping for
+ *            R10G10B10A2). Kept because a later runtime might accept it.
+ *   R32    - a compute pass repacks the R10G10B10A2 word bit-exactly into an
+ *            internal R32_UINT texture (NvCVImage maps it to NVCV_Y/NVCV_U32),
+ *            and back on the way out; R8G8B8A8_UINT (NVCV_RGBA/NVCV_U8) is the
+ *            second choice. Measured bit-exact; the whole round trip costs
+ *            0.56 ms at 3840x2160 and ~1 ms in+out for 4K -> 8K.
+ *   AUTO   - DIRECT, then R32. (On 1.3 this is always R32.)
+ *
+ * Textures:
+ *   in  : DXGI_FORMAT_R10G10B10A2_UNORM (or _TYPELESS), ArraySize 1, no MSAA,
+ *         exactly cfg.in_w x cfg.in_h. No bind flag is required;
+ *         D3D11_BIND_SHADER_RESOURCE lets the R32 transport read it directly
+ *         instead of copying it first.
+ *   out : created by the caller from nvvfx_pipeline_out_desc() (R10G10B10A2_UNORM,
+ *         SHADER_RESOURCE | UNORDERED_ACCESS, the negotiated output size). The
+ *         caller may OR in more bind flags. A texture without UNORDERED_ACCESS
+ *         still works (the R32 transport then writes an internal texture and
+ *         copies it), at the cost of one extra copy per frame.
+ *   The caller owns `out` because mpv's frame pools already manage the
+ *   lifetime of textures handed to the VO; a pipeline-owned output would need a
+ *   second, refcounted pool that knows when the VO is done with a frame.
+ *
+ * Device and threading:
+ *   - A pipeline belongs on a device of its own: nvvfx_device_create() makes
+ *     one on the adapter of the device that decodes and presents, and frames
+ *     cross between the two through nvvfx_xfer (see "cross-device transfer"
+ *     below). Never create a pipeline on a device that presents: on such a
+ *     device CUDA's D3D11 interop calls were measured blocking for 1-3 s and
+ *     a frame's GPU span reaching 1.6 s (nvvfx-harness "vorepro"; in mpv the
+ *     same structure reset the driver within seconds).
+ *   - Any thread may call (the CUDA device is made current at the start of
+ *     every call), one call per pipeline at a time. Measured: a pipeline created
+ *     on a worker thread runs correctly from another thread, and the device
+ *     stays responsive to other threads during creation (worst 5 ms stall
+ *     seen). So nvvfx_pipeline_create, which blocks for ~500 ms cold (~120 ms
+ *     while nvvfx_runtime_keep_warm holds an instance), can be kept off a
+ *     playloop. Running one pipeline while another thread creates or destroys
+ *     another works (nvvfx-harness "concurrent": no wrong frames; a run then
+ *     blocks up to ~50-80 ms). Creations and destructions themselves should be
+ *     serialised by the caller.
+ *   - The D3D11 device may be shared with a hardware decoder and a renderer on
+ *     other threads. The pipeline holds the device's multithread lock
+ *     (ID3D10Multithread / ID3D11Multithread - the same interface, same IID,
+ *     the one mpv's own d3d11 hwdec uses) around its own immediate-context
+ *     sequences only (copies, repack dispatches, event queries), and NEVER
+ *     across a CUDA, NvCVImage or NvVFX call: CUDA's D3D11 interop (map,
+ *     unmap, register, unregister) takes CUDA's lock first and the device lock
+ *     second, so holding the device lock into such a call is a lock-order
+ *     inversion (it deadlocked nvvfx-harness "concurrent"). Callers must keep
+ *     the same rule. If the device is not yet multithread-protected,
+ *     nvvfx_pipeline_create() turns protection on (and logs it once), because a
+ *     shared immediate context is not safe without it.
+ *   - Immediate-context state the pipeline touches is saved and restored: the
+ *     compute shader (with its class instances), CS SRV slot 0 and CS UAV
+ *     slot 0. Nothing else is bound.
+ *   - NVIDIA's 1.3 SDK does not give back the GPU memory of an effect instance
+ *     destroyed while any other instance exists (~0.8 GB per 4K instance,
+ *     ~1.7 GB for a 4K -> 8K upscale, until the process exits). A long-lived
+ *     caller should keep pipelines rather than destroy them.
+ *
+ * Errors: every failure produces exactly one log line (with the SDK's own error
+ * string when it has one) and a negative NVVFX_E_* code; nothing crashes, and a
+ * run never returns with a resource still mapped. The last error is kept in
+ * nvvfx_runtime_last_error(), which is shared by every pipeline of the runtime:
+ * with calls on several threads, rely on the log line instead.
+ */
+
+#ifndef MP_NVVFX_CORE_H
+#define MP_NVVFX_CORE_H
+
+#include <stddef.h>
+#include <wchar.h>
+
+#include <windows.h>
+#include <d3d11.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* ------------------------------------------------------------------ errors */
+
+#define NVVFX_OK              0
+#define NVVFX_E_ARG          -1  /* bad argument: NULL, wrong size/format/flags */
+#define NVVFX_E_D3D          -2  /* a D3D11/DXGI call failed */
+#define NVVFX_E_SDK          -3  /* an NvVFX/NvCVImage call failed (sdk_status says which) */
+#define NVVFX_E_CUDA         -4  /* a CUDA runtime call failed */
+#define NVVFX_E_NOMEM        -5
+#define NVVFX_E_UNSUPPORTED  -6  /* the runtime/device cannot do what was asked */
+#define NVVFX_E_BROKEN       -7  /* an earlier failure left the pipeline unusable: recreate it */
+#define NVVFX_E_RUNTIME      -8  /* runtime not found or incomplete */
+#define NVVFX_E_TIMEOUT      -9  /* a bounded wait for the GPU ran out */
+#define NVVFX_E_LOST        -10  /* the core's own (private) device was removed: the GPU was reset */
+#define NVVFX_E_PEER_LOST   -11  /* the peer device (the VO's) was removed */
+
+const char *nvvfx_strerror(int err);
+
+typedef struct nvvfx_error {
+    int code;        /* NVVFX_E_*, 0 if none */
+    int sdk_status;  /* NvCV_Status of the SDK call that failed (0 if not an SDK failure) */
+    int refused;     /* nonzero: the SDK rejected a mode/size/parameter, as opposed to failing */
+    char msg[384];   /* the log line that reported it */
+} nvvfx_error;
+
+/* ------------------------------------------------------------------ logging */
+
+#define NVVFX_LOG_ERROR 0
+#define NVVFX_LOG_WARN  1
+#define NVVFX_LOG_INFO  2
+#define NVVFX_LOG_DEBUG 3
+
+/* One line per call, UTF-8, no trailing newline. May be called from SDK
+ * threads when SDK logging is on (nvvfx_runtime_set_sdk_log), so it must be
+ * thread-safe. */
+typedef void (*nvvfx_log_fn)(void *ctx, int level, const char *msg);
+
+/* ------------------------------------------------------------------ runtime */
+
+typedef struct nvvfx_runtime nvvfx_runtime;
+
+typedef struct nvvfx_runtime_info {
+    char root[520];             /* the search candidate that matched (UTF-8) */
+    char core_dir[520];         /* where NVVideoEffects.dll was found */
+    char feature_dir[520];      /* where nvVFXVideoSuperRes.dll was found */
+    unsigned sdk_version;       /* NvVFX_GetVersion(), 0 if not exported */
+    char sdk_version_str[32];   /* "1.3.0.0" from NvVFX_GetVersion, or "" */
+    char core_file_version[32]; /* file version of NVVideoEffects.dll */
+    char feature_file_version[32]; /* nvVFXVideoSuperRes.dll; "" in 1.3, which has no version
+                                      resource (the effect's Info string starts with
+                                      "VideoSuperRes 1.3.0.0") */
+    char ngx_file_version[32];  /* nvngx_vsr.dll, "" if not found */
+    char cudart_name[64];       /* e.g. "cudart64_12.dll" */
+    int cudart_version;         /* cudaRuntimeGetVersion, e.g. 12080; 0 if unknown */
+    int cuda_driver_version;    /* cudaDriverGetVersion; 0 if unknown */
+    char wrap_export[48];       /* which D3D11 wrap export resolved */
+    const char *effects;        /* NvVFX_GetString(NULL, "Info"), or NULL */
+} nvvfx_runtime_info;
+
+/*
+ * Find and load the runtime. Tried in order, first complete one wins:
+ *   1. dir_or_null
+ *   2. %NV_VIDEO_EFFECTS_PATH% (unless it is "USE_APP_PATH")
+ *   3. %LOCALAPPDATA%\htpc-player\nvvfx
+ *   4. %ProgramFiles%\NVIDIA Corporation\NVIDIA Video Effects
+ * A candidate may be the SDK root (bin\ and features\nvvfxvideosuperres\bin\
+ * beneath it), its bin\ folder, or one flat folder holding every DLL (the
+ * layout of NVIDIA's nvidia-vfx 0.2.0.0 package, the one verified).
+ * The runtime DLLs need the MSVC 2015-2022 C++ runtime (MSVCP140.dll,
+ * VCRUNTIME140.dll) on the machine.
+ * Returns NULL after one log line naming what was searched or what was missing.
+ * The DLLs stay mapped for the life of the process after nvvfx_runtime_unload
+ * (the CUDA runtime and NGX keep threads and state that do not survive being
+ * unmapped); loading again is then nearly free.
+ */
+nvvfx_runtime *nvvfx_runtime_load(const wchar_t *dir_or_null, nvvfx_log_fn log, void *log_ctx);
+
+/* All pipelines must have been destroyed (a keep-warm pipeline is destroyed
+ * here). NULL is a no-op. */
+void nvvfx_runtime_unload(nvvfx_runtime *rt);
+
+/*
+ * Keep the SDK's process-wide state alive between pipelines. Measured on an RTX
+ * 4090 with the 1.3 runtime: the first NvVFX_Load in a process with no other
+ * VideoSuperRes effect alive costs ~400 ms; while any effect is alive, a Load
+ * costs ~25 ms, so a 4K -> 8K deblur+upscale pipeline creates in ~140 ms
+ * instead of ~520 ms. This holds a minimal pipeline (640x360 Deblur Low) on
+ * `dev` until nvvfx_runtime_cool() or unload. It holds a reference on `dev`:
+ * cool it before that device goes away. Returns NVVFX_OK if warm (already
+ * warm on the same device is OK; on another device it re-warms there).
+ */
+int nvvfx_runtime_keep_warm(nvvfx_runtime *rt, ID3D11Device *dev);
+void nvvfx_runtime_cool(nvvfx_runtime *rt);
+
+const nvvfx_runtime_info *nvvfx_runtime_get_info(const nvvfx_runtime *rt);
+const nvvfx_error *nvvfx_runtime_last_error(const nvvfx_runtime *rt);
+void nvvfx_runtime_clear_error(nvvfx_runtime *rt);
+
+/* Route the SDK's own log (NvVFX_ConfigureLogger) to the log callback.
+ * verbosity: -1 off, 0 fatal, 1 error, 2 warning (the default after load), 3 info. */
+int nvvfx_runtime_set_sdk_log(nvvfx_runtime *rt, int verbosity);
+
+/* Diagnostics for the harness. Each returns the NvCV_Status / cudaError of the
+ * call, or NVVFX_E_UNSUPPORTED if the runtime does not export it. */
+int nvvfx_runtime_d3d_format(nvvfx_runtime *rt, DXGI_FORMAT fmt,
+                             int *pixel_format, int *component_type, int *layout);
+int nvvfx_runtime_describe_effect(nvvfx_runtime *rt, char *buf, size_t size);
+int nvvfx_runtime_cuda_mem(nvvfx_runtime *rt, ID3D11Device *dev,
+                           unsigned long long *free_bytes, unsigned long long *total_bytes);
+
+/* ------------------------------------------------------------------ pipeline */
+
+#define NVVFX_UPSCALE_OFF          0
+#define NVVFX_UPSCALE_HIGHBITRATE  1  /* level 1..4 = QualityLevel 16..19 */
+#define NVVFX_UPSCALE_VSR          2  /* level 1..4 = QualityLevel 1..4 */
+
+#define NVVFX_TRANSPORT_AUTO    0
+#define NVVFX_TRANSPORT_DIRECT  1
+#define NVVFX_TRANSPORT_R32     2
+
+/* CPU-side synchronisation after each effect run. NVVFX_SYNC_NONE is the
+ * default and the right choice: VideoSuperRes's work is ordered on the
+ * pipeline's blocking CUDA stream, and the interop unmap orders the D3D11 side
+ * after it, so a run returns after queuing (~0.5 ms of CPU at 4K -> 8K) and the
+ * output is correct when D3D11 next reads it (nvvfx-harness "order": 8
+ * back-to-back frames, alternating inputs, no CPU wait, all bit-identical to
+ * one-at-a-time references; "levels" identical under every mode). The other
+ * modes block the calling thread for the whole GPU time (~31 ms for 4K -> 8K
+ * deblur-4 + highbitrate-4) and exist for diagnosis. */
+#define NVVFX_SYNC_NONE    0  /* rely on stream order + the interop unmap guarantee (default) */
+#define NVVFX_SYNC_STREAM  1  /* stream-synchronise after each effect run */
+#define NVVFX_SYNC_DEVICE  2  /* cudaDeviceSynchronize after each effect run */
+
+/* nvvfx_config.timing. */
+#define NVVFX_TIMING_OFF     0  /* only NVVFX_STAGE_TOTAL wall (CPU) time */
+#define NVVFX_TIMING_SYNC    1  /* synchronise after every stage: real per-stage wall times and
+                                   GPU times, and the run call blocks for the whole frame */
+#define NVVFX_TIMING_EVENTS  2  /* GPU times only, from CUDA events recorded on the stream with
+                                   no synchronisation; a frame's events are read at the start
+                                   of the next run (by then they have normally completed, so
+                                   the read does not wait), so the run call still only queues */
+
+typedef struct nvvfx_config {
+    int in_w, in_h;
+    int deblur_level;        /* 0 = off, 1..4 = Deblur Low..Ultra (QualityLevel 12..15) */
+    float deblur_strength;   /* 0..1 ("Strength") */
+    int upscale_family;      /* NVVFX_UPSCALE_* */
+    int upscale_level;       /* 1..4 */
+    float upscale_strength;  /* 0..1 */
+    int target_w, target_h;  /* the box the output must fit in (aspect kept) */
+    int transport;           /* NVVFX_TRANSPORT_* */
+    int sync;                /* NVVFX_SYNC_* */
+    int timing;              /* NVVFX_TIMING_*. SYNC (or any other nonzero value but
+                                EVENTS): synchronise at the end of every stage so the
+                                per-stage wall times are real GPU-inclusive times (a few
+                                tens of us of extra stalls per frame, and the run call
+                                then blocks for the whole frame). EVENTS: GPU times only,
+                                one frame late, no synchronisation. OFF: only the
+                                NVVFX_STAGE_TOTAL wall time is recorded, and it is the
+                                CPU time of the run call, not the GPU time. */
+    int exact;               /* tests only: the output is exactly target_w x target_h,
+                                with no fit, no fallback, and the upscale stage live even
+                                at 1x; a refusal fails create */
+    int run_async;           /* the NvVFX_Run async flag; 0 as NVIDIA's sample. Measured:
+                                NvVFX_Run(..., 0) does not block either; both queue on
+                                the stream and take the same GPU time */
+} nvvfx_config;
+
+/* Strengths 1.0 (the SDK default), stages off, transport auto, sync none. */
+void nvvfx_config_defaults(nvvfx_config *cfg);
+
+typedef struct nvvfx_pipeline nvvfx_pipeline;
+
+#define NVVFX_STAGE_IN       0  /* caller texture -> linear CUDA buffer */
+#define NVVFX_STAGE_DEBLUR   1
+#define NVVFX_STAGE_UPSCALE  2
+#define NVVFX_STAGE_OUT      3  /* linear CUDA buffer -> caller texture */
+#define NVVFX_STAGE_TOTAL    4
+#define NVVFX_STAGE_COUNT    5
+
+const char *nvvfx_stage_name(int stage);
+
+typedef struct nvvfx_pipeline_info {
+    int in_w, in_h;
+    int out_w, out_h;            /* what nvvfx_pipeline_out_desc() describes */
+    int deblur_live, upscale_live;
+    unsigned deblur_quality;     /* the SDK QualityLevel in force (0 if not live) */
+    unsigned upscale_quality;
+    float deblur_strength, upscale_strength;
+    int strength_supported[2];   /* [0] deblur, [1] upscale: "Strength" was accepted */
+    int encoding_mode_supported; /* "ImageEncodingMode" was accepted */
+    const char *quality_selector;/* "QualityLevel" or "Mode", whichever took the level */
+    int transport;               /* NVVFX_TRANSPORT_DIRECT or _R32: what was chosen */
+    int transport_format;        /* the DXGI_FORMAT registered with CUDA: R10G10B10A2_UNORM
+                                    (direct), R32_UINT or R8G8B8A8_UINT (r32) */
+    int cuda_device;
+    double create_ms[2];         /* CreateEffect + parameters, per stage */
+    double load_ms[2];           /* NvVFX_Load */
+    double first_run_ms[2];      /* the validation run made at create */
+    char fallback[200];          /* "" or what the negotiation gave up on, in words */
+} nvvfx_pipeline_info;
+
+/*
+ * Output size: the input is fitted into the target box preserving its aspect
+ * (even dimensions). A scale <= 1, or upscale off, means no upscale stage and
+ * output = input. If the SDK refuses the fitted size, the integer factors 4x,
+ * 3x, 2x that fit the box are tried, largest first, then no upscale - one log
+ * line says what happened (also in info.fallback). A Deblur stage the SDK
+ * refuses is dropped the same way. Each stage is loaded and run once before
+ * this returns, so a returned pipeline has been seen to work.
+ * Measured on 1.3: every size tried was accepted (3840x2160 -> 7680x4320,
+ * 1920x1080 -> 7680x4320, 3840x1600 -> 7680x3200, 1.333x, 2.344x, odd inputs),
+ * and so were HighBitrate and VSR at 1x; no fallback has been seen to fire.
+ * A 4K -> 8K deblur + upscale pipeline holds ~2 GB of GPU memory.
+ * Returns NULL on failure (see nvvfx_runtime_last_error).
+ */
+nvvfx_pipeline *nvvfx_pipeline_create(nvvfx_runtime *rt, ID3D11Device *dev,
+                                      const nvvfx_config *cfg);
+void nvvfx_pipeline_destroy(nvvfx_pipeline *p);
+
+const nvvfx_pipeline_info *nvvfx_pipeline_get_info(const nvvfx_pipeline *p);
+
+/* The texture `out` must be created from. */
+void nvvfx_pipeline_out_desc(const nvvfx_pipeline *p, D3D11_TEXTURE2D_DESC *desc);
+
+/* One frame, in -> out, on the device's immediate context. Returns NVVFX_OK or a
+ * negative NVVFX_E_*; after NVVFX_E_BROKEN the pipeline must be recreated. */
+int nvvfx_pipeline_run(nvvfx_pipeline *p, ID3D11Texture2D *in, ID3D11Texture2D *out);
+
+/* Live changes on a loaded pipeline. A negative value leaves that stage alone.
+ * Return 1 if the SDK accepted every change without recreating anything, 0 if it
+ * refused one (nothing changed for that stage; recreate the pipeline to apply
+ * it), negative on error. set_levels cannot turn a stage on or off, nor switch
+ * the upscale family's QualityLevel range - that is a refusal.
+ * Measured on 1.3: both strength and level changes are accepted and take
+ * effect on the very next run with no NvVFX_Load (the output after a reload is
+ * identical). The first run after a level change costs ~15 ms extra (the new
+ * model is set up then); a strength change costs nothing.
+ * nvvfx_pipeline_reload() runs NvVFX_Load on every live stage; it is not needed
+ * for either change. */
+int nvvfx_pipeline_set_strength(nvvfx_pipeline *p, float deblur, float upscale);
+int nvvfx_pipeline_set_levels(nvvfx_pipeline *p, int deblur_level, int upscale_level);
+int nvvfx_pipeline_reload(nvvfx_pipeline *p);
+
+/* Per-stage timing over the last NVVFX_STATS_RING frames. The samples are
+ * reset whenever nvvfx_pipeline_set_levels() changes a level, so the medians
+ * describe the levels in force. Safe to read from another thread while a run
+ * is in progress (the rings are locked). Wall times are QPC;
+ * GPU times are CUDA events around the CUDA part of a stage (timing SYNC or
+ * EVENTS only); the GPU time of NVVFX_STAGE_TOTAL runs from the start of the
+ * CUDA part of transfer in to the end of the CUDA part of transfer out.
+ * Without cfg.timing only NVVFX_STAGE_TOTAL has (wall) samples; with EVENTS
+ * only GPU samples are recorded besides that. */
+#define NVVFX_STATS_RING 512
+
+typedef struct nvvfx_stage_stats {
+    int count;
+    double last_ms, median_ms, p99_ms, max_ms;
+    int gpu_count;
+    double gpu_median_ms, gpu_p99_ms;
+    double gpu_max_ms;
+} nvvfx_stage_stats;
+
+void nvvfx_pipeline_stats(const nvvfx_pipeline *p, int stage, nvvfx_stage_stats *out);
+void nvvfx_pipeline_reset_stats(nvvfx_pipeline *p);
+
+/* ------------------------------------------------------------------ private device */
+
+/*
+ * A D3D11 device of the core's own, on the adapter with this LUID, created the
+ * way nvvfx-harness has always created its device (feature level 11_1 or 11_0,
+ * BGRA and video support flags) and multithread-protected. Nothing else ever
+ * lives on it: no swapchain, no decoder, no video processor. d3d11.dll and
+ * dxgi.dll are loaded at run time, so no import library is needed. Returns
+ * NULL after one log line.
+ */
+typedef struct nvvfx_device nvvfx_device;
+
+nvvfx_device *nvvfx_device_create(const LUID *luid, nvvfx_log_fn log, void *log_ctx);
+void nvvfx_device_destroy(nvvfx_device *d);
+ID3D11Device *nvvfx_device_d3d11(const nvvfx_device *d);   /* no reference is added */
+LUID nvvfx_device_luid(const nvvfx_device *d);
+const char *nvvfx_device_name(const nvvfx_device *d);
+/* S_OK while the device is usable, else what GetDeviceRemovedReason says. */
+HRESULT nvvfx_device_removed_reason(const nvvfx_device *d);
+
+/* The adapter LUID of any D3D11 device. NVVFX_OK or NVVFX_E_D3D. */
+int nvvfx_adapter_luid(ID3D11Device *dev, LUID *luid);
+
+/* ------------------------------------------------------------------ cross-device transfer */
+
+/*
+ * How frames reach a pipeline on a private device from the device that
+ * decodes and presents them (the "peer": mpv's VO device), and come back:
+ *
+ *   peer (any one thread):   frame -> in[slot] (CopySubresourceRegion),
+ *                            End(peer query[slot]), Flush        nvvfx_peer_put
+ *   run side (one thread):   CPU-wait for the peer query          nvvfx_xfer_wait_peer
+ *                            pipeline in[slot] -> out[slot],
+ *                            End(query[slot]), Flush              nvvfx_xfer_submit
+ *                            CPU-wait for that query              nvvfx_xfer_wait_done
+ *   peer:                    out[slot] -> frame (CopySubresourceRegion)   nvvfx_peer_get
+ *
+ * in[] and out[] are R10G10B10A2_UNORM textures created on the private device
+ * with D3D11_RESOURCE_MISC_SHARED (in: SHADER_RESOURCE; out: SHADER_RESOURCE |
+ * UNORDERED_ACCESS, or SHADER_RESOURCE alone if the driver refuses a shared
+ * UAV, at the cost of one more copy on the private device) and opened on the
+ * peer with OpenSharedResource. Measured on an RTX 4090 (nvvfx-harness
+ * "sharecaps"): R10G10B10A2_UNORM, R32_UINT and R8G8B8A8_UNORM all report
+ * FORMAT_SUPPORT2_SHAREABLE and share with SRV, RT and UAV in any combination;
+ * an open costs ~0.02 ms. Nothing registered with CUDA is ever shared.
+ *
+ * Synchronisation is a CPU wait, on the run side, for an event query on the
+ * device that produced the data: no device is ever made to wait on the GPU
+ * for the other one (no keyed mutex, no shared fence), so the peer's GPU
+ * queue can never stall behind SDK work. A put ends a query that covers every
+ * earlier command of the peer's immediate context, so the run that follows a
+ * put into a slot also waits for the previous get from that slot. The waits
+ * poll GetData(DONOTFLUSH) with ~0.25 ms high-resolution sleeps and give up
+ * after timeout_ms with NVVFX_E_TIMEOUT; a removed device is NVVFX_E_LOST
+ * (private) or NVVFX_E_PEER_LOST (peer).
+ *
+ * The peer is never flushed by default (NVVFX_XFER_NO_FLUSH): a put only
+ * records a copy and a query end, and the peer's own next submission (mpv's
+ * VO renders and presents every refresh) carries them to the GPU. Measured
+ * (nvvfx-harness "vo", --flush-probe): on a device presenting at vsync, a
+ * Flush from another thread - even of one 16x16 copy, with no SDK anywhere -
+ * blocks for 7 ms on average at 60 Hz and 15 ms at 20 Hz, worst 80-98 ms,
+ * holding the device's lock, so every other thread on the device waits too
+ * (0.19 ms without a presenter). The keyed-mutex calls submit as well and
+ * block the same way. The cost of not flushing is latency: a put completes
+ * when the peer has next submitted and its GPU has reached the copy, measured
+ * at a median 13 ms / worst 34 ms at 60 Hz and 18-22 ms / worst 95 ms at
+ * 20 Hz, so a caller should keep several frames in flight (vf_nvvfx keeps
+ * four: at 24 fps and a 20 Hz present rate two slots left half the results
+ * late, three left 4% late with the heaviest settings, four none). If a put
+ * has not completed after
+ * NVVFX_PEER_FLUSH_AFTER_MS (150 ms; a paused or idle peer), the run side
+ * flushes the peer itself (a GetData without DONOTFLUSH).
+ *
+ * Slot rules (the caller's to keep): put into a slot only when no run of it is
+ * in progress; get from it only after its run returned NVVFX_OK and before the
+ * next put into it. The peer functions never wait, and never call CUDA or the
+ * SDK. The run side never holds a device lock across a call.
+ */
+#define NVVFX_XFER_MAX_SLOTS 4
+
+typedef struct nvvfx_xfer nvvfx_xfer;
+typedef struct nvvfx_peer nvvfx_peer;
+
+/* For a pipeline (on whatever device it was created on). The xfer does not own
+ * the pipeline; destroy the xfer first. NULL after one log line. */
+nvvfx_xfer *nvvfx_xfer_create(nvvfx_pipeline *p, int slots);
+#define NVVFX_XFER_LEGACY_SHARED  0  /* D3D11_RESOURCE_MISC_SHARED textures */
+#define NVVFX_XFER_KEYED_MUTEX    1  /* D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX (diagnosis only) */
+#define NVVFX_XFER_NO_FLUSH       2  /* a put does not flush the peer: the peer's own next
+                                        submission carries it (see the transfer notes) */
+#define NVVFX_XFER_DEFAULT        (NVVFX_XFER_LEGACY_SHARED | NVVFX_XFER_NO_FLUSH)
+nvvfx_xfer *nvvfx_xfer_create_ex(nvvfx_pipeline *p, int slots, int flags);
+void nvvfx_xfer_destroy(nvvfx_xfer *x);
+int nvvfx_xfer_slots(const nvvfx_xfer *x);
+nvvfx_pipeline *nvvfx_xfer_pipeline(const nvvfx_xfer *x);
+/* The private textures of a slot (tests). */
+ID3D11Texture2D *nvvfx_xfer_texture(const nvvfx_xfer *x, int slot, int out);
+
+/* The xfer's textures opened on `peer`, plus one event query per slot there.
+ * Closing a peer releases only peer-side objects; the xfer stays usable for
+ * another peer. A peer must be closed before its xfer is destroyed. */
+nvvfx_peer *nvvfx_peer_open(nvvfx_xfer *x, ID3D11Device *peer);
+void nvvfx_peer_close(nvvfx_peer *pr);
+
+/* Peer side. put: copy the top-left in_w x in_h of `src` (subresource `sub`;
+ * R10G10B10A2, on the peer device) into in[slot] and End the slot's peer query
+ * (and Flush, without NVVFX_XFER_NO_FLUSH). get: copy out[slot] into the
+ * top-left out_w x out_h of `dst` (subresource `sub`). Neither waits.
+ * NVVFX_OK or NVVFX_E_ARG. */
+int nvvfx_peer_put(nvvfx_peer *pr, int slot, ID3D11Texture2D *src, UINT sub);
+int nvvfx_peer_get(nvvfx_peer *pr, int slot, ID3D11Texture2D *dst, UINT sub);
+/* The CPU time of the last put's three calls: copy, query end, flush (ms). */
+void nvvfx_peer_put_times(const nvvfx_peer *pr, double ms[3]);
+
+/* Run side, one thread at a time per xfer. */
+int nvvfx_xfer_wait_peer(nvvfx_xfer *x, nvvfx_peer *pr, int slot, int timeout_ms);
+int nvvfx_xfer_submit(nvvfx_xfer *x, int slot);
+int nvvfx_xfer_wait_done(nvvfx_xfer *x, int slot, int timeout_ms);
+/* The three in order, timed into the xfer's stats. */
+int nvvfx_xfer_run(nvvfx_xfer *x, nvvfx_peer *pr, int slot, int timeout_ms);
+/* For a caller that makes the three calls itself: record one run's times. */
+void nvvfx_xfer_note_times(nvvfx_xfer *x, double wait_peer_ms, double submit_ms, double wait_done_ms);
+/* The core's clock (QueryPerformanceCounter, ms). */
+double nvvfx_now_ms(void);
+
+/* Wall times of nvvfx_xfer_run over the last NVVFX_STATS_RING runs (count,
+ * median_ms, p99_ms, max_ms, last_ms of nvvfx_stage_stats; no GPU times). */
+#define NVVFX_XFER_WAIT_PEER  0  /* waiting for the peer's put to complete */
+#define NVVFX_XFER_SUBMIT     1  /* the pipeline run call (CPU: queuing) */
+#define NVVFX_XFER_WAIT_DONE  2  /* from the end of the submit to the private device's completion */
+#define NVVFX_XFER_CYCLE      3  /* the whole nvvfx_xfer_run */
+#define NVVFX_XFER_STAT_COUNT 4
+
+void nvvfx_xfer_stats(const nvvfx_xfer *x, int which, nvvfx_stage_stats *out);
+void nvvfx_xfer_reset_stats(nvvfx_xfer *x);
+
+/* ------------------------------------------------------------------ repack */
+
+/*
+ * The R32 transport's D3D11 halves on their own (they need no NVIDIA runtime;
+ * the pipeline uses the same code). Textures are single-subresource-0 2D:
+ *   pack:   src R10G10B10A2_UNORM/_TYPELESS with SHADER_RESOURCE
+ *           -> dst R32_UINT with UNORDERED_ACCESS
+ *   unpack: src R32_UINT with SHADER_RESOURCE
+ *           -> dst R10G10B10A2_UNORM/_TYPELESS with UNORDERED_ACCESS
+ * Same size both sides. Holds the device's multithread lock and saves/restores
+ * the CS state it touches. Requires feature level 11_0.
+ */
+typedef struct nvvfx_repack nvvfx_repack;
+
+nvvfx_repack *nvvfx_repack_create(ID3D11Device *dev, nvvfx_log_fn log, void *log_ctx);
+void nvvfx_repack_destroy(nvvfx_repack *rp);
+int nvvfx_repack_pack(nvvfx_repack *rp, ID3D11Texture2D *src, ID3D11Texture2D *dst);
+int nvvfx_repack_unpack(nvvfx_repack *rp, ID3D11Texture2D *src, ID3D11Texture2D *dst);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* MP_NVVFX_CORE_H */
diff --git a/video/filter/nvvfx_repack.hlsl b/video/filter/nvvfx_repack.hlsl
new file mode 100644
index 0000000..cf8c025
--- /dev/null
+++ b/video/filter/nvvfx_repack.hlsl
@@ -0,0 +1,81 @@
+// nvvfx_repack.hlsl - the R32 transport of nvvfx_core.c.
+//
+// CUDA's D3D11 interop cannot register DXGI_FORMAT_R10G10B10A2_* textures, so the
+// R32 transport moves each frame through a registrable 4-byte-per-pixel texture
+// holding the very same 32-bit word (R in bits 9:0, G 19:10, B 29:20, A 31:30 -
+// DXGI's R10G10B10A2 layout, which is also NvCVImage's NVCV_RGB10A2/NVCV_P32
+// layout). The word texture is R32_UINT, or R8G8B8A8_UINT as a second choice
+// (the same bytes in memory: little-endian, R8 is bits 7:0).
+//
+// Every pass is bit-exact for every 10-bit code value:
+//  - pack: a UNORM load returns k/1023 for code k; k/1023*1023 lands within ~1e-4
+//    of k, so +0.5 and truncation give k back exactly.
+//  - unpack: a typed UAV store converts float to UNORM as trunc(f*1023+0.5); f is
+//    k/1023 rounded to float, so the store lands on k again. (nvvfx-harness's
+//    "shader" test checks both directions on the real GPU.)
+// Alpha is forced to 3 (opaque) both ways.
+//
+// Compiled at development time by gen_nvvfx_shaders.ps1 into nvvfx_shaders.h;
+// nothing is compiled at run time.
+
+uint encode_word(float4 c)
+{
+    uint3 v = (uint3)(saturate(c.rgb) * 1023.0 + 0.5);
+    return v.r | (v.g << 10) | (v.b << 20) | (3u << 30);
+}
+
+float4 decode_word(uint p)
+{
+    uint3 v = uint3(p, p >> 10, p >> 20) & 1023u;
+    return float4((float3)v / 1023.0, 1.0);
+}
+
+Texture2D<float4>          rgb10_src  : register(t0);   // R10G10B10A2_UNORM SRV
+RWTexture2D<unorm float4>  rgb10_dst  : register(u0);   // R10G10B10A2_UNORM UAV
+
+RWTexture2D<uint>          r32_dst    : register(u0);   // R32_UINT UAV
+Texture2D<uint>            r32_src    : register(t0);   // R32_UINT SRV
+RWTexture2D<uint4>         rgba8_dst  : register(u0);   // R8G8B8A8_UINT UAV
+Texture2D<uint4>           rgba8_src  : register(t0);   // R8G8B8A8_UINT SRV
+
+[numthreads(16, 16, 1)]
+void pack_r32(uint3 id : SV_DispatchThreadID)
+{
+    uint w, h;
+    r32_dst.GetDimensions(w, h);
+    if (id.x >= w || id.y >= h)
+        return;
+    r32_dst[id.xy] = encode_word(rgb10_src.Load(int3(id.xy, 0)));
+}
+
+[numthreads(16, 16, 1)]
+void unpack_r32(uint3 id : SV_DispatchThreadID)
+{
+    uint w, h;
+    rgb10_dst.GetDimensions(w, h);
+    if (id.x >= w || id.y >= h)
+        return;
+    rgb10_dst[id.xy] = decode_word(r32_src.Load(int3(id.xy, 0)));
+}
+
+[numthreads(16, 16, 1)]
+void pack_rgba8(uint3 id : SV_DispatchThreadID)
+{
+    uint w, h;
+    rgba8_dst.GetDimensions(w, h);
+    if (id.x >= w || id.y >= h)
+        return;
+    uint p = encode_word(rgb10_src.Load(int3(id.xy, 0)));
+    rgba8_dst[id.xy] = uint4(p, p >> 8, p >> 16, p >> 24) & 255u;
+}
+
+[numthreads(16, 16, 1)]
+void unpack_rgba8(uint3 id : SV_DispatchThreadID)
+{
+    uint w, h;
+    rgb10_dst.GetDimensions(w, h);
+    if (id.x >= w || id.y >= h)
+        return;
+    uint4 b = rgba8_src.Load(int3(id.xy, 0));
+    rgb10_dst[id.xy] = decode_word(b.x | (b.y << 8) | (b.z << 16) | (b.w << 24));
+}
