+static int cuda_fail(nvvfx_runtime *rt, cudaError_t e, const char *what)
+{
+    const char *s = rt->cu.GetErrorString ? rt->cu.GetErrorString(e) : NULL;
+    return fail(&rt->lg, NVVFX_E_CUDA, "%s failed: cudaError %d%s%s", what, e,
+                s ? " - " : "", s ? s : "");
+}
