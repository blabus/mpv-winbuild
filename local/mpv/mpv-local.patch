+    case NVCV_ERR_LIBRARY:
+    case NVCV_ERR_FEATURENOTFOUND:
+    case NVCV_ERR_UNSUPPORTEDGPU:
+    case NVCV_ERR_UNSUPPORTEDDRIVER:
