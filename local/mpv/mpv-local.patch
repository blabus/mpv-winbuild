+struct nv_found {
+    wchar_t root[NV_PATH];
+    wchar_t core[NV_PATH];
+    wchar_t feature[NV_PATH];
+    wchar_t cudart[64];
+};
+
+static int find_cudart(const wchar_t *dir, wchar_t *name, size_t n)
+{
+    wchar_t pat[NV_PATH];
+    WIN32_FIND_DATAW fd;
+    HANDLE h;
+    path_join(pat, NV_PATH, dir, NV_CUDART_GLOB);
+    h = FindFirstFileW(pat, &fd);
+    if (h == INVALID_HANDLE_VALUE)
+        return 0;
+    name[0] = 0;
+    do {
+        if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)
+            continue;
+        if (!name[0] || wstr_ieq(fd.cFileName, NV_CUDART_PREFER))
+            wstr_copy(name, n, fd.cFileName);
+    } while (FindNextFileW(h, &fd));
+    FindClose(h);
+    return name[0] != 0;
+}
+
+/* Does `cand` hold a complete runtime? Fills `f`, or `why` with what is missing. */
+static int probe_root(const wchar_t *cand, struct nv_found *f, char *why, size_t why_n)
+{
+    static const wchar_t *const core_sub[] = {L"bin", L""};
+    wchar_t root[NV_PATH], dir[NV_PATH], file[NV_PATH], tmp[NV_PATH];
+    int i;
+
+    if (!full_path(root, NV_PATH, cand)) {
+        str_copy(why, why_n, "bad path");
+        return 0;
+    }
+    if (!dir_exists(root)) {
+        str_copy(why, why_n, "missing");
+        return 0;
+    }
+    f->core[0] = 0;
+    for (i = 0; i < 2 && !f->core[0]; i++) {
+        path_join(dir, NV_PATH, root, core_sub[i]);
+        path_join(file, NV_PATH, dir, NV_DLL_VFX);
+        if (file_exists(file))
+            wstr_copy(f->core, NV_PATH, dir);
+    }
+    if (!f->core[0]) {
+        str_copy(why, why_n, "no NVVideoEffects.dll");
+        return 0;
+    }
+    path_join(file, NV_PATH, f->core, NV_DLL_CVIMAGE);
+    if (!file_exists(file)) {
+        str_copy(why, why_n, "no NVCVImage.dll");
+        return 0;
+    }
+    if (!find_cudart(f->core, f->cudart, 64)) {
+        str_copy(why, why_n, "no cudart64_*.dll");
+        return 0;
+    }
+    /* The feature: <root>\features\..., <core>\..\features\... (when the
+     * candidate is the bin folder), or flat beside the core DLLs. */
+    f->feature[0] = 0;
+    for (i = 0; i < 3 && !f->feature[0]; i++) {
+        if (i == 0) {
+            path_join(dir, NV_PATH, root, NV_FEATURE_SUB);
+        } else if (i == 1) {
+            path_join(tmp, NV_PATH, f->core, L"..");
+            path_join(file, NV_PATH, tmp, NV_FEATURE_SUB);
+            if (!full_path(dir, NV_PATH, file))
+                continue;
+        } else {
+            wstr_copy(dir, NV_PATH, f->core);
+        }
+        path_join(file, NV_PATH, dir, NV_DLL_FEATURE);
+        if (file_exists(file))
+            wstr_copy(f->feature, NV_PATH, dir);
+    }
+    if (!f->feature[0]) {
+        str_copy(why, why_n, "no VideoSuperRes feature (nvVFXVideoSuperRes.dll)");
+        return 0;
+    }
+    wstr_copy(f->root, NV_PATH, root);
+    return 1;
+}
+
+static void file_version(const wchar_t *path, char *out, size_t n)
+{
+    /* VS_FIXEDFILEINFO, declared privately so this does not depend on winver.h */
+    struct ffi { DWORD sig, struc, ms, ls, pms, pls, mask, flags, os, type, sub, dms, dls; };
+    typedef DWORD (WINAPI *PFN_size)(LPCWSTR, LPDWORD);
+    typedef BOOL (WINAPI *PFN_info)(LPCWSTR, DWORD, DWORD, LPVOID);
+    typedef BOOL (WINAPI *PFN_query)(LPCVOID, LPCWSTR, LPVOID *, PUINT);
+    PFN_size get_size = NULL;
+    PFN_info get_info = NULL;
+    PFN_query query = NULL;
+    HMODULE v;
+    DWORD handle = 0, size;
+    void *buf, *val = NULL;
+    UINT len = 0;
+
+    out[0] = 0;
+    if (!file_exists(path))
+        return;
+    v = LoadLibraryExW(L"version.dll", NULL, LOAD_LIBRARY_SEARCH_SYSTEM32);
+    if (!v)
+        return;
+    if (resolve(v, "GetFileVersionInfoSizeW", &get_size) &&
+        resolve(v, "GetFileVersionInfoW", &get_info) &&
+        resolve(v, "VerQueryValueW", &query)) {
+        size = get_size(path, &handle);
+        buf = size ? malloc(size) : NULL;
+        if (buf && get_info(path, 0, size, buf) && query(buf, L"\\", &val, &len) &&
+            val && len >= sizeof(struct ffi)) {
+            const struct ffi *fi = val;
+            snprintf(out, n, "%u.%u.%u.%u", (unsigned)HIWORD(fi->ms), (unsigned)LOWORD(fi->ms),
+                     (unsigned)HIWORD(fi->ls), (unsigned)LOWORD(fi->ls));
+        }
+        free(buf);
+    }
+    FreeLibrary(v);
+}
+
+static void sdk_log_cb(void *data, const char *msg)
+{
+    nvvfx_runtime *rt = data;
+    char buf[512];
+    size_t l;
+    if (!rt || !msg)
+        return;
+    str_copy(buf, sizeof(buf), "sdk: ");
+    str_cat(buf, sizeof(buf), msg);
+    l = strlen(buf);
+    while (l && (buf[l - 1] == '\n' || buf[l - 1] == '\r'))
+        buf[--l] = 0;
+    log_line(&rt->lg, NVVFX_LOG_INFO, buf);
+}
+
+static int load_dll(nvvfx_runtime *rt, const wchar_t *dir, const wchar_t *name, HMODULE *out)
+{
+    wchar_t path[NV_PATH];
+    HMODULE m;
+    path_join(path, NV_PATH, dir, name);
+    /* DLL_LOAD_DIR resolves a DLL's own imports from its folder; DEFAULT_DIRS
+     * adds System32 (nvcuda.dll) and the AddDllDirectory folders. */
+    m = LoadLibraryExW(path, NULL, LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_DEFAULT_DIRS);
+    if (!m) {
+        DWORD e = GetLastError();
+        char p8[NV_PATH * 2], msg[256];
+        utf8(p8, sizeof(p8), path);
+        win32_message(e, msg, sizeof(msg));
+        fail(&rt->lg, NVVFX_E_RUNTIME, "runtime unusable: loading %s failed (Win32 error %lu: %s)",
+             p8, (unsigned long)e, msg);
+        return 0;
+    }
+    rt->mods[rt->nmods++] = m;
+    *out = m;
+    return 1;
+}
+
+static void runtime_free_modules(nvvfx_runtime *rt)
+{
+    int i;
+    for (i = rt->nmods - 1; i >= 0; i--)
+        FreeLibrary(rt->mods[i]);
+    rt->nmods = 0;
+    for (i = 0; i < rt->ndirs; i++)
+        RemoveDllDirectory(rt->dirs[i]);
+    rt->ndirs = 0;
+}
+
+static int runtime_open(nvvfx_runtime *rt, const struct nv_found *f)
+{
+    HMODULE cudart = NULL, cvimage = NULL, vfx = NULL, feature = NULL, ngx = NULL;
+    wchar_t file[NV_PATH];
+    const char *missing = NULL;
+    const char *missing_dll = NULL;
+    DLL_DIRECTORY_COOKIE c;
+
+    c = AddDllDirectory(f->core);
+    if (c)
+        rt->dirs[rt->ndirs++] = c;
+    if (!wstr_ieq(f->core, f->feature)) {
+        c = AddDllDirectory(f->feature);
+        if (c)
+            rt->dirs[rt->ndirs++] = c;
+    }
+
+    /* Preload order: the CUDA runtime, NVCVImage, the NGX loader,
+     * NVVideoEffects, then the feature, so every by-name load the SDK makes
+     * later finds an already-loaded module. Verified (1.3 runtime): this works
+     * from the flat folder with no PATH or SetDllDirectory change. */
+    if (!load_dll(rt, f->core, f->cudart, &cudart) ||
+        !load_dll(rt, f->core, NV_DLL_CVIMAGE, &cvimage))
+        return 0;
+    path_join(file, NV_PATH, f->core, NV_DLL_NGXRT);
+    if (file_exists(file)) {
+        if (!load_dll(rt, f->core, NV_DLL_NGXRT, &ngx))
+            return 0;
+    } else {
+        path_join(file, NV_PATH, f->feature, NV_DLL_NGXRT);
+        if (file_exists(file) && !load_dll(rt, f->feature, NV_DLL_NGXRT, &ngx))
+            return 0;
+    }
+    if (!load_dll(rt, f->core, NV_DLL_VFX, &vfx) ||
+        !load_dll(rt, f->feature, NV_DLL_FEATURE, &feature))
+        return 0;
+
+#define REQ(mod, dll, slot, name) \
+    if (!missing && !resolve(mod, name, &rt->slot)) { missing = name; missing_dll = dll; }
+#define OPT(mod, slot, name) resolve(mod, name, &rt->slot)
+
+    REQ(vfx, "NVVideoEffects.dll", vfx.CreateEffect, "NvVFX_CreateEffect")
+    REQ(vfx, "NVVideoEffects.dll", vfx.DestroyEffect, "NvVFX_DestroyEffect")
+    REQ(vfx, "NVVideoEffects.dll", vfx.SetU32, "NvVFX_SetU32")
+    REQ(vfx, "NVVideoEffects.dll", vfx.SetF32, "NvVFX_SetF32")
+    REQ(vfx, "NVVideoEffects.dll", vfx.SetImage, "NvVFX_SetImage")
+    REQ(vfx, "NVVideoEffects.dll", vfx.SetCudaStream, "NvVFX_SetCudaStream")
+    REQ(vfx, "NVVideoEffects.dll", vfx.Load, "NvVFX_Load")
+    REQ(vfx, "NVVideoEffects.dll", vfx.Run, "NvVFX_Run")
+    REQ(vfx, "NVVideoEffects.dll", vfx.CudaStreamCreate, "NvVFX_CudaStreamCreate")
+    REQ(vfx, "NVVideoEffects.dll", vfx.CudaStreamDestroy, "NvVFX_CudaStreamDestroy")
+    REQ(vfx, "NVVideoEffects.dll", vfx.CudaStreamSynchronize, "NvVFX_CudaStreamSynchronize")
+    OPT(vfx, vfx.GetVersion, "NvVFX_GetVersion");
+    OPT(vfx, vfx.GetU32, "NvVFX_GetU32");
+    OPT(vfx, vfx.GetString, "NvVFX_GetString");
+    OPT(vfx, vfx.ConfigureLogger, "NvVFX_ConfigureLogger");
+
+    REQ(cvimage, "NVCVImage.dll", cv.Init, "NvCVImage_Init")
+    REQ(cvimage, "NVCVImage.dll", cv.Alloc, "NvCVImage_Alloc")
+    REQ(cvimage, "NVCVImage.dll", cv.Dealloc, "NvCVImage_Dealloc")
+    REQ(cvimage, "NVCVImage.dll", cv.Transfer, "NvCVImage_Transfer")
+    REQ(cvimage, "NVCVImage.dll", cv.MapResource, "NvCVImage_MapResource")
+    REQ(cvimage, "NVCVImage.dll", cv.UnmapResource, "NvCVImage_UnmapResource")
+    OPT(cvimage, cv.FromD3DFormat, "NvCVImage_FromD3DFormat");
+    OPT(cvimage, cv.GetErrorStringFromCode, "NvCV_GetErrorStringFromCode");
+    /* NVCVImage.dll 1.3 exports NvCVImage_InitFromD3D11Texture (dumpbin, the
+     * nvidia-vfx 0.2.0.0 runtime). The NvCVImage guide documents the same call
+     * as NvCVImage_InitFromD3DTexture; that name is kept as a fallback. */
+    if (!missing) {
+        if (resolve(cvimage, "NvCVImage_InitFromD3D11Texture", &rt->cv.InitFromD3D11Texture)) {
+            str_copy(rt->info.wrap_export, sizeof(rt->info.wrap_export), "NvCVImage_InitFromD3D11Texture");
+        } else if (resolve(cvimage, "NvCVImage_InitFromD3DTexture", &rt->cv.InitFromD3D11Texture)) {
+            str_copy(rt->info.wrap_export, sizeof(rt->info.wrap_export), "NvCVImage_InitFromD3DTexture");
+        } else {
+            missing = "NvCVImage_InitFromD3D11Texture (or NvCVImage_InitFromD3DTexture)";
+            missing_dll = "NVCVImage.dll";
+        }
+    }
+
+    REQ(cudart, "cudart", cu.D3D11GetDevice, "cudaD3D11GetDevice")
+    REQ(cudart, "cudart", cu.SetDevice, "cudaSetDevice")
+    OPT(cudart, cu.GetDevice, "cudaGetDevice");
+    OPT(cudart, cu.DeviceSynchronize, "cudaDeviceSynchronize");
+    OPT(cudart, cu.EventCreate, "cudaEventCreate");
+    OPT(cudart, cu.EventDestroy, "cudaEventDestroy");
+    OPT(cudart, cu.EventRecord, "cudaEventRecord");
+    OPT(cudart, cu.EventSynchronize, "cudaEventSynchronize");
+    OPT(cudart, cu.EventElapsedTime, "cudaEventElapsedTime");
+    OPT(cudart, cu.GetErrorString, "cudaGetErrorString");
+    OPT(cudart, cu.RuntimeGetVersion, "cudaRuntimeGetVersion");
+    OPT(cudart, cu.DriverGetVersion, "cudaDriverGetVersion");
+    OPT(cudart, cu.MemGetInfo, "cudaMemGetInfo");
+#undef REQ
+#undef OPT
+
+    if (missing) {
+        char root8[NV_PATH * 2];
+        utf8(root8, sizeof(root8), f->root);
+        fail(&rt->lg, NVVFX_E_RUNTIME, "runtime at %s is incomplete: %s does not export %s",
+             root8, missing_dll, missing);
+        return 0;
+    }
+    (void)feature;
+    (void)ngx;
+    return 1;
+}
+
+static void runtime_describe(nvvfx_runtime *rt, const struct nv_found *f)
+{
+    nvvfx_runtime_info *in = &rt->info;
+    wchar_t file[NV_PATH];
+    const char *s = NULL;
+
+    utf8(in->root, sizeof(in->root), f->root);
+    utf8(in->core_dir, sizeof(in->core_dir), f->core);
+    utf8(in->feature_dir, sizeof(in->feature_dir), f->feature);
+    utf8(in->cudart_name, sizeof(in->cudart_name), f->cudart);
+
+    if (rt->vfx.GetVersion) {
+        unsigned v = 0;
+        /* (major << 24) | (minor << 16) | (build << 8) per the 1.0 header. */
+        if (rt->vfx.GetVersion(&v) == NVCV_SUCCESS) {
+            in->sdk_version = v;
+            snprintf(in->sdk_version_str, sizeof(in->sdk_version_str), "%u.%u.%u.%u",
+                     v >> 24, (v >> 16) & 255u, (v >> 8) & 255u, v & 255u);
+        }
+    }
+    path_join(file, NV_PATH, f->core, NV_DLL_VFX);
+    file_version(file, in->core_file_version, sizeof(in->core_file_version));
+    path_join(file, NV_PATH, f->feature, NV_DLL_FEATURE);
+    file_version(file, in->feature_file_version, sizeof(in->feature_file_version));
+    path_join(file, NV_PATH, f->feature, NV_DLL_NGX_VSR);
+    if (!file_exists(file))
+        path_join(file, NV_PATH, f->core, NV_DLL_NGX_VSR);
+    file_version(file, in->ngx_file_version, sizeof(in->ngx_file_version));
+    if (!in->ngx_file_version[0])
+        logm(&rt->lg, NVVFX_LOG_WARN, "nvngx_vsr.dll not found beside the feature; "
+             "VideoSuperRes will fail to load unless NGX finds it elsewhere");
+
+    if (rt->cu.RuntimeGetVersion)
+        rt->cu.RuntimeGetVersion(&in->cudart_version);
+    if (rt->cu.DriverGetVersion)
+        rt->cu.DriverGetVersion(&in->cuda_driver_version);
+
+    if (rt->vfx.GetString && rt->vfx.GetString(NULL, NVVFX_INFO, &s) == NVCV_SUCCESS && s) {
+        size_t l = strlen(s) + 1;
+        rt->effects = malloc(l);
+        if (rt->effects)
+            memcpy(rt->effects, s, l);
+    }
+    in->effects = rt->effects;
+
+    if (in->sdk_version && ((in->sdk_version >> 24) < 1 ||
+                            ((in->sdk_version >> 24) == 1 && ((in->sdk_version >> 16) & 255u) < 3)))
+        logm(&rt->lg, NVVFX_LOG_WARN, "SDK %s predates 1.3; VideoSuperRes on 10-bit frames "
+             "needs 1.3 or later", in->sdk_version_str);
+}
+
+nvvfx_runtime *nvvfx_runtime_load(const wchar_t *dir_or_null, nvvfx_log_fn log_fn, void *log_ctx)
+{
+    struct nv_log lg0 = {log_fn, log_ctx, NULL};
+    struct { wchar_t path[NV_PATH]; char label[64]; } cand[5];
+    char searched[2048] = "";
+    wchar_t env[NV_PATH];
+    struct nv_found f;
+    nvvfx_runtime *rt;
+    int nc = 0, hit = -1, i;
+
+    memset(&f, 0, sizeof(f));
+    if (dir_or_null && dir_or_null[0]) {
+        wstr_copy(cand[nc].path, NV_PATH, dir_or_null);
+        str_copy(cand[nc++].label, 64, "");
+    }
+    if (get_env(L"NV_VIDEO_EFFECTS_PATH", env, NV_PATH)) {
+        if (wstr_ieq(env, L"USE_APP_PATH")) {
+            /* NVIDIA's convention: the SDK sits beside the application. */
+            DWORD l = GetModuleFileNameW(NULL, cand[nc].path, NV_PATH);
+            if (l && l < NV_PATH) {
+                wchar_t *slash = wcsrchr(cand[nc].path, L'\\');
+                if (slash)
+                    *slash = 0;
+                str_copy(cand[nc++].label, 64, "NV_VIDEO_EFFECTS_PATH=USE_APP_PATH: ");
+            }
+        } else {
+            wstr_copy(cand[nc].path, NV_PATH, env);
+            str_copy(cand[nc++].label, 64, "NV_VIDEO_EFFECTS_PATH: ");
+        }
+    } else {
+        cand[nc].path[0] = 0;   /* listed in the message, not probed */
+        str_copy(cand[nc++].label, 64, "%NV_VIDEO_EFFECTS_PATH% (unset)");
+    }
+    if (get_env(L"LOCALAPPDATA", env, NV_PATH)) {
+        path_join(cand[nc].path, NV_PATH, env, L"htpc-player\\nvvfx");
+        str_copy(cand[nc++].label, 64, "");
+    }
+    if (get_env(L"ProgramFiles", env, NV_PATH)) {
+        path_join(cand[nc].path, NV_PATH, env, L"NVIDIA Corporation\\NVIDIA Video Effects");
+        str_copy(cand[nc++].label, 64, "");
+    }
+
+    for (i = 0; i < nc; i++) {
+        char why[96], p8[NV_PATH * 2];
+        if (!cand[i].path[0]) {
+            str_cat(searched, sizeof(searched), cand[i].label);
+            str_cat(searched, sizeof(searched), "; ");
+            continue;
+        }
+        if (probe_root(cand[i].path, &f, why, sizeof(why))) {
+            hit = i;
+            break;
+        }
+        utf8(p8, sizeof(p8), cand[i].path);
+        str_cat(searched, sizeof(searched), cand[i].label);
+        str_cat(searched, sizeof(searched), p8);
+        str_cat(searched, sizeof(searched), " (");
+        str_cat(searched, sizeof(searched), why);
+        str_cat(searched, sizeof(searched), "); ");
+    }
+    if (hit < 0) {
+        size_t l = strlen(searched);
+        if (l >= 2)
+            searched[l - 2] = 0;
+        logm(&lg0, NVVFX_LOG_ERROR, "runtime not found (searched: %s)", searched);
+        return NULL;
+    }
+
+    rt = calloc(1, sizeof(*rt));
+    if (!rt) {
+        logm(&lg0, NVVFX_LOG_ERROR, "out of memory");
+        return NULL;
+    }
+    rt->lg = lg0;
+    rt->lg.err = &rt->err;
+    if (!runtime_open(rt, &f)) {
+        runtime_free_modules(rt);
+        free(rt);
+        return NULL;
+    }
+    runtime_describe(rt, &f);
+    if (rt->vfx.ConfigureLogger &&
+        rt->vfx.ConfigureLogger(NVCV_LOG_WARNING, NULL, sdk_log_cb, rt) == NVCV_SUCCESS)
+        rt->logger_on = 1;
+
+    logm(&rt->lg, NVVFX_LOG_INFO, "NVIDIA Video Effects %s at %s (NVVideoEffects %s, "
+         "VideoSuperRes %s, nvngx_vsr %s, %s %d, CUDA driver %d)",
+         rt->info.sdk_version_str[0] ? rt->info.sdk_version_str : "(no version)",
+         rt->info.root,
+         rt->info.core_file_version[0] ? rt->info.core_file_version : "?",
+         rt->info.feature_file_version[0] ? rt->info.feature_file_version : "?",
+         rt->info.ngx_file_version[0] ? rt->info.ngx_file_version : "?",
+         rt->info.cudart_name, rt->info.cudart_version, rt->info.cuda_driver_version);
+    return rt;
+}
+
+void nvvfx_runtime_unload(nvvfx_runtime *rt)
+{
+    int i;
+    if (!rt)
+        return;
+    nvvfx_runtime_cool(rt);
+    if (InterlockedCompareExchange(&rt->pipelines, 0, 0)) {
+        logm(&rt->lg, NVVFX_LOG_ERROR, "nvvfx_runtime_unload with %ld pipeline(s) alive; "
+             "leaking the runtime instead", (long)InterlockedCompareExchange(&rt->pipelines, 0, 0));
+        return;
+    }
+    if (rt->logger_on)
+        rt->vfx.ConfigureLogger(0, NULL, NULL, NULL);
+    /* The modules stay loaded on purpose (see nvvfx_core.h). */
+    for (i = 0; i < rt->ndirs; i++)
+        RemoveDllDirectory(rt->dirs[i]);
+    free(rt->effects);
+    free(rt);
+}
