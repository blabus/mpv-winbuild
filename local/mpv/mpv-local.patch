+/*
+ * vf_nvvfx: NVIDIA Video Effects SDK "VideoSuperRes" (AI deblur at the source
+ * size, then optionally AI upscale) on D3D11 RGB frames, entirely on the GPU.
+ * All NVIDIA-facing work is in nvvfx_core.c; this file is the mp_filter glue.
+ *
+ * Intended chain:
+ *     d3d11vpp=format=x2bgr10:deint=no:scale=1:scaling-mode=standard:
+ *         nvidia-true-hdr=no,@nvvfx:nvvfx=deblur=medium:upscale=off
+ *
+ * Input:  IMGFMT_D3D11 with hw_subfmt x2bgr10 (DXGI_FORMAT_R10G10B10A2_UNORM)
+ *         on the VO's device. Anything else passes through untouched.
+ * Output: IMGFMT_D3D11[x2bgr10] from this filter's own FFmpeg frames pool on
+ *         the VO's device, possibly larger, with every attribute of the input.
+ *
+ * Two devices. The SDK, CUDA and every texture registered with CUDA live on a
+ * private D3D11 device the core creates on the VO's adapter (found by LUID),
+ * once per process, on a worker thread; the VO's device (which decodes,
+ * converts and presents) only ever records plain copies into and out of
+ * shared R10G10B10A2 textures and an event query, never a flush: the VO's own
+ * next submission carries them. (With CUDA's D3D11 interop on the VO's
+ * device, mpv reset the GPU driver within seconds.) Neither device ever waits
+ * on the GPU for the other: every handover is a CPU wait on a runner thread
+ * for an event query on the device that produced the data (see "cross-device
+ * transfer" in nvvfx_core.h).
+ *
+ * Asynchronous. Per frame: the playloop copies the frame into a free slot
+ * (nvvfx_peer_put) and queues it; this filter's runner thread waits for that
+ * copy, runs the pipeline on the private device, waits for it to finish and
+ * wakes the filter; the playloop then copies the result into a frame of its
+ * own pool (nvvfx_peer_get) and sends it on. Up to NVVFX_SLOTS frames are in
+ * flight, and every frame leaves in the order it came, passthrough frames
+ * included. A processed frame leaves when its copy in has reached the GPU
+ * with the VO's next submission, the pipeline has run, and the next filter
+ * asks for it: measured 20-30 ms at 60 Hz, up to ~100 ms at a 20 Hz present
+ * rate. The playloop never waits for the GPU: it only ever looks at whether
+ * the oldest frame is done.
+ *
+ * Rules this filter keeps:
+ *  - It never fails: creation always succeeds, and every problem (no runtime,
+ *    no device, an effect that will not load, an error or a timeout
+ *    mid-film, a lost device) is logged once and turns the filter into a
+ *    passthrough, frames still in flight leaving unprocessed and in order.
+ *  - Nothing slow runs on the playloop thread (it also feeds the audio
+ *    output): the runtime is loaded, the private device is made and pipelines
+ *    are created on a worker thread; frames run on the runner thread. Until a
+ *    pipeline is ready the filter keeps running the one it has (if the frame
+ *    fits it), else passes frames through. Destroying the filter never waits
+ *    for either thread: each finishes what it is doing on its own, gives back
+ *    what it holds and exits; mp_destroy() drains them (vf_nvvfx_drain).
+ *  - Pipelines are never destroyed. NVIDIA's 1.3 SDK does not give back the
+ *    GPU memory of an effect instance destroyed while any other exists, so
+ *    every pipeline goes into a process-wide cache when its filter is done
+ *    with it, and the next filter that needs the same kind borrows it (a
+ *    toggle off/on, or the next film of the same size, loads nothing). The
+ *    cache is keyed by the private device, not the VO's, so it survives the
+ *    VO's device being recreated. Levels and strengths are changed live.
+ *  - Every new model costs GPU memory for the rest of the process, so a new
+ *    pipeline, or a level a pipeline has never run, is only loaded while the
+ *    adapter has headroom left (NVVFX_MEM_RESERVE_MB*); otherwise the filter
+ *    keeps what it has and says why in its metadata.
+ *  - Locks: creations (and the runtime load and the private device) are
+ *    serialised process-wide by nv_create_lock, runs and live changes by
+ *    nv_run_lock (held around the submit only, never across a wait); a run
+ *    may overlap a creation (measured safe). No device lock is ever held
+ *    across a call into the core.
+ */
+
+#include <math.h>
+#include <stdarg.h>
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <windows.h>
+#include <d3d11.h>
+#include <d3d11_1.h>
+#include <dxgi1_4.h>
+
+#include <libavutil/buffer.h>
+#include <libavutil/frame.h>
+#include <libavutil/hwcontext.h>
+#include <libavutil/hwcontext_d3d11va.h>
+#include <libavutil/pixfmt.h>
+
+#include "common/common.h"
+#include "common/msg.h"
+#include "common/tags.h"
+#include "filters/filter.h"
+#include "filters/filter_internal.h"
+#include "filters/user_filters.h"
+#include "options/m_option.h"
+#include "osdep/threads.h"
+#include "osdep/timer.h"
+#include "osdep/windows_utils.h"
+#include "video/hwdec.h"
+#include "video/img_format.h"
+#include "video/mp_image.h"
+
+#include "nvvfx_core.h"
+
+// GPU memory that must be left on the adapter before another model is loaded
+// (a new pipeline, or a level a pipeline has not run before): the SDK keeps
+// every model it loads until the process exits, and running short of memory
+// shows up as paging stalls of seconds. The larger figure applies when the
+// output is larger than 3840x2160.
+#define NVVFX_MEM_RESERVE_MB     3072
+#define NVVFX_MEM_RESERVE_MB_8K  5120
+
+// Frames in flight (each a pair of shared textures in the pipeline's cache
+// entry: ~66 MB at 4K, ~166 MB at 4K -> 8K). The VO device is never flushed
+// from here (a flush on a device that presents blocks, with its lock held,
+// for up to several refreshes), so a copy into or out of a slot reaches the
+// GPU with the VO's own next submission. Measured in nvvfx-harness "vo" at
+// 24 fps: at a 20 Hz present rate (slower than a 23.976 Hz display) two slots
+// left half the results late, three left 4% late by up to 13 ms with
+// Deblur Ultra + HighBitrate Ultra 4K -> 8K, four left none; at 60 Hz three
+// left none.
+#define NVVFX_SLOTS 4
+// Frames held in order: the ones in flight plus passthrough frames behind them.
+#define NVVFX_QUEUE (NVVFX_SLOTS + 2)
+// The longest the runner waits for the VO device's copy into a slot (its
+// queue can be held up by what the VO does, a display mode change say), and
+// for the private device to finish a frame (5-35 ms normally).
+#define NVVFX_PEER_TIMEOUT_MS 5000
+#define NVVFX_RUN_TIMEOUT_MS 2000
+// A frame this long with the runner is given up on, from outside the runner
+// (which may be stuck inside the driver, where nothing can interrupt it).
+#define NVVFX_STALL_MS 10000
+// How often the worker looks for a stalled frame.
+#define NVVFX_WATCH_MS 250
+
+#define NVVFX_PTS_RING 64
+#define NVVFX_LAT_RING 64
+#define NVVFX_DEFAULT_STATS 240
+
+// A job the runner did not run (cancelled, or the filter gone). Not an error.
+#define JOB_SKIPPED 1
+
+static const char *const mem_full_detail =
+    "GPU memory is full of models loaded earlier; restart the app to free it";
+static const char *const lost_detail =
+    "the GPU was reset; the AI filter is off until the app restarts";
+
+// Declared here so nothing depends on which GUIDs the headers define.
+static const GUID nvvfx_iid_dxgi_device =
+    {0x54ec77fa, 0x1377, 0x44e6, {0x8c, 0x32, 0x88, 0xfd, 0x5f, 0x44, 0xc8, 0x4c}};
+static const GUID nvvfx_iid_dxgi_adapter3 =
+    {0x645967a4, 0x1392, 0x4310, {0xa7, 0x98, 0x80, 0x53, 0xce, 0x3e, 0x93, 0xfd}};
+
+// ===========================================================================
+// Process-wide state
+// ===========================================================================
+
+// Serialises pipeline creation, the runtime load and the private devices'
+// creation (worker threads only).
+static mp_static_mutex nv_create_lock = MP_STATIC_MUTEX_INITIALIZER;
+static nvvfx_runtime *nv_rt;            // loaded once, never unloaded
+
+// The private devices, one per adapter: created by workers (nv_create_lock
+// held), looked up by anyone (nv_dev_lock only, which is held briefly).
+// Never destroyed: the cached pipelines live on them.
+#define NVVFX_MAX_PDEV 4
+static mp_static_mutex nv_dev_lock = MP_STATIC_MUTEX_INITIALIZER;
+static nvvfx_device *nv_pdev[NVVFX_MAX_PDEV];
+static int nv_num_pdev;
+
+// Serialises runs and live changes (runner threads; only ever contended with
+// more than one player in the process). Never held across a wait.
+static mp_static_mutex nv_run_lock = MP_STATIC_MUTEX_INITIALIZER;
+
+// Set when a private device was removed (a GPU reset): CUDA does not survive
+// one, so nothing touches the SDK again in this process.
+static atomic_bool nv_lost;
+
+// Threads whose filter is gone but which are still finishing what they were
+// doing (a creation, or a frame). See vf_nvvfx_drain().
+static mp_static_mutex nv_orphan_lock = MP_STATIC_MUTEX_INITIALIZER;
+static mp_cond nv_orphan_cond = MP_STATIC_COND_INITIALIZER;
+static int nv_orphans;                  // protected by nv_orphan_lock
+
+// Every pipeline ever created. Entries are never freed or destroyed.
+struct cached {
+    struct cached *next;
+
+    // The key: what cannot change on a live pipeline.
+    nvvfx_device *pdev;                 // the private device it lives on
+    int in_w, in_h;
+    bool deblur;                        // a deblur stage was asked for
+    int up_family;                      // NVVFX_UPSCALE_*
+    int fit_w, fit_h;                   // the output size asked for
+
+    // --- protected by nv_cache_lock
+    bool in_use;                        // lent to a filter
+    bool dead;                          // failed: never lent again
+
+    // --- set at creation, then read-only
+    nvvfx_pipeline *pl;
+    nvvfx_xfer *xfer;                   // NVVFX_SLOTS slots of shared textures
+    bool deblur_live, up_live;          // what the SDK accepted
+    int out_w, out_h;
+
+    // --- owned by the borrower's runner thread (read by the borrower's
+    // playloop only when it borrows, before any frame of it runs)
+    int deblur_level, up_level;         // in force
+    float deblur_str, up_str;           // in force
+    unsigned deblur_used, up_used;      // bit n: level n has run (its model is loaded)
+};
+
+static mp_static_mutex nv_cache_lock = MP_STATIC_MUTEX_INITIALIZER;
+static struct cached *nv_cache;
+
+// ===========================================================================
+// Options
+// ===========================================================================
+
+static const struct m_opt_choice_alternatives deblur_names[] = {
+    {"off",    0},
+    {"low",    1},
+    {"medium", 2},
+    {"high",   3},
+    {"ultra",  4},
+    {0}
+};
+
+// 1..4 = HighBitrate (QualityLevel 16..19), 5..8 = VSR (QualityLevel 1..4)
+static const struct m_opt_choice_alternatives upscale_names[] = {
+    {"off",                0},
+    {"highbitrate-low",    1},
+    {"highbitrate-medium", 2},
+    {"highbitrate-high",   3},
+    {"highbitrate-ultra",  4},
+    {"vsr-low",            5},
+    {"vsr-medium",         6},
+    {"vsr-high",           7},
+    {"vsr-ultra",          8},
+    {0}
+};
+
+struct opts {
+    int deblur;
+    float deblur_strength;
+    int upscale;
+    float upscale_strength;
+    int w, h;
+    char *path;
+    int stats;
+};
+
+static int upscale_family(int upscale)
+{
+    if (upscale <= 0)
+        return NVVFX_UPSCALE_OFF;
+    return upscale <= 4 ? NVVFX_UPSCALE_HIGHBITRATE : NVVFX_UPSCALE_VSR;
+}
+
+static int upscale_level(int upscale)
+{
+    return upscale <= 4 ? upscale : upscale - 4;
+}
+
+// ===========================================================================
+// Filter state
+// ===========================================================================
+
+// What the options ask for at an input size: the pipeline's kind (everything
+// but the levels, which change live).
+struct shape {
+    int in_w, in_h;
+    int deblur;                 // 0 = off, 1..4
+    int up_family;              // NVVFX_UPSCALE_*
+    int up_level;               // 1..4 if up_family is not OFF
+    int box_w, box_h;           // the upscale's target box if up_family is not OFF
+    int fit_w, fit_h;           // the output size that asks for
+};
+
+struct build {
+    uint64_t id;
+    struct shape shape;
+    float deblur_strength, up_strength;
+};
+
+struct built {
+    struct build job;
+    struct cached *entry;       // the pipeline, lent to this filter; or NULL
+    bool created;               // false: it was found in the cache
+    double ms;
+    bool nomem;                 // refused by the memory guard
+    double free_mb, need_mb;
+    char error[512];            // !entry && !nomem: why the creation failed
+};
+
+enum rt_state {
+    RT_PENDING,
+    RT_OK,
+    RT_FAILED,
+};
+
+// What a frame asks of the pipeline's live parameters (the options as they
+// were when it was queued).
+struct live {
+    int deblur;
+    float deblur_strength;
+    int upscale;
+    float upscale_strength;
+};
+
+enum job_state {
+    JOB_QUEUED = 1,             // waiting for the runner
+    JOB_RUNNING,                // the runner has it
+    JOB_DONE,                   // finished (or skipped, or given up on)
+};
+
+// One frame, in order. Lives in the link's ring from the moment the playloop
+// takes the frame until it sends it on.
+struct job {
+    uint64_t id;
+    bool process;               // false: a passthrough frame waiting for its turn
+
+    // --- set by the playloop before the job is queued, then read-only
+    int slot;
+    struct cached *entry;
+    nvvfx_peer *peer;
+    struct live live;
+    int64_t t_queued;
+    char detail[256];           // !process: why the frame passes through
+
+    // --- protected by link.lock
+    int state;
+    bool cancelled;             // its result is not wanted (reset, give-up)
+
+    // --- results, set by the runner (under link.lock) when it is done
+    int status;                 // NVVFX_OK, JOB_SKIPPED, or an NVVFX_E_* error
+    char error[512];
+    bool peer_side;             // the error was the VO device's
+    bool deb_held_mem, up_held_mem;
+
+    // --- the playloop's only
+    struct mp_image *img;       // the input frame; NULL once dropped (reset)
+};
+
+// A cache entry (and the peer the filter opened on it) to give back once the
+// runner is no longer running a frame of it.
+struct release {
+    struct cached *entry;
+    nvvfx_peer *peer;
+    bool kill;
+};
+
+// What a filter and its two threads (the worker, which loads and creates,
+// and the runner, which runs frames) share. The filter never waits for
+// either thread, so any of the three may let go of this first; the last one
+// frees it.
+struct link {
+    atomic_int refs;
+
+    // Set before the threads start, then read-only. References are held.
+    LUID luid;                          // the VO device's adapter
+    IDXGIAdapter3 *adapter3;            // for the memory guard; may be NULL
+    char *path;                         // the path= option (malloc), or NULL
+
+    // The filter's log, NULL once the filter is gone.
+    mp_mutex log_lock;
+    struct mp_log *log;                 // protected by log_lock
+
+    mp_mutex lock;
+    mp_cond cond;                       // the worker's
+    mp_cond run_cond;                   // the runner's
+    // --- protected by lock
+    struct mp_filter *f;                // NULL once the filter is gone
+    // the worker's work
+    bool prepare;                       // load the runtime
+    bool job_pending;
+    struct build job;
+    uint64_t wanted;                    // the build the filter waits for (0: none)
+    bool result_ready;
+    struct built result;
+    enum rt_state rt_state;
+    char rt_error[512];
+    char rt_detail[160];
+    // the frames
+    struct job jobs[NVVFX_QUEUE];       // a ring: head .. head + count - 1
+    int head, count;
+    uint64_t next_job_id;
+    bool busy;                          // the runner is running a frame
+    int64_t busy_since;
+    bool stalled, stall_reported;       // the worker saw a frame run too long
+    struct release releases[4];         // deferred until the runner is idle
+    int num_releases;
+
+    // --- the runner's only: the live parameters of the pipeline it runs
+    struct cached *run_entry;
+    int deb_held, up_held;              // a wanted level not applied (0: none)...
+    bool deb_held_mem, up_held_mem;     // ...because of the memory guard (else the SDK)
+    float deb_str_held, up_str_held;    // a strength the SDK refused (-1: none)
+    bool warned_mem, warned_refused;
+};
+
+struct priv {
+    struct opts *opts;
+
+    AVBufferRef *av_device_ref;
+    ID3D11Device *dev;                  // the VO's
+    ID3D10Multithread *mt;
+    IDXGIAdapter3 *adapter3;            // for the memory guard; may be NULL
+
+    struct link *link;                  // always set
+    mp_thread worker, runner;
+    bool worker_ok, runner_ok;
+
+    // --- playloop thread only
+    bool broken;                        // passthrough for the rest of this instance
+    bool active;                        // the last frame sent on went through a pipeline
+    char detail[256];                   // why not, while !active
+    bool rt_seen_failed;
+    uint64_t next_id;
+    bool building;
+    struct build want;                  // the latest build requested
+
+    struct cached *cur;                 // the pipeline in hand (borrowed)
+    struct shape cur_shape;             // what it was borrowed for
+    nvvfx_peer *peer;                   // cur's shared textures opened on p->dev
+    bool slot_busy[NVVFX_SLOTS];
+    int inflight;                       // frames of cur queued or running
+
+    struct cached *ready;               // borrowed, waiting for the frames in flight to leave
+    struct shape ready_shape;
+    bool ready_created;
+    double ready_ms;
+    bool switch_wait;                   // a frame waits (unread) for that switch
+    bool want_release;                  // give cur back once nothing is in flight
+
+    bool mem_refused;                   // a build of refused_shape was refused...
+    struct shape refused_shape;         // ...by the memory guard
+    bool held_mem;                      // the last frame ran with a level held back for memory
+    struct shape last_want;             // what the latest frame taken asked for
+    bool have_last_want;
+    bool warned_mem;
+
+    AVBufferRef *out_pool;
+    int pool_w, pool_h;
+
+    int last_in_w, last_in_h, last_out_w, last_out_h;
+    bool warned_input, warned_box;
+
+    int frames_since_report;
+    double last_pts;
+    double nominal_fps;
+    double pts_delta[NVVFX_PTS_RING];
+    int num_delta, pos_delta;
+    bool warned_budget;
+    double latency[NVVFX_LAT_RING];     // ms from a frame's arrival to its result
+    int num_lat, pos_lat;
+};
+
+static void set_passthrough(struct priv *p, const char *detail)
+{
+    p->active = false;
+    snprintf(p->detail, sizeof(p->detail), "%s", detail ? detail : "");
+}
+
+static void set_active(struct priv *p)
+{
+    p->active = true;
+    p->detail[0] = '\0';
+}
+
+static struct link *link_new(void)
+{
+    struct link *l = calloc(1, sizeof(*l));
+    MP_HANDLE_OOM(l);
+    atomic_init(&l->refs, 1);
+    mp_mutex_init(&l->log_lock);
+    mp_mutex_init(&l->lock);
+    mp_cond_init(&l->cond);
+    mp_cond_init(&l->run_cond);
+    l->deb_str_held = l->up_str_held = -1.0f;
+    return l;
+}
+
+static void link_unref(struct link *l)
+{
+    if (!l || atomic_fetch_sub(&l->refs, 1) != 1)
+        return;
+    SAFE_RELEASE(l->adapter3);
+    free(l->path);
+    mp_cond_destroy(&l->run_cond);
+    mp_cond_destroy(&l->cond);
+    mp_mutex_destroy(&l->lock);
+    mp_mutex_destroy(&l->log_lock);
+    free(l);
+}
+
+static void orphan_done(void)
+{
+    mp_mutex_lock(&nv_orphan_lock);
+    nv_orphans--;
+    mp_cond_broadcast(&nv_orphan_cond);
+    mp_mutex_unlock(&nv_orphan_lock);
+}
+
+// ===========================================================================
+// Logging
+// ===========================================================================
+
+// The core's log lines go to the log of the filter whose thread is inside
+// the core (thread-local), and nowhere once that filter is gone. Lines from
+// SDK threads go to whoever entered the core last, if it is still inside
+// (it holds a reference on its link until it has left).
+static thread_local struct link *nv_tls_link;
+static thread_local char nv_tls_error[512];  // the last error line of this call
+static mp_static_mutex nv_log_lock = MP_STATIC_MUTEX_INITIALIZER;
+static struct link *nv_any_link;            // protected by nv_log_lock
+
+static void link_msg(struct link *l, int lev, const char *msg)
+{
+    mp_mutex_lock(&l->log_lock);
+    if (l->log)
+        mp_msg(l->log, lev, "%s\n", msg);
+    mp_mutex_unlock(&l->log_lock);
+}
+
+static void link_log(struct link *l, int lev, const char *fmt, ...)
+    MP_PRINTF_ATTRIBUTE(3, 4);
+
+static void link_log(struct link *l, int lev, const char *fmt, ...)
+{
+    char line[1024];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(line, sizeof(line), fmt, ap);
+    va_end(ap);
+    link_msg(l, lev, line);
+}
+
+static void core_log(void *ctx, int level, const char *msg)
+{
+    // Errors are reported by this file, once, with the core's text; the core's
+    // own error lines are kept for that and logged verbose only.
+    int lev = level == NVVFX_LOG_WARN  ? MSGL_WARN :
+              level == NVVFX_LOG_DEBUG ? MSGL_DEBUG : MSGL_V;
+    if (!msg)
+        return;
+    if (nv_tls_link) {
+        if (level == NVVFX_LOG_ERROR)
+            snprintf(nv_tls_error, sizeof(nv_tls_error), "%s", msg);
+        link_msg(nv_tls_link, lev, msg);
+        return;
+    }
+    mp_mutex_lock(&nv_log_lock);
+    if (nv_any_link)
+        link_msg(nv_any_link, lev, msg);
+    mp_mutex_unlock(&nv_log_lock);
+}
+
+static void nv_attach(struct link *l)
+{
+    nv_tls_link = l;
+    nv_tls_error[0] = '\0';
+    mp_mutex_lock(&nv_log_lock);
+    nv_any_link = l;
+    mp_mutex_unlock(&nv_log_lock);
+}
+
+static void nv_detach(void)
+{
+    mp_mutex_lock(&nv_log_lock);
+    if (nv_any_link == nv_tls_link)
+        nv_any_link = NULL;
+    mp_mutex_unlock(&nv_log_lock);
+    nv_tls_link = NULL;
+}
+
+// The text of the failure the last core call on this thread reported.
+static void core_error(char *buf, size_t size, int code)
+{
+    snprintf(buf, size, "%s", nv_tls_error[0] ? nv_tls_error : nvvfx_strerror(code));
+}
+
+// ===========================================================================
+// Private devices
+// ===========================================================================
+
+static bool luid_equal(LUID a, LUID b)
+{
+    return a.LowPart == b.LowPart && a.HighPart == b.HighPart;
+}
+
+// The private device on this adapter, or NULL if none has been made yet.
+static nvvfx_device *find_pdev(LUID luid)
+{
+    nvvfx_device *found = NULL;
+    mp_mutex_lock(&nv_dev_lock);
+    for (int n = 0; n < nv_num_pdev; n++) {
+        if (luid_equal(nvvfx_device_luid(nv_pdev[n]), luid)) {
+            found = nv_pdev[n];
+            break;
+        }
+    }
+    mp_mutex_unlock(&nv_dev_lock);
+    return found;
+}
+
+// Find or make the private device for the link's adapter. Worker only, with
+// nv_create_lock held (and the core attached for logging).
+static nvvfx_device *ensure_pdev(struct link *l, char *err, size_t err_size)
+{
+    nvvfx_device *d = find_pdev(l->luid);
+    if (d)
+        return d;
+    if (nv_num_pdev >= NVVFX_MAX_PDEV) {
+        snprintf(err, err_size, "too many adapters");
+        return NULL;
+    }
+    d = nvvfx_device_create(&l->luid, core_log, NULL);
+    if (!d) {
+        core_error(err, err_size, NVVFX_E_D3D);
+        return NULL;
+    }
+    mp_mutex_lock(&nv_dev_lock);
+    nv_pdev[nv_num_pdev++] = d;
+    mp_mutex_unlock(&nv_dev_lock);
+    link_log(l, MSGL_V, "Private D3D11 device made on %s.", nvvfx_device_name(d));
+    return d;
+}
+
+// ===========================================================================
+// The pipeline cache
+// ===========================================================================
+
+static bool entry_matches(const struct cached *e, nvvfx_device *pdev,
+                          const struct shape *s)
+{
+    return e->pdev == pdev && e->in_w == s->in_w && e->in_h == s->in_h &&
+           e->deblur == (s->deblur > 0) && e->up_family == s->up_family &&
+           e->fit_w == s->fit_w && e->fit_h == s->fit_h;
+}
+
+// Lend a free pipeline of this kind, or NULL.
+static struct cached *cache_borrow(nvvfx_device *pdev, const struct shape *s)
+{
+    struct cached *found = NULL;
+    if (!pdev)
+        return NULL;
+    mp_mutex_lock(&nv_cache_lock);
+    for (struct cached *e = nv_cache; e; e = e->next) {
+        if (!e->in_use && !e->dead && entry_matches(e, pdev, s)) {
+            e->in_use = true;
+            found = e;
+            break;
+        }
+    }
+    mp_mutex_unlock(&nv_cache_lock);
+    return found;
+}
+
+static void cache_return(struct cached *e)
+{
+    if (!e)
+        return;
+    mp_mutex_lock(&nv_cache_lock);
+    e->in_use = false;
+    mp_mutex_unlock(&nv_cache_lock);
+}
+
+// A pipeline that failed: keep it (destroying it would not give its memory
+// back either), but never lend it again.
+static void cache_kill(struct cached *e)
+{
+    if (!e)
+        return;
+    mp_mutex_lock(&nv_cache_lock);
+    e->dead = true;
+    e->in_use = false;
+    mp_mutex_unlock(&nv_cache_lock);
+}
+
+// Add a new pipeline, lent to the caller (or, without an xfer, dead).
+static struct cached *cache_add(nvvfx_device *pdev, const struct build *job,
+                                nvvfx_pipeline *pl, nvvfx_xfer *xfer)
+{
+    const nvvfx_pipeline_info *pi = nvvfx_pipeline_get_info(pl);
+    struct cached *e = calloc(1, sizeof(*e));
+    MP_HANDLE_OOM(e);
+    e->pdev = pdev;
+    e->in_w = job->shape.in_w;
+    e->in_h = job->shape.in_h;
+    e->deblur = job->shape.deblur > 0;
+    e->up_family = job->shape.up_family;
+    e->fit_w = job->shape.fit_w;
+    e->fit_h = job->shape.fit_h;
+    e->in_use = xfer != NULL;
+    e->dead = xfer == NULL;
+    e->pl = pl;
+    e->xfer = xfer;
+    e->deblur_live = pi->deblur_live;
+    e->up_live = pi->upscale_live;
+    e->out_w = pi->out_w;
+    e->out_h = pi->out_h;
+    e->deblur_level = e->deblur_live ? job->shape.deblur : 0;
+    e->up_level = e->up_live ? job->shape.up_level : 0;
+    e->deblur_str = job->deblur_strength;
+    e->up_str = job->up_strength;
+    if (e->deblur_live)
+        e->deblur_used = 1u << e->deblur_level;
+    if (e->up_live)
+        e->up_used = 1u << e->up_level;
+    mp_mutex_lock(&nv_cache_lock);
+    e->next = nv_cache;
+    nv_cache = e;
+    mp_mutex_unlock(&nv_cache_lock);
+    return e->dead ? NULL : e;
+}
+
+static void release_now(const struct release *r)
+{
+    nvvfx_peer_close(r->peer);
+    if (r->kill) {
+        cache_kill(r->entry);
+    } else {
+        cache_return(r->entry);
+    }
+}
+
+// Give back a pipeline and the peer opened on it, at once if the runner is
+// not running a frame (none of this filter's can be running a frame of
+// another pipeline), else as soon as it is done with that frame. Frames of
+// it still queued are cancelled. Playloop only.
+static void link_release(struct link *l, struct cached *e, nvvfx_peer *pr, bool kill)
+{
+    struct release r = {.entry = e, .peer = pr, .kill = kill};
+    bool now = true;
+    if (!e && !pr)
+        return;
+    mp_mutex_lock(&l->lock);
+    for (int n = 0; n < l->count; n++) {
+        struct job *j = &l->jobs[(l->head + n) % NVVFX_QUEUE];
+        if (j->process && j->state == JOB_QUEUED && j->entry == e) {
+            j->state = JOB_DONE;
+            j->cancelled = true;
+            j->status = JOB_SKIPPED;
+        }
+    }
+    if (l->busy && l->num_releases < (int)MP_ARRAY_SIZE(l->releases)) {
+        l->releases[l->num_releases++] = r;
+        now = false;
+    } else if (l->busy) {
+        // (Cannot happen: a filter holds one pipeline and one in reserve.)
+        // Leaking it is safe; giving it back under a running frame is not.
+        now = false;
+    }
+    mp_mutex_unlock(&l->lock);
+    if (now)
+        release_now(&r);
+}
+
+// ===========================================================================
+// GPU memory guard
+// ===========================================================================
+
+static bool gpu_memory(IDXGIAdapter3 *adapter3, double *usage_mb, double *budget_mb)
+{
+    DXGI_QUERY_VIDEO_MEMORY_INFO info;
+    if (!adapter3)
+        return false;
+    if (FAILED(IDXGIAdapter3_QueryVideoMemoryInfo(adapter3, 0,
+                                                  DXGI_MEMORY_SEGMENT_GROUP_LOCAL,
+                                                  &info)))
+        return false;
+    *usage_mb = info.CurrentUsage / 1048576.0;
+    *budget_mb = info.Budget / 1048576.0;
+    return true;
+}
+
+// May another model be loaded for a pipeline with this output size? True if
+// the adapter cannot say.
+static bool headroom_ok(IDXGIAdapter3 *adapter3, int out_w, int out_h,
+                        double *free_mb, double *need_mb)
+{
+    double usage, budget;
+    *need_mb = (int64_t)out_w * out_h > (int64_t)3840 * 2160 ?
+               NVVFX_MEM_RESERVE_MB_8K : NVVFX_MEM_RESERVE_MB;
+    *free_mb = -1;
+    if (!gpu_memory(adapter3, &usage, &budget))
+        return true;
+    *free_mb = budget - usage;
+    return *free_mb >= *need_mb;
+}
+
+#define MEM_WARNING "Not loading %s: %.0f MB of GPU memory left, %.0f MB wanted. "     "The NVIDIA SDK keeps every model it loaded until the app exits; restart it to free them."
+
+// ===========================================================================
+// Worker thread
+// ===========================================================================
+
+// Load the runtime if nobody has. Called on the worker with nv_create_lock held.
+static bool ensure_runtime(struct link *l, char *err, size_t err_size,
+                           char *detail, size_t detail_size)
+{
+    // (Process-wide: once loaded, a later instance's path= is not looked at.)
+    if (nv_rt)
+        return true;
+
+    wchar_t wpath[1024];
+    const wchar_t *dir = NULL;
+    if (l->path && l->path[0] &&
+        MultiByteToWideChar(CP_UTF8, 0, l->path, -1, wpath,
+                            MP_ARRAY_SIZE(wpath)) > 0)
+        dir = wpath;
+    int64_t t0 = mp_time_ns();
+    nv_rt = nvvfx_runtime_load(dir, core_log, NULL);
+    if (!nv_rt) {
+        core_error(err, err_size, NVVFX_E_RUNTIME);
+        if (strncmp(err, "runtime not found", 17) == 0) {
+            snprintf(detail, detail_size, "NVIDIA runtime not found");
+        } else {
+            snprintf(detail, detail_size, "%s", err);
+        }
+        return false;
+    }
+    const nvvfx_runtime_info *ri = nvvfx_runtime_get_info(nv_rt);
+    link_log(l, MSGL_V, "NVIDIA Video Effects %s loaded from %s in %.0f ms.",
+             ri->sdk_version_str[0] ? ri->sdk_version_str : "(no version)",
+             ri->root, MP_TIME_NS_TO_MS(mp_time_ns() - t0));
+    return true;
+}
+
+static void config_of(const struct build *b, nvvfx_config *cfg)
+{
+    nvvfx_config_defaults(cfg);
+    cfg->in_w = b->shape.in_w;
+    cfg->in_h = b->shape.in_h;
+    cfg->deblur_level = b->shape.deblur;
+    cfg->deblur_strength = b->deblur_strength;
+    cfg->upscale_family = b->shape.up_family;
+    if (b->shape.up_family != NVVFX_UPSCALE_OFF) {
+        cfg->upscale_level = b->shape.up_level;
+        cfg->target_w = b->shape.box_w;
+        cfg->target_h = b->shape.box_h;
+    }
+    cfg->upscale_strength = b->up_strength;
+    cfg->timing = NVVFX_TIMING_EVENTS;
+}
+
+// One build, with nv_create_lock held: from the cache if another filter has
+// returned one meanwhile, else a new pipeline (and its shared textures) on
+// the private device if the memory guard allows it.
+static void do_build(struct link *l, const struct build *job, struct built *res)
+{
+    if (atomic_load(&nv_lost)) {
+        snprintf(res->error, sizeof(res->error), "%s", lost_detail);
+        return;
+    }
+    nvvfx_device *pdev = ensure_pdev(l, res->error, sizeof(res->error));
+    if (!pdev)
+        return;
+
+    res->entry = cache_borrow(pdev, &job->shape);
+    if (res->entry)
+        return;
+
+    if (!headroom_ok(l->adapter3, job->shape.fit_w, job->shape.fit_h,
+                     &res->free_mb, &res->need_mb))
+    {
+        res->nomem = true;
+        return;
+    }
+
+    nvvfx_config cfg;
+    config_of(job, &cfg);
+    int64_t t0 = mp_time_ns();
+    nvvfx_pipeline *pl = nvvfx_pipeline_create(nv_rt, nvvfx_device_d3d11(pdev), &cfg);
+    if (!pl) {
+        res->ms = MP_TIME_NS_TO_MS(mp_time_ns() - t0);
+        core_error(res->error, sizeof(res->error), NVVFX_E_SDK);
+        return;
+    }
+    nvvfx_xfer *xfer = nvvfx_xfer_create(pl, NVVFX_SLOTS);
+    res->ms = MP_TIME_NS_TO_MS(mp_time_ns() - t0);
+    if (!xfer)
+        core_error(res->error, sizeof(res->error), NVVFX_E_D3D);
+    // Without its shared textures the pipeline is useless, but destroying it
+    // would not give its memory back: it goes into the cache dead.
+    res->entry = cache_add(pdev, job, pl, xfer);
+    res->created = res->entry != NULL;
+}
+
+// Does the filter still wait for this build?
+static bool link_wants(struct link *l, uint64_t id)
+{
+    mp_mutex_lock(&l->lock);
+    bool wants = l->f && l->wanted == id;
+    mp_mutex_unlock(&l->lock);
+    return wants;
+}
+
+// With l->lock held: tell the filter if the runner has been on one frame for
+// too long (it may be stuck inside the driver, where nothing can interrupt
+// it); the filter then stops waiting for it.
+static void watch_runner(struct link *l)
+{
+    if (l->f && l->busy && !l->stall_reported &&
+        mp_time_ns() - l->busy_since > MP_TIME_MS_TO_NS(NVVFX_STALL_MS))
+    {
+        l->stalled = true;
+        l->stall_reported = true;
+        mp_filter_wakeup(l->f);
+    }
+}
+
+// The worker owns its request: it never touches the filter's private state,
+// it outlives the filter if it must, and whatever it made that the filter no
+// longer waits for (superseded, cancelled, or the filter gone) it gives to the
+// cache itself. Between builds it watches the runner.
+static MP_THREAD_VOID worker_main(void *arg)
+{
+    struct link *l = arg;
+
+    mp_thread_set_name("nvvfx");
+
+    mp_mutex_lock(&l->lock);
+    while (l->f) {
+        watch_runner(l);
+        bool can_build = l->job_pending && !l->result_ready;
+        if (!l->prepare && !can_build) {
+            mp_cond_timedwait(&l->cond, &l->lock, MP_TIME_MS_TO_NS(NVVFX_WATCH_MS));
+            continue;
+        }
+        l->prepare = false;
+        struct build job = l->job;
+        if (can_build)
+            l->job_pending = false;
+        mp_mutex_unlock(&l->lock);
+
+        char err[512] = "", detail[160] = "";
+        struct built res = {.job = job};
+
+        mp_mutex_lock(&nv_create_lock);
+        nv_attach(l);
+        bool rt_ok = ensure_runtime(l, err, sizeof(err), detail, sizeof(detail));
+        // A build the filter stopped waiting for while this thread waited for
+        // its turn is not made: every model loaded stays loaded.
+        bool made = rt_ok && can_build && link_wants(l, job.id);
+        if (made)
+            do_build(l, &job, &res);
+        nv_detach();
+
+        mp_mutex_lock(&l->lock);
+        l->rt_state = rt_ok ? RT_OK : RT_FAILED;
+        if (!rt_ok) {
+            snprintf(l->rt_error, sizeof(l->rt_error), "%s", err);
+            snprintf(l->rt_detail, sizeof(l->rt_detail), "%s", detail);
+        }
+        bool deliver = made && l->f && l->wanted == job.id;
+        if (deliver) {
+            // (result_ready is false: can_build required it, and only this
+            // thread sets it.)
+            l->result = res;
+            l->result_ready = true;
+        }
+        // Under l->lock, so the filter cannot be destroyed under the call.
+        if (l->f)
+            mp_filter_wakeup(l->f);
+        mp_mutex_unlock(&l->lock);
+
+        // Not wanted any more: back to the cache while nv_create_lock is
+        // still held, so the next creation in line (another filter's, maybe
+        // the very one this was made for) finds it instead of making another.
+        if (made && !deliver)
+            cache_return(res.entry);
+        mp_mutex_unlock(&nv_create_lock);
+
+        mp_mutex_lock(&l->lock);
+    }
+    mp_mutex_unlock(&l->lock);
+
+    link_unref(l);
+    orphan_done();
+    MP_THREAD_RETURN();
+}
+
+// ===========================================================================
+// Runner thread
+// ===========================================================================
+
+// Bring the levels and strengths of the pipeline to what the frame asks for,
+// as far as allowed. Returns <0 on an error, else 1. Runner only, with
+// nv_run_lock held.
+static int apply_live(struct link *l, struct cached *e, const struct live *want)
+{
+    double free_mb, need_mb;
+
+    if (l->run_entry != e) {
+        l->run_entry = e;
+        l->deb_held = l->up_held = 0;
+        l->deb_held_mem = l->up_held_mem = false;
+        l->deb_str_held = l->up_str_held = -1.0f;
+    }
+
+    // Levels, for the stages the pipeline has and the options still want.
+    int dl = e->deblur_live && want->deblur > 0 ? want->deblur : 0;
+    int ul = e->up_live && upscale_family(want->upscale) == e->up_family ?
+             upscale_level(want->upscale) : 0;
+    if (!dl || dl == e->deblur_level) {
+        l->deb_held = 0;
+        dl = 0;
+    } else if (dl == l->deb_held) {
+        dl = 0;
+    } else if (!(e->deblur_used & (1u << dl)) &&
+               !headroom_ok(l->adapter3, e->out_w, e->out_h, &free_mb, &need_mb))
+    {
+        l->deb_held = dl;
+        l->deb_held_mem = true;
+        if (!l->warned_mem)
+            link_log(l, MSGL_WARN, MEM_WARNING, "another deblur level", free_mb, need_mb);
+        l->warned_mem = true;
+        dl = 0;
+    }
+    if (!ul || ul == e->up_level) {
+        l->up_held = 0;
+        ul = 0;
+    } else if (ul == l->up_held) {
+        ul = 0;
+    } else if (!(e->up_used & (1u << ul)) &&
+               !headroom_ok(l->adapter3, e->out_w, e->out_h, &free_mb, &need_mb))
+    {
+        l->up_held = ul;
+        l->up_held_mem = true;
+        if (!l->warned_mem)
+            link_log(l, MSGL_WARN, MEM_WARNING, "another upscale level", free_mb, need_mb);
+        l->warned_mem = true;
+        ul = 0;
+    }
+    if (dl || ul) {
+        int r = nvvfx_pipeline_set_levels(e->pl, dl ? dl : -1, ul ? ul : -1);
+        if (r < 0)
+            return r;
+        if (r == 0) {
+            // The SDK refused (logged by the core): keep the levels in force.
+            if (!l->warned_refused)
+                link_log(l, MSGL_WARN, "The level change was refused; keeping the current levels.");
+            l->warned_refused = true;
+            if (dl) {
+                l->deb_held = dl;
+                l->deb_held_mem = false;
+            }
+            if (ul) {
+                l->up_held = ul;
+                l->up_held_mem = false;
+            }
+        } else {
+            if (dl) {
+                e->deblur_level = dl;
+                e->deblur_used |= 1u << dl;
+            }
+            if (ul) {
+                e->up_level = ul;
+                e->up_used |= 1u << ul;
+            }
+            link_log(l, MSGL_V, "Levels changed live: deblur %s, upscale %s.",
+                     e->deblur_live ? m_opt_choice_str(deblur_names, e->deblur_level) : "off",
+                     e->up_live ? m_opt_choice_str(deblur_names, e->up_level) : "off");
+        }
+    }
+
+    // Strengths: free to change.
+    float ds = e->deblur_live && want->deblur > 0 ? want->deblur_strength : -1.0f;
+    float us = e->up_live && upscale_family(want->upscale) == e->up_family ?
+               want->upscale_strength : -1.0f;
+    if (ds == e->deblur_str || ds == l->deb_str_held)
+        ds = -1.0f;
+    if (us == e->up_str || us == l->up_str_held)
+        us = -1.0f;
+    if (ds >= 0 || us >= 0) {
+        int r = nvvfx_pipeline_set_strength(e->pl, ds, us);
+        if (r < 0)
+            return r;
+        if (r == 0) {
+            if (!l->warned_refused)
+                link_log(l, MSGL_WARN, "The strength change was refused; keeping the current strengths.");
+            l->warned_refused = true;
+            if (ds >= 0)
+                l->deb_str_held = ds;
+            if (us >= 0)
+                l->up_str_held = us;
+        } else {
+            if (ds >= 0)
+                e->deblur_str = ds;
+            if (us >= 0)
+                e->up_str = us;
+            link_log(l, MSGL_V, "Strengths changed live: deblur %.2f, upscale %.2f.",
+                     e->deblur_str, e->up_str);
+        }
+    }
+    return 1;
+}
+
+// One frame on the private device. Runner only, no lock held.
+static void run_job(struct link *l, const struct job *j, struct job *res)
+{
+    struct cached *e = j->entry;
+    nvvfx_xfer *x = e->xfer;
+    int r;
+
+    if (atomic_load(&nv_lost)) {
+        res->status = NVVFX_E_LOST;
+        snprintf(res->error, sizeof(res->error), "%s", lost_detail);
+        return;
+    }
+    nv_attach(l);
+    double t0 = nvvfx_now_ms();
+    // The VO device's copy into the slot (and every copy it made before,
+    // among them the last one out of this slot), waited for on this thread.
+    r = nvvfx_xfer_wait_peer(x, j->peer, j->slot, NVVFX_PEER_TIMEOUT_MS);
+    res->peer_side = r < 0;
+    double t1 = nvvfx_now_ms(), t2 = t1;
+    if (!r) {
+        mp_mutex_lock(&nv_run_lock);
+        r = apply_live(l, e, &j->live);
+        if (r >= 0)
+            r = nvvfx_xfer_submit(x, j->slot);
+        mp_mutex_unlock(&nv_run_lock);
+        t2 = nvvfx_now_ms();
+    }
+    if (!r)
+        r = nvvfx_xfer_wait_done(x, j->slot, NVVFX_RUN_TIMEOUT_MS);
+    if (!r)
+        nvvfx_xfer_note_times(x, t1 - t0, t2 - t1, nvvfx_now_ms() - t2);
+    if (r < 0) {
+        res->status = r;
+        core_error(res->error, sizeof(res->error), r);
+    } else {
+        res->status = NVVFX_OK;
+    }
+    res->deb_held_mem = l->deb_held && l->deb_held_mem;
+    res->up_held_mem = l->up_held && l->up_held_mem;
+    nv_detach();
+}
+
+static struct job *find_job(struct link *l, uint64_t id)
+{
+    for (int n = 0; n < l->count; n++) {
+        struct job *j = &l->jobs[(l->head + n) % NVVFX_QUEUE];
+        if (j->id == id)
+            return j;
+    }
+    return NULL;
+}
+
+// Runs the frames the playloop queues, oldest first, one at a time. Gives
+// back what the filter released while a frame was running once it is done,
+// and, after the filter is gone, everything the filter left with it.
+static MP_THREAD_VOID runner_main(void *arg)
+{
+    struct link *l = arg;
+
+    mp_thread_set_name("nvvfx-run");
+
+    mp_mutex_lock(&l->lock);
+    for (;;) {
+        struct release rel[MP_ARRAY_SIZE(l->releases)];
+        int num_rel = 0;
+        struct job *j = NULL;
+        for (int n = 0; n < l->count; n++) {
+            struct job *c = &l->jobs[(l->head + n) % NVVFX_QUEUE];
+            if (c->state == JOB_QUEUED) {
+                j = c;
+                break;
+            }
+        }
+        if (!j) {
+            if (!l->f)
+                break;
+            mp_cond_wait(&l->run_cond, &l->lock);
+            continue;
+        }
+        if (j->cancelled || !l->f) {
+            j->state = JOB_DONE;
+            j->status = JOB_SKIPPED;
+            if (l->f)
+                mp_filter_wakeup(l->f);
+            continue;
+        }
+        j->state = JOB_RUNNING;
+        l->busy = true;
+        l->busy_since = mp_time_ns();
+        l->stall_reported = false;
+        struct job work = *j;           // (the inputs; read-only while queued)
+        mp_mutex_unlock(&l->lock);
+
+        struct job res = {0};
+        run_job(l, &work, &res);
+
+        mp_mutex_lock(&l->lock);
+        l->busy = false;
+        // Still wanted? (The playloop may have given up on it, or dropped it.)
+        j = find_job(l, work.id);
+        if (j && j->state == JOB_RUNNING) {
+            j->state = JOB_DONE;
+            j->status = res.status;
+            snprintf(j->error, sizeof(j->error), "%s", res.error);
+            j->peer_side = res.peer_side;
+            j->deb_held_mem = res.deb_held_mem;
+            j->up_held_mem = res.up_held_mem;
+        }
+        num_rel = l->num_releases;
+        memcpy(rel, l->releases, num_rel * sizeof(rel[0]));
+        l->num_releases = 0;
+        if (l->f)
+            mp_filter_wakeup(l->f);
+        mp_mutex_unlock(&l->lock);
+
+        for (int n = 0; n < num_rel; n++)
+            release_now(&rel[n]);
+
+        mp_mutex_lock(&l->lock);
+    }
+    // The filter is gone and nothing is left to run.
+    struct release rel[MP_ARRAY_SIZE(l->releases)];
+    int num_rel = l->num_releases;
+    memcpy(rel, l->releases, num_rel * sizeof(rel[0]));
+    l->num_releases = 0;
+    mp_mutex_unlock(&l->lock);
+    for (int n = 0; n < num_rel; n++)
+        release_now(&rel[n]);
+
+    link_unref(l);
+    orphan_done();
+    MP_THREAD_RETURN();
+}
+
+void vf_nvvfx_drain(void)
+{
+    // At most one creation (~0.5 s; ~1 s cold) or one frame (normally
+    // milliseconds; at most NVVFX_PEER_TIMEOUT_MS + NVVFX_RUN_TIMEOUT_MS) per
+    // orphan. The cap is for a call into NVIDIA's DLLs or the driver that
+    // never returns.
+    int64_t until = mp_time_ns_add(mp_time_ns(), 8.0);
+    mp_mutex_lock(&nv_orphan_lock);
+    while (nv_orphans > 0) {
+        if (mp_cond_timedwait_until(&nv_orphan_cond, &nv_orphan_lock, until))
+            break;
+    }
+    mp_mutex_unlock(&nv_orphan_lock);
+}
+
+// ===========================================================================
+// Playloop side
+// ===========================================================================
+
+// The core's fit (must stay identical to fit_box in nvvfx_core.c), so the
+// filter knows the output size a pipeline would have before asking for one.
+static void fit_box(int iw, int ih, int bw, int bh, int *ow, int *oh)
+{
+    long long a = (long long)bw * ih, b = (long long)bh * iw;
+    int w, h;
+    if (a <= b) {
+        w = bw;
+        h = (int)((2LL * ih * bw + iw) / (2LL * iw));
+        if (h > bh)
+            h = bh;
+    } else {
+        h = bh;
+        w = (int)((2LL * iw * bh + ih) / (2LL * ih));
+        if (w > bw)
+            w = bw;
+    }
+    *ow = w & ~1;
+    *oh = h & ~1;
+}
+
+// What the options ask for at this input size. Returns false, with a reason,
+// if no stage would run.
+static bool want_shape(struct mp_filter *f, int w, int h, struct shape *s,
+                       const char **why)
+{
+    struct priv *p = f->priv;
+    *s = (struct shape){
+        .in_w = w, .in_h = h,
+        .deblur = p->opts->deblur,
+        .fit_w = w, .fit_h = h,
+    };
+    *why = "deblur and upscale are off";
+
+    if (p->opts->upscale > 0) {
+        if (p->opts->w <= 0 || p->opts->h <= 0) {
+            if (!p->warned_box) {
+                MP_WARN(f, "upscale=%s needs w and h; not upscaling.\n",
+                        m_opt_choice_str(upscale_names, p->opts->upscale));
+            }
+            p->warned_box = true;
+            *why = "upscale needs w and h";
+        } else {
+            int fw, fh;
+            fit_box(w, h, p->opts->w, p->opts->h, &fw, &fh);
+            if (fw > w && fh > h) {
+                s->up_family = upscale_family(p->opts->upscale);
+                s->up_level = upscale_level(p->opts->upscale);
+                s->box_w = p->opts->w;
+                s->box_h = p->opts->h;
+                s->fit_w = fw;
+                s->fit_h = fh;
+            } else {
+                *why = "the source already fills the upscale box";
+            }
+        }
+    }
+    return s->deblur > 0 || s->up_family != NVVFX_UPSCALE_OFF;
+}
+
+static bool same_shape(const struct shape *a, const struct shape *b)
+{
+    return a->in_w == b->in_w && a->in_h == b->in_h &&
+           (a->deblur > 0) == (b->deblur > 0) && a->up_family == b->up_family &&
+           a->fit_w == b->fit_w && a->fit_h == b->fit_h;
+}
+
+static void request_build(struct mp_filter *f, const struct shape *s)
+{
+    struct priv *p = f->priv;
+    p->want = (struct build){
+        .id = ++p->next_id,
+        .shape = *s,
+        .deblur_strength = p->opts->deblur_strength,
+        .up_strength = p->opts->upscale_strength,
+    };
+    p->building = true;
+    struct link *l = p->link;
+    mp_mutex_lock(&l->lock);
+    l->job = p->want;
+    l->job_pending = true;
+    l->wanted = p->want.id;
+    mp_cond_signal(&l->cond);
+    mp_mutex_unlock(&l->lock);
+}
+
+// Forget the build in flight: whatever it produces goes back to the cache.
+static void cancel_build(struct priv *p)
+{
+    if (!p->building)
+        return;
+    p->building = false;
+    p->want.id = 0;
+    struct link *l = p->link;
+    mp_mutex_lock(&l->lock);
+    l->job_pending = false;
+    l->wanted = 0;
+    mp_mutex_unlock(&l->lock);
+}
+
+// Give back the pipeline waiting to be switched to.
+static void drop_ready(struct priv *p)
+{
+    cache_return(p->ready);
+    p->ready = NULL;
+}
+
+// Give back the pipeline in hand (when no frame of it is in flight, at once).
+static void release_current(struct priv *p, bool kill)
+{
+    link_release(p->link, p->cur, p->peer, kill);
+    p->cur = NULL;
+    p->peer = NULL;
+    p->want_release = false;
+    for (int n = 0; n < NVVFX_SLOTS; n++)
+        p->slot_busy[n] = false;
+}
+
+// Turn into a passthrough for the rest of this instance, logging why once.
+// Frames still queued leave unprocessed; a frame running is given up on.
+static void give_up(struct mp_filter *f, bool kill, const char *detail,
+                    const char *fmt, ...) MP_PRINTF_ATTRIBUTE(4, 5);
+
+static void give_up(struct mp_filter *f, bool kill, const char *detail,
+                    const char *fmt, ...)
+{
+    struct priv *p = f->priv;
+    if (p->broken)
+        return;
+    char line[1024];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(line, sizeof(line), fmt, ap);
+    va_end(ap);
+    MP_ERR(f, "%s; passing frames through unprocessed.\n", line);
+    p->broken = true;
+    set_passthrough(p, detail);
+    cancel_build(p);
+    drop_ready(p);
+    p->switch_wait = false;
+    release_current(p, kill);
+}
+
+static const char *family_name(int family)
+{
+    switch (family) {
+    case NVVFX_UPSCALE_HIGHBITRATE: return "highbitrate";
+    case NVVFX_UPSCALE_VSR:         return "vsr";
+    default:                        return "off";
+    }
+}
+
+static const char *transport_format_name(int fmt)
+{
+    switch (fmt) {
+    case DXGI_FORMAT_R10G10B10A2_UNORM: return "R10G10B10A2_UNORM";
+    case DXGI_FORMAT_R32_UINT:          return "R32_UINT";
+    case DXGI_FORMAT_R8G8B8A8_UINT:     return "R8G8B8A8_UINT";
+    default:                            return "?";
+    }
+}
+
+// Start using the pipeline waiting in p->ready, giving back the one in hand.
+// Only with no frame in flight.
+static void take_ready(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+    struct cached *e = p->ready;
+    struct shape s = p->ready_shape;
+    bool created = p->ready_created;
+    double ms = p->ready_ms;
+    const nvvfx_pipeline_info *pi = nvvfx_pipeline_get_info(e->pl);
+    p->ready = NULL;
+
+    if (!e->deblur_live && !e->up_live) {
+        char detail[256];
+        snprintf(detail, sizeof(detail), "no VideoSuperRes stage could be set up%s%s",
+                 pi->fallback[0] ? ": " : "", pi->fallback);
+        cache_return(e);
+        give_up(f, false, detail, "%s", detail);
+        return;
+    }
+
+    release_current(p, false);
+
+    nv_attach(p->link);
+    nvvfx_peer *pr = nvvfx_peer_open(e->xfer, p->dev);
+    char err[512] = "";
+    if (!pr)
+        core_error(err, sizeof(err), NVVFX_E_D3D);
+    nv_detach();
+    if (!pr) {
+        cache_return(e);
+        give_up(f, false, err, "Opening the shared textures on the video device failed: %s", err);
+        return;
+    }
+
+    p->cur = e;
+    p->cur_shape = s;
+    p->peer = pr;
+    p->frames_since_report = 0;
+    p->warned_budget = false;
+    p->num_lat = p->pos_lat = 0;
+    nvvfx_pipeline_reset_stats(e->pl);
+    nvvfx_xfer_reset_stats(e->xfer);
+
+    char deb[48] = "off", up[64] = "off", how[48];
+    if (e->deblur_live) {
+        snprintf(deb, sizeof(deb), "%s", m_opt_choice_str(deblur_names, e->deblur_level));
+    } else if (s.deblur > 0) {
+        snprintf(deb, sizeof(deb), "refused");
+    }
+    if (e->up_live) {
+        snprintf(up, sizeof(up), "%s-%s", family_name(e->up_family),
+                 m_opt_choice_str(deblur_names, e->up_level));
+    } else if (s.up_family != NVVFX_UPSCALE_OFF) {
+        snprintf(up, sizeof(up), "refused");
+    }
+    if (created) {
+        snprintf(how, sizeof(how), "created in %.0f ms", ms);
+    } else {
+        snprintf(how, sizeof(how), "reused from the cache");
+    }
+    MP_INFO(f, "Pipeline live: %dx%d -> %dx%d, deblur %s, upscale %s, "
+            "transport %s (%s), on the private device, %s%s%s\n",
+            pi->in_w, pi->in_h, pi->out_w, pi->out_h, deb, up,
+            pi->transport == NVVFX_TRANSPORT_DIRECT ? "direct" : "r32",
+            transport_format_name(pi->transport_format), how,
+            pi->fallback[0] ? "; " : "", pi->fallback);
+}
+
+// Pick up what the worker has done.
+static void adopt(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+    if (!p->worker_ok)
+        return;
+
+    struct link *l = p->link;
+    struct built res = {0};
+    char rt_error[512] = "", rt_detail[160] = "";
+    mp_mutex_lock(&l->lock);
+    bool rt_failed = l->rt_state == RT_FAILED;
+    if (rt_failed) {
+        snprintf(rt_error, sizeof(rt_error), "%s", l->rt_error);
+        snprintf(rt_detail, sizeof(rt_detail), "%s", l->rt_detail);
+    }
+    bool have = l->result_ready;
+    if (have) {
+        res = l->result;
+        l->result.entry = NULL;
+        l->result_ready = false;
+        if (l->job_pending)
+            mp_cond_signal(&l->cond);
+    }
+    mp_mutex_unlock(&l->lock);
+
+    if (rt_failed && !p->rt_seen_failed) {
+        p->rt_seen_failed = true;
+        give_up(f, false, rt_detail[0] ? rt_detail : "NVIDIA runtime not found",
+                "NVIDIA Video Effects runtime unavailable: %s", rt_error);
+    }
+    if (!have)
+        return;
+
+    if (p->broken || !p->building || res.job.id != p->want.id) {
+        cache_return(res.entry);    // superseded or cancelled: keep it for later
+        return;
+    }
+    p->building = false;
+    if (res.nomem) {
+        p->mem_refused = true;
+        p->refused_shape = res.job.shape;
+        if (!p->warned_mem)
+            MP_WARN(f, "Not loading another pipeline: %.0f MB of GPU memory left, "
+                    "%.0f MB wanted. The NVIDIA SDK keeps every model it loaded "
+                    "until the app exits; restart it to free them.\n",
+                    res.free_mb, res.need_mb);
+        p->warned_mem = true;
+        return;
+    }
+    if (!res.entry) {
+        give_up(f, false, res.error, "Creating the VideoSuperRes pipeline failed: %s",
+                res.error);
+        return;
+    }
+    // Switched to with the next frame that fits it, once nothing is in flight.
+    drop_ready(p);
+    p->ready = res.entry;
+    p->ready_shape = res.job.shape;
+    p->ready_created = res.created;
+    p->ready_ms = res.ms;
+}
+
+// Look at the runner's state: a frame it has been on for too long.
+static void watch(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+    struct link *l = p->link;
+    mp_mutex_lock(&l->lock);
+    bool stalled = l->stalled;
+    l->stalled = false;
+    if (stalled && !p->broken) {
+        // The running frame leaves unprocessed; the runner's result for it,
+        // if it ever comes, is dropped (find_job sees it is not running).
+        for (int n = 0; n < l->count; n++) {
+            struct job *j = &l->jobs[(l->head + n) % NVVFX_QUEUE];
+            if (j->state == JOB_RUNNING) {
+                j->state = JOB_DONE;
+                j->cancelled = true;
+                j->status = NVVFX_E_TIMEOUT;
+            }
+        }
+    }
+    mp_mutex_unlock(&l->lock);
+    if (stalled && !p->broken) {
+        give_up(f, true, "the GPU did not finish a frame in time",
+                "The NVIDIA device has not finished a frame in %d s", NVVFX_STALL_MS / 1000);
+    }
+}
+
+// (Re)create the output frames pool for the pipeline in hand: its output
+// size, rounded up to even dimensions (the VO's d3d11va mapper's copy texture
+// is aligned to 2 and must fit), bound as the VO wants it. The result is
+// copied in, so nothing else is needed.
+static bool update_pool(struct priv *p, struct cached *e, char *err, size_t err_size)
+{
+    int w = MP_ALIGN_UP(e->out_w, 2), h = MP_ALIGN_UP(e->out_h, 2);
+    if (p->out_pool && p->pool_w == w && p->pool_h == h)
+        return true;
+    av_buffer_unref(&p->out_pool);
+    AVBufferRef *ref = av_hwframe_ctx_alloc(p->av_device_ref);
+    if (!ref) {
+        snprintf(err, err_size, "allocating the output frames context failed");
+        return false;
+    }
+    AVHWFramesContext *fctx = (void *)ref->data;
+    fctx->format = AV_PIX_FMT_D3D11;
+    fctx->sw_format = AV_PIX_FMT_X2BGR10;
+    fctx->width = w;
+    fctx->height = h;
+    AVD3D11VAFramesContext *hwfctx = fctx->hwctx;
+    hwfctx->BindFlags = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET;
+    hwfctx->MiscFlags = 0;
+    if (av_hwframe_ctx_init(ref) < 0) {
+        av_buffer_unref(&ref);
+        snprintf(err, err_size, "initialising a %dx%d output frames pool failed", w, h);
+        return false;
+    }
+    p->out_pool = ref;
+    p->pool_w = w;
+    p->pool_h = h;
+    return true;
+}
+
+static struct mp_image *alloc_out(struct priv *p, struct cached *e, char *err,
+                                  size_t err_size)
+{
+    if (!update_pool(p, e, err, err_size))
+        return NULL;
+    AVFrame *av_frame = av_frame_alloc();
+    MP_HANDLE_OOM(av_frame);
+    if (av_hwframe_get_buffer(p->out_pool, av_frame, 0) < 0) {
+        av_frame_free(&av_frame);
+        snprintf(err, err_size, "allocating an output frame failed");
+        return NULL;
+    }
+    struct mp_image *img = mp_image_from_av_frame(av_frame);
+    av_frame_free(&av_frame);
+    if (!img) {
+        snprintf(err, err_size, "wrapping an output frame failed");
+        return NULL;
+    }
+    return img;
+}
+
+static int scale_coord(int v, int to, int from)
+{
+    return (int)(((int64_t)v * to + from / 2) / from);
+}
+
+// The output carries everything the input does; only the size changes, and
+// with it the crop.
+static void set_out_attributes(struct mp_image *out, struct mp_image *in)
+{
+    mp_image_copy_attributes(out, in);
+    if ((out->w != in->w || out->h != in->h) && mp_image_crop_valid(&in->params)) {
+        struct mp_rect c = in->params.crop;
+        out->params.crop = (struct mp_rect){
+            .x0 = MPCLAMP(scale_coord(c.x0, out->w, in->w), 0, out->w),
+            .y0 = MPCLAMP(scale_coord(c.y0, out->h, in->h), 0, out->h),
+            .x1 = MPCLAMP(scale_coord(c.x1, out->w, in->w), 0, out->w),
+            .y1 = MPCLAMP(scale_coord(c.y1, out->h, in->h), 0, out->h),
+        };
+    }
+}
+
+// The texture and subresource a D3D11 frame lives in.
+static UINT frame_subresource(struct mp_image *img)
+{
+    D3D11_TEXTURE2D_DESC d;
+    ID3D11Texture2D_GetDesc((ID3D11Texture2D *)img->planes[0], &d);
+    return (UINT)(intptr_t)img->planes[1] * d.MipLevels;
+}
+
+// ---- statistics -----------------------------------------------------------
+
+static void note_pts(struct priv *p, struct mp_image *in)
+{
+    if (in->nominal_fps > 0)
+        p->nominal_fps = in->nominal_fps;
+    if (in->pts == MP_NOPTS_VALUE)
+        return;
+    if (p->last_pts != MP_NOPTS_VALUE) {
+        double d = in->pts - p->last_pts;
+        if (d > 0 && d < 1.0) {
+            p->pts_delta[p->pos_delta] = d;
+            p->pos_delta = (p->pos_delta + 1) % NVVFX_PTS_RING;
+            if (p->num_delta < NVVFX_PTS_RING)
+                p->num_delta++;
+        }
+    }
+    p->last_pts = in->pts;
+}
+
+static int cmp_double(const void *a, const void *b)
+{
+    double x = *(const double *)a, y = *(const double *)b;
+    return (x > y) - (x < y);
+}
+
+static double ring_median(const double *ring, int n)
+{
+    double v[NVVFX_PTS_RING > NVVFX_LAT_RING ? NVVFX_PTS_RING : NVVFX_LAT_RING];
+    if (n <= 0)
+        return 0;
+    memcpy(v, ring, n * sizeof(v[0]));
+    qsort(v, n, sizeof(v[0]), cmp_double);
+    return v[n / 2];
+}
+
+// The frame duration in ms from the frames' timestamps (the container's frame
+// rate if they say nothing yet), 0 if unknown.
+static double frame_ms(struct priv *p)
+{
+    if (p->num_delta >= 3)
+        return 1000.0 * ring_median(p->pts_delta, p->num_delta);
+    return p->nominal_fps > 0 ? 1000.0 / p->nominal_fps : 0;
+}
+
+static void report_stats(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+    nvvfx_stage_stats st[NVVFX_STAGE_COUNT], cycle, wait_peer;
+    for (int n = 0; n < NVVFX_STAGE_COUNT; n++)
+        nvvfx_pipeline_stats(p->cur->pl, n, &st[n]);
+    nvvfx_xfer_stats(p->cur->xfer, NVVFX_XFER_CYCLE, &cycle);
+    nvvfx_xfer_stats(p->cur->xfer, NVVFX_XFER_WAIT_PEER, &wait_peer);
+    double budget = frame_ms(p);
+    const nvvfx_stage_stats *total = &st[NVVFX_STAGE_TOTAL];
+
+    if (p->opts->stats > 0 && mp_msg_test(f->log, MSGL_V)) {
+        static const int order[] = {NVVFX_STAGE_IN, NVVFX_STAGE_DEBLUR,
+                                    NVVFX_STAGE_UPSCALE, NVVFX_STAGE_OUT,
+                                    NVVFX_STAGE_TOTAL};
+        char *line = talloc_strdup(NULL, "");
+        for (int n = 0; n < MP_ARRAY_SIZE(order); n++) {
+            const nvvfx_stage_stats *s = &st[order[n]];
+            if (!s->gpu_count)
+                continue;
+            line = talloc_asprintf_append(line, "%s%s %.2f/%.2f/%.2f",
+                                          line[0] ? ", " : "",
+                                          nvvfx_stage_name(order[n]),
+                                          s->gpu_median_ms, s->gpu_p99_ms,
+                                          s->gpu_max_ms);
+        }
+        MP_VERBOSE(f, "GPU ms median/p99/max over the last %d frames: %s; "
+                   "run (wall) median %.2f / p99 %.2f / max %.2f ms, of it waiting "
+                   "for the video device median %.2f / max %.2f ms; frame in to "
+                   "result out median %.2f ms; frame %.2f ms\n",
+                   total->gpu_count, line[0] ? line : "(no samples yet)",
+                   cycle.median_ms, cycle.p99_ms, cycle.max_ms,
+                   wait_peer.median_ms, wait_peer.max_ms,
+                   ring_median(p->latency, p->num_lat), budget);
+        talloc_free(line);
+    }
+
+    if (total->gpu_count > 0 && budget > 0) {
+        bool over = total->gpu_median_ms > budget;
+        if (over && !p->warned_budget) {
+            MP_WARN(f, "The pipeline takes %.2f ms of GPU time per frame (median), "
+                    "longer than a frame lasts (%.2f ms); video will drop frames.\n",
+                    total->gpu_median_ms, budget);
+        }
+        p->warned_budget = over;
+    }
+}
+
+// The memory guard's reason, if it is holding back what the options ask for.
+static const char *mem_notice(struct priv *p, const struct shape *want)
+{
+    if (p->mem_refused && want && same_shape(&p->refused_shape, want) &&
+        !(p->cur && same_shape(&p->cur_shape, want)))
+        return mem_full_detail;
+    if (p->cur && p->held_mem)
+        return mem_full_detail;
+    return NULL;
+}
+
+// ---- the frame queue ------------------------------------------------------
+
+static int queue_count(struct priv *p)
+{
+    struct link *l = p->link;
+    mp_mutex_lock(&l->lock);
+    int n = l->count;
+    mp_mutex_unlock(&l->lock);
+    return n;
+}
+
+// Append a job (with l->lock held). The ring has room: the playloop takes a
+// frame only when queue_count() < NVVFX_QUEUE.
+static struct job *queue_push(struct link *l)
+{
+    struct job *j = &l->jobs[(l->head + l->count) % NVVFX_QUEUE];
+    *j = (struct job){.id = ++l->next_job_id};
+    l->count++;
+    return j;
+}
+
+// A frame that passes through, behind any frame still in flight.
+static void queue_pass(struct mp_filter *f, struct mp_image *in, const char *detail)
+{
+    struct priv *p = f->priv;
+    struct link *l = p->link;
+    mp_mutex_lock(&l->lock);
+    struct job *j = queue_push(l);
+    j->process = false;
+    j->state = JOB_DONE;
+    j->status = JOB_SKIPPED;
+    j->img = in;
+    snprintf(j->detail, sizeof(j->detail), "%s", detail ? detail : "");
+    mp_mutex_unlock(&l->lock);
+}
+
+static int free_slot(struct priv *p)
+{
+    for (int n = 0; n < NVVFX_SLOTS; n++) {
+        if (!p->slot_busy[n])
+            return n;
+    }
+    return -1;
+}
+
+// Queue a frame for the runner, its copy into slot `slot` already recorded.
+static void queue_process(struct mp_filter *f, struct mp_image *in, int slot)
+{
+    struct priv *p = f->priv;
+    struct link *l = p->link;
+    mp_mutex_lock(&l->lock);
+    struct job *j = queue_push(l);
+    j->process = true;
+    j->slot = slot;
+    j->entry = p->cur;
+    j->peer = p->peer;
+    j->live = (struct live){
+        .deblur = p->opts->deblur,
+        .deblur_strength = p->opts->deblur_strength,
+        .upscale = p->opts->upscale,
+        .upscale_strength = p->opts->upscale_strength,
+    };
+    j->t_queued = mp_time_ns();
+    j->state = JOB_QUEUED;
+    j->img = in;
+    mp_cond_signal(&l->run_cond);
+    mp_mutex_unlock(&l->lock);
+    p->slot_busy[slot] = true;
+    p->inflight++;
+}
+
+// The bookkeeping of a frame taken in.
+static bool took(struct priv *p, struct mp_image *in)
+{
+    p->last_in_w = in->w;
+    p->last_in_h = in->h;
+    note_pts(p, in);
+    return true;
+}
+
+// Take a frame in. Returns false if it was put back (it waits for a switch of
+// pipelines, or for a slot, until the frames in flight have left).
+static bool take_frame(struct mp_filter *f, struct mp_image *in)
+{
+    struct priv *p = f->priv;
+
+    if (!p->broken && atomic_load(&nv_lost))
+        give_up(f, false, lost_detail, "An NVIDIA device was removed (GPU reset)");
+    if (p->broken) {
+        queue_pass(f, in, p->detail);
+        return took(p, in);
+    }
+
+    ID3D11Device *dev = NULL;
+    const char *bad = NULL;
+    if (in->imgfmt != IMGFMT_D3D11 || in->params.hw_subfmt != IMGFMT_X2BGR10 ||
+        !in->planes[0])
+    {
+        bad = "input is not d3d11[x2bgr10]";
+    } else {
+        ID3D11Texture2D_GetDevice((ID3D11Texture2D *)in->planes[0], &dev);
+        if (dev != p->dev) {
+            bad = "input is on another D3D11 device";
+        } else if (in->w < 16 || in->h < 16 || in->w > 16384 || in->h > 16384) {
+            bad = "input size out of range";
+        }
+        SAFE_RELEASE(dev);
+    }
+    if (bad) {
+        if (!p->warned_input) {
+            MP_WARN(f, "Input %s[%s] %dx%d: %s; passing it through.\n",
+                    mp_imgfmt_to_name(in->imgfmt),
+                    mp_imgfmt_to_name(in->params.hw_subfmt), in->w, in->h, bad);
+        }
+        p->warned_input = true;
+        queue_pass(f, in, bad);
+        return took(p, in);
+    }
+
+    struct shape want;
+    const char *why = NULL;
+    p->have_last_want = false;
+    if (!want_shape(f, in->w, in->h, &want, &why)) {
+        if (p->cur && !p->want_release)
+            MP_VERBOSE(f, "No stage left to run (%s).\n", why);
+        cancel_build(p);
+        drop_ready(p);
+        if (p->cur) {
+            if (p->inflight) {
+                p->want_release = true;
+            } else {
+                release_current(p, false);
+            }
+        }
+        queue_pass(f, in, why);
+        return took(p, in);
+    }
+
+    p->last_want = want;
+    p->have_last_want = true;
+
+    // The pipeline the options ask for: from the cache at once if there is a
+    // free one, else from the worker.
+    if (p->cur && same_shape(&p->cur_shape, &want)) {
+        cancel_build(p);    // asked for something else, then back to this
+        drop_ready(p);
+        p->want_release = false;
+    } else {
+        if (p->ready && !same_shape(&p->ready_shape, &want))
+            drop_ready(p);
+        if (!p->ready && !(p->building && same_shape(&p->want.shape, &want))) {
+            struct cached *hit = cache_borrow(find_pdev(p->link->luid), &want);
+            if (hit) {
+                cancel_build(p);
+                p->ready = hit;
+                p->ready_shape = want;
+                p->ready_created = false;
+                p->ready_ms = 0;
+            } else if (!(p->mem_refused && same_shape(&p->refused_shape, &want))) {
+                request_build(f, &want);
+            }
+        }
+        if (p->ready) {
+            if (p->inflight) {
+                // Every frame of the pipeline in hand leaves first.
+                p->switch_wait = true;
+                return false;
+            }
+            take_ready(f);
+            if (p->broken) {
+                queue_pass(f, in, p->detail);
+                return took(p, in);
+            }
+        }
+    }
+    p->switch_wait = false;
+
+    // Until it is ready, keep running the pipeline in hand if it takes this
+    // frame; otherwise pass the frame through.
+    struct cached *e = p->cur;
+    if (!e || e->in_w != in->w || e->in_h != in->h) {
+        const char *notice = mem_notice(p, &want);
+        queue_pass(f, in, notice ? notice : "loading");
+        return took(p, in);
+    }
+
+    int slot = free_slot(p);
+    if (slot < 0)
+        return false;       // (want_input() does not take a frame then)
+
+    char err[512] = "";
+    nv_attach(p->link);
+    int r = nvvfx_peer_put(p->peer, slot, (ID3D11Texture2D *)in->planes[0],
+                           frame_subresource(in));
+    if (r < 0)
+        core_error(err, sizeof(err), r);
+    nv_detach();
+    if (r < 0) {
+        give_up(f, false, err, "Copying a frame for the NVIDIA device failed: %s", err);
+        queue_pass(f, in, p->detail);
+        return took(p, in);
+    }
+    queue_process(f, in, slot);
+    return took(p, in);
+}
+
+// Does the filter take another frame now? Only when it has room, and either
+// the next filter wants a frame or a frame is already in flight (so the next
+// one's copy can overlap its run); never while a switch of pipelines waits
+// for the frames in flight to leave.
+static bool want_input(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+    if (p->switch_wait && p->inflight)
+        return false;
+    if (p->inflight >= NVVFX_SLOTS || queue_count(p) >= NVVFX_QUEUE)
+        return false;
+    return mp_pin_in_needs_data(f->ppins[1]) || p->inflight > 0;
+}
+
+// After a frame of the pipeline in hand has left.
+static void frame_left(struct priv *p, int slot)
+{
+    p->inflight--;
+    if (slot >= 0 && slot < NVVFX_SLOTS)
+        p->slot_busy[slot] = false;
+    if (!p->inflight && p->want_release && p->cur)
+        release_current(p, false);
+}
+
+// A frame failed on the private device: say why, once, and stop.
+static void job_failed(struct mp_filter *f, int status, bool peer_side, const char *error)
+{
+    if (peer_side && status == NVVFX_E_TIMEOUT) {
+        give_up(f, false, "the video device did not finish a copy in time",
+                "The video device did not finish a copy in time: %s", error);
+    } else if (status == NVVFX_E_LOST) {
+        atomic_store(&nv_lost, true);
+        give_up(f, true, lost_detail, "An NVIDIA device was removed: %s", error);
+    } else if (status == NVVFX_E_PEER_LOST) {
+        give_up(f, false, "the video device was lost", "The video device was lost: %s", error);
+    } else if (status == NVVFX_E_TIMEOUT) {
+        give_up(f, true, "the GPU did not finish a frame in time",
+                "VideoSuperRes did not finish a frame in time: %s", error);
+    } else {
+        give_up(f, true, error, "VideoSuperRes failed mid-stream: %s", error);
+    }
+}
+
+// Send the oldest frame on, if it is done. Returns false if there is none.
+// Call only when the output pin wants a frame.
+static bool emit_head(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+    struct link *l = p->link;
+
+    mp_mutex_lock(&l->lock);
+    struct job *head = l->count ? &l->jobs[l->head] : NULL;
+    if (!head || head->state != JOB_DONE) {
+        mp_mutex_unlock(&l->lock);
+        return false;
+    }
+    struct job j = *head;
+    *head = (struct job){0};
+    l->head = (l->head + 1) % NVVFX_QUEUE;
+    l->count--;
+    mp_mutex_unlock(&l->lock);
+
+    if (!j.process) {
+        if (j.img) {
+            set_passthrough(p, j.detail);
+            p->last_out_w = j.img->w;
+            p->last_out_h = j.img->h;
+            mp_pin_in_write(f->ppins[1], MAKE_FRAME(MP_FRAME_VIDEO, j.img));
+        }
+        return true;
+    }
+
+    // A frame of the pipeline in hand (p->cur, p->peer: no switch happens
+    // while one is in flight, and a give-up released them already). The slot
+    // is given back only after the copy out of it has been recorded.
+    if (!j.img) {
+        frame_left(p, j.slot);
+        return true;        // dropped by a reset
+    }
+    if (j.status < 0 && !p->broken)
+        job_failed(f, j.status, j.peer_side, j.error);
+    if (j.status != NVVFX_OK || p->broken || !p->cur) {
+        frame_left(p, j.slot);
+        set_passthrough(p, p->detail[0] ? p->detail : "passing through");
+        p->last_out_w = j.img->w;
+        p->last_out_h = j.img->h;
+        mp_pin_in_write(f->ppins[1], MAKE_FRAME(MP_FRAME_VIDEO, j.img));
+        return true;
+    }
+
+    struct cached *e = p->cur;
+    char err[512] = "";
+    struct mp_image *out = alloc_out(p, e, err, sizeof(err));
+    int r = NVVFX_E_ARG;
+    if (out) {
+        nv_attach(p->link);
+        r = nvvfx_peer_get(p->peer, j.slot, (ID3D11Texture2D *)out->planes[0],
+                           frame_subresource(out));
+        if (r < 0)
+            core_error(err, sizeof(err), r);
+        nv_detach();
+    }
+    if (r < 0) {
+        talloc_free(out);
+        give_up(f, false, err, "Copying a frame from the NVIDIA device failed: %s", err);
+        frame_left(p, j.slot);
+        p->last_out_w = j.img->w;
+        p->last_out_h = j.img->h;
+        mp_pin_in_write(f->ppins[1], MAKE_FRAME(MP_FRAME_VIDEO, j.img));
+        return true;
+    }
+    mp_image_set_size(out, e->out_w, e->out_h);
+    set_out_attributes(out, j.img);
+    talloc_free(j.img);
+
+    set_active(p);
+    p->held_mem = j.deb_held_mem || j.up_held_mem;
+    const char *notice = mem_notice(p, p->have_last_want ? &p->last_want : NULL);
+    if (notice)
+        snprintf(p->detail, sizeof(p->detail), "%s", notice);
+    p->last_out_w = out->w;
+    p->last_out_h = out->h;
+    p->latency[p->pos_lat] = MP_TIME_NS_TO_MS(mp_time_ns() - j.t_queued);
+    p->pos_lat = (p->pos_lat + 1) % NVVFX_LAT_RING;
+    if (p->num_lat < NVVFX_LAT_RING)
+        p->num_lat++;
+    int every = p->opts->stats > 0 ? p->opts->stats : NVVFX_DEFAULT_STATS;
+    if (++p->frames_since_report >= every) {
+        p->frames_since_report = 0;
+        report_stats(f);
+    }
+    frame_left(p, j.slot);
+    mp_pin_in_write(f->ppins[1], MAKE_FRAME(MP_FRAME_VIDEO, out));
+    return true;
+}
+
+static void vf_nvvfx_process(struct mp_filter *f)
+{
+    adopt(f);
+    watch(f);
+
+    // Finished frames go on, oldest first, as far as the next filter takes them.
+    while (mp_pin_in_needs_data(f->ppins[1]) && emit_head(f))
+        ;
+
+    if (!want_input(f))
+        return;
+
+    struct mp_frame frame = mp_pin_out_read(f->ppins[0]);
+    if (frame.type == MP_FRAME_NONE)
+        return;             // requested; process() runs again when it comes
+
+    if (frame.type != MP_FRAME_VIDEO) {
+        // EOF (or anything else) goes after every frame before it.
+        if (queue_count(f->priv) || !mp_pin_in_needs_data(f->ppins[1])) {
+            mp_pin_out_unread(f->ppins[0], frame);
+            return;
+        }
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    if (!take_frame(f, frame.data)) {
+        // It waits for the frames in flight; the runner's wake-up brings
+        // process() back.
+        mp_pin_out_unread(f->ppins[0], frame);
+        return;
+    }
+    // Send it on at once if it passes through, or take another.
+    mp_filter_internal_mark_progress(f);
+}
+
+// ---- commands and metadata ------------------------------------------------
+
+static bool parse_choice(const struct m_opt_choice_alternatives *alt,
+                         const char *s, int *out)
+{
+    for (; alt->name; alt++) {
+        if (strcmp(alt->name, s) == 0) {
+            *out = alt->value;
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool parse_unit(const char *s, float *out)
+{
+    char *end = NULL;
+    double v = strtod(s, &end);
+    if (end == s || *end || !isfinite(v) || v < 0 || v > 1)
+        return false;
+    *out = (float)v;
+    return true;
+}
+
+// A change is only recorded here; the next frame applies it (live if it can,
+// else through a pipeline of the new kind), so a command always succeeds once
+// its value parses.
+static bool text_command(struct mp_filter *f, const char *cmd, const char *arg)
+{
+    struct priv *p = f->priv;
+    int v;
+    float x;
+
+    if (!cmd || !arg)
+        return false;
+    if (strcmp(cmd, "deblur") == 0) {
+        if (!parse_choice(deblur_names, arg, &v))
+            return false;
+        p->opts->deblur = v;
+    } else if (strcmp(cmd, "upscale") == 0) {
+        if (!parse_choice(upscale_names, arg, &v))
+            return false;
+        p->opts->upscale = v;
+    } else if (strcmp(cmd, "deblur-strength") == 0) {
+        if (!parse_unit(arg, &x))
+            return false;
+        p->opts->deblur_strength = x;
+    } else if (strcmp(cmd, "upscale-strength") == 0) {
+        if (!parse_unit(arg, &x))
+            return false;
+        p->opts->upscale_strength = x;
+    } else {
+        return false;
+    }
+    MP_VERBOSE(f, "%s=%s\n", cmd, arg);
+    return true;
+}
+
+static void tag_int(struct mp_tags *t, const char *key, int v)
+{
+    char buf[32];
+    snprintf(buf, sizeof(buf), "%d", v);
+    mp_tags_set_str(t, key, buf);
+}
+
+static void tag_ms(struct mp_tags *t, const char *key, double v)
+{
+    char buf[32];
+    snprintf(buf, sizeof(buf), "%.2f", v);
+    mp_tags_set_str(t, key, buf);
+}
+
+static struct mp_tags *get_metadata(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+    struct mp_tags *t = talloc_zero(NULL, struct mp_tags);
+
+    mp_tags_set_str(t, "status", p->active ? "active" : "passthrough");
+    if (p->detail[0])
+        mp_tags_set_str(t, "detail", p->detail);
+
+    if (p->active && p->cur) {
+        struct cached *e = p->cur;
+        nvvfx_stage_stats s_in, s_deb, s_up, s_out, s_total;
+        nvvfx_pipeline_stats(e->pl, NVVFX_STAGE_IN, &s_in);
+        nvvfx_pipeline_stats(e->pl, NVVFX_STAGE_DEBLUR, &s_deb);
+        nvvfx_pipeline_stats(e->pl, NVVFX_STAGE_UPSCALE, &s_up);
+        nvvfx_pipeline_stats(e->pl, NVVFX_STAGE_OUT, &s_out);
+        nvvfx_pipeline_stats(e->pl, NVVFX_STAGE_TOTAL, &s_total);
+        if (e->deblur_live && s_deb.gpu_count)
+            tag_ms(t, "deblur_ms", s_deb.gpu_median_ms);
+        if (e->up_live && s_up.gpu_count)
+            tag_ms(t, "upscale_ms", s_up.gpu_median_ms);
+        if (s_in.gpu_count && s_out.gpu_count)
+            tag_ms(t, "transfer_ms", s_in.gpu_median_ms + s_out.gpu_median_ms);
+        if (s_total.gpu_count)
+            tag_ms(t, "total_ms", s_total.gpu_median_ms);
+        if (p->num_lat)
+            tag_ms(t, "latency_ms", ring_median(p->latency, p->num_lat));
+    }
+
+    tag_int(t, "in_w", p->last_in_w);
+    tag_int(t, "in_h", p->last_in_h);
+    tag_int(t, "out_w", p->last_out_w);
+    tag_int(t, "out_h", p->last_out_h);
+
+    double usage, budget;
+    if (gpu_memory(p->adapter3, &usage, &budget)) {
+        tag_int(t, "gpu_mem_mb", (int)lrint(usage));
+        tag_int(t, "gpu_budget_mb", (int)lrint(budget));
+    }
+    return t;
+}
+
+static bool vf_nvvfx_command(struct mp_filter *f, struct mp_filter_command *cmd)
+{
+    struct priv *p = f->priv;
+
+    switch (cmd->type) {
+    case MP_FILTER_COMMAND_TEXT:
+        return text_command(f, cmd->cmd, cmd->arg);
+    case MP_FILTER_COMMAND_GET_META:
+        *(struct mp_tags **)cmd->res = get_metadata(f);
+        return true;
+    case MP_FILTER_COMMAND_IS_ACTIVE:
+        cmd->is_active = p->active;
+        return true;
+    default:
+        return false;
+    }
+}
+
+// ---- lifecycle ------------------------------------------------------------
+
+static void vf_nvvfx_reset(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+    struct link *l = p->link;
+    struct mp_image *drop[NVVFX_QUEUE];
+    int num_drop = 0;
+
+    // Seeks keep the pipeline. Frames held are dropped: the ones still queued
+    // are not run, a running one finishes and is thrown away, and each leaves
+    // the queue (giving back its slot) as the next ones would.
+    mp_mutex_lock(&l->lock);
+    for (int n = 0; n < l->count; n++) {
+        struct job *j = &l->jobs[(l->head + n) % NVVFX_QUEUE];
+        if (j->img)
+            drop[num_drop++] = j->img;
+        j->img = NULL;
+        if (j->state == JOB_QUEUED) {
+            j->state = JOB_DONE;
+            j->status = JOB_SKIPPED;
+        }
+        j->cancelled = true;
+    }
+    mp_mutex_unlock(&l->lock);
+    for (int n = 0; n < num_drop; n++)
+        talloc_free(drop[n]);
+    p->switch_wait = false;
+    p->last_pts = MP_NOPTS_VALUE;
+}
+
+static void vf_nvvfx_destroy(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+    struct link *l = p->link;
+    struct mp_image *drop[NVVFX_QUEUE];
+    int num_drop = 0;
+
+    drop_ready(p);
+
+    // Neither thread is waited for: this runs on the playloop, the worker may
+    // be inside a creation for another half second and the runner inside a
+    // frame. Each finishes on its own, gives back what it holds and exits;
+    // from here on they log nowhere and wake nobody.
+    if (l) {
+        mp_mutex_lock(&l->log_lock);
+        l->log = NULL;
+        mp_mutex_unlock(&l->log_lock);
+        mp_mutex_lock(&nv_orphan_lock);
+        nv_orphans += (p->worker_ok ? 1 : 0) + (p->runner_ok ? 1 : 0);
+        mp_mutex_unlock(&nv_orphan_lock);
+
+        mp_mutex_lock(&l->lock);
+        l->f = NULL;
+        l->job_pending = false;
+        l->wanted = 0;
+        struct cached *built = l->result_ready ? l->result.entry : NULL;
+        l->result.entry = NULL;
+        l->result_ready = false;
+        for (int n = 0; n < l->count; n++) {
+            struct job *j = &l->jobs[(l->head + n) % NVVFX_QUEUE];
+            if (j->img)
+                drop[num_drop++] = j->img;
+            j->img = NULL;
+            if (j->state == JOB_QUEUED) {
+                j->state = JOB_DONE;
+                j->status = JOB_SKIPPED;
+            }
+            j->cancelled = true;
+        }
+        // The pipeline in hand goes back once no frame of it runs: now, or
+        // when the runner is done with the one it is running.
+        struct release r = {.entry = p->cur, .peer = p->peer};
+        bool later = (p->cur || p->peer) && l->busy && p->runner_ok &&
+                     l->num_releases < (int)MP_ARRAY_SIZE(l->releases);
+        if (later)
+            l->releases[l->num_releases++] = r;
+        bool leak = (p->cur || p->peer) && l->busy && !later;
+        mp_cond_signal(&l->cond);
+        mp_cond_signal(&l->run_cond);
+        mp_mutex_unlock(&l->lock);
+
+        cache_return(built);
+        if (!later && !leak)
+            release_now(&r);
+        p->cur = NULL;
+        p->peer = NULL;
+        if (p->worker_ok)
+            mp_thread_detach(p->worker);
+        if (p->runner_ok)
+            mp_thread_detach(p->runner);
+        p->worker_ok = p->runner_ok = false;
+        link_unref(l);
+        p->link = NULL;
+    }
+    for (int n = 0; n < num_drop; n++)
+        talloc_free(drop[n]);
+
+    // Frames already downstream hold their own reference to the pool.
+    av_buffer_unref(&p->out_pool);
+    SAFE_RELEASE(p->adapter3);
+    SAFE_RELEASE(p->mt);
+    SAFE_RELEASE(p->dev);
+    av_buffer_unref(&p->av_device_ref);
+}
+
+static const struct mp_filter_info vf_nvvfx_filter = {
+    .name = "nvvfx",
+    .priv_size = sizeof(struct priv),
+    .process = vf_nvvfx_process,
+    .reset = vf_nvvfx_reset,
+    .destroy = vf_nvvfx_destroy,
+    .command = vf_nvvfx_command,
+};
+
+static IDXGIAdapter3 *adapter3_of(ID3D11Device *dev)
+{
+    IDXGIDevice *dxgi_dev = NULL;
+    IDXGIAdapter *adapter = NULL;
+    IDXGIAdapter3 *adapter3 = NULL;
+    if (FAILED(ID3D11Device_QueryInterface(dev, &nvvfx_iid_dxgi_device,
+                                           (void **)&dxgi_dev)))
+        return NULL;
+    if (SUCCEEDED(IDXGIDevice_GetAdapter(dxgi_dev, &adapter))) {
+        if (FAILED(IDXGIAdapter_QueryInterface(adapter, &nvvfx_iid_dxgi_adapter3,
+                                               (void **)&adapter3)))
+            adapter3 = NULL;
+        IDXGIAdapter_Release(adapter);
+    }
+    IDXGIDevice_Release(dxgi_dev);
+    return adapter3;
+}
+
+static struct mp_filter *vf_nvvfx_create(struct mp_filter *parent, void *options)
+{
+    struct mp_filter *f = mp_filter_create(parent, &vf_nvvfx_filter);
+    if (!f) {
+        talloc_free(options);
+        return NULL;
+    }
+
+    mp_filter_add_pin(f, MP_PIN_IN, "in");
+    mp_filter_add_pin(f, MP_PIN_OUT, "out");
+
+    struct priv *p = f->priv;
+    p->opts = talloc_steal(p, options);
+    p->link = link_new();
+    p->link->f = f;
+    p->link->log = f->log;
+    p->last_pts = MP_NOPTS_VALUE;
+    set_passthrough(p, "loading");
+
+    // From here on nothing fails the creation: a failed filter would take
+    // the whole --vf list, and with it the video track, down. Problems turn
+    // the filter into a passthrough instead.
+    struct mp_hwdec_ctx *hwctx =
+        mp_filter_load_hwdec_device(f, IMGFMT_D3D11, AV_HWDEVICE_TYPE_D3D11VA);
+    if (!hwctx || !hwctx->av_device_ref) {
+        give_up(f, false, "no D3D11 device",
+                "No D3D11 device (needs hwdec=d3d11va and a D3D11 VO)");
+        return f;
+    }
+    p->av_device_ref = av_buffer_ref(hwctx->av_device_ref);
+    MP_HANDLE_OOM(p->av_device_ref);
+    AVHWDeviceContext *avhwctx = (void *)p->av_device_ref->data;
+    AVD3D11VADeviceContext *d3dctx = avhwctx->hwctx;
+    p->dev = d3dctx->device;
+    ID3D11Device_AddRef(p->dev);
+    // The runner reads an event query on the VO's immediate context from its
+    // own thread; mpv's d3d11va hwdec has made the device multithread-
+    // protected already, and this makes sure.
+    if (FAILED(ID3D11Device_QueryInterface(p->dev, &IID_ID3D10Multithread,
+                                           (void **)&p->mt)))
+        p->mt = NULL;
+    if (p->mt && !ID3D10Multithread_GetMultithreadProtected(p->mt)) {
+        ID3D10Multithread_SetMultithreadProtected(p->mt, TRUE);
+        MP_VERBOSE(f, "Turned on multithread protection for the D3D11 device.\n");
+    }
+    p->adapter3 = adapter3_of(p->dev);
+
+    struct link *l = p->link;
+    if (nvvfx_adapter_luid(p->dev, &l->luid) != NVVFX_OK) {
+        give_up(f, false, "no D3D11 adapter", "Could not identify the D3D11 adapter");
+        return f;
+    }
+    l->adapter3 = p->adapter3;
+    if (l->adapter3)
+        IDXGIAdapter3_AddRef(l->adapter3);
+    if (p->opts->path && p->opts->path[0]) {
+        size_t len = strlen(p->opts->path) + 1;
+        l->path = malloc(len);
+        MP_HANDLE_OOM(l->path);
+        memcpy(l->path, p->opts->path, len);
+    }
+
+    // The worker starts loading the runtime (once per process) right away,
+    // while the decoder is still starting.
+    l->prepare = true;
+    atomic_fetch_add(&l->refs, 1);
+    if (mp_thread_create(&p->worker, worker_main, l) != 0) {
+        atomic_fetch_sub(&l->refs, 1);
+        give_up(f, false, "could not start a thread", "Could not start the worker thread");
+        return f;
+    }
+    p->worker_ok = true;
+    atomic_fetch_add(&l->refs, 1);
+    if (mp_thread_create(&p->runner, runner_main, l) != 0) {
+        atomic_fetch_sub(&l->refs, 1);
+        give_up(f, false, "could not start a thread", "Could not start the runner thread");
+        return f;
+    }
+    p->runner_ok = true;
+    return f;
+}
