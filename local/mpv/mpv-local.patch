+/* ======================================================================== logging */
+
+struct nv_log {
+    nvvfx_log_fn fn;
+    void *ctx;
+    nvvfx_error *err;   /* where failures are recorded; may be NULL */
+};
+
+static void log_line(const struct nv_log *lg, int level, const char *msg)
+{
+    if (lg && lg->fn)
+        lg->fn(lg->ctx, level, msg);
+}
+
+static void logm(const struct nv_log *lg, int level, const char *fmt, ...)
+{
+    char buf[512];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(buf, sizeof(buf), fmt, ap);
+    va_end(ap);
+    buf[sizeof(buf) - 1] = 0;
+    log_line(lg, level, buf);
+}
+
+/* Record a failure and log it as one line at `level`. Returns `code`. */
+static int fail_v(const struct nv_log *lg, int level, int code, int sdk_status, int refused,
+                  const char *fmt, va_list ap)
+{
+    char buf[384];
+    vsnprintf(buf, sizeof(buf), fmt, ap);
+    buf[sizeof(buf) - 1] = 0;
+    if (lg && lg->err) {
+        lg->err->code = code;
+        lg->err->sdk_status = sdk_status;
+        lg->err->refused = refused;
+        str_copy(lg->err->msg, sizeof(lg->err->msg), buf);
+    }
+    log_line(lg, level, buf);
+    return code;
+}
+
+static int fail(const struct nv_log *lg, int code, const char *fmt, ...)
+{
+    int r;
+    va_list ap;
+    va_start(ap, fmt);
+    r = fail_v(lg, NVVFX_LOG_ERROR, code, 0, 0, fmt, ap);
+    va_end(ap);
+    return r;
+}
+
+static int fail_at(const struct nv_log *lg, int level, int code, int sdk_status, int refused,
+                   const char *fmt, ...)
+{
+    int r;
+    va_list ap;
+    va_start(ap, fmt);
+    r = fail_v(lg, level, code, sdk_status, refused, fmt, ap);
+    va_end(ap);
+    return r;
+}
+
+static int d3d_fail(const struct nv_log *lg, HRESULT hr, const char *what)
+{
+    return fail(lg, NVVFX_E_D3D, "%s failed: HRESULT 0x%08lx", what, (unsigned long)hr);
+}
