+int nvvfx_runtime_describe_effect(nvvfx_runtime *rt, char *buf, size_t size)
+{
+    NvVFX_Handle fx = NULL;
+    const char *s = NULL;
+    NvCV_Status st;
+    if (!rt || !buf || !size)
+        return NVVFX_E_ARG;
+    buf[0] = 0;
+    if (!rt->vfx.GetString)
+        return NVVFX_E_UNSUPPORTED;
+    st = rt->vfx.CreateEffect(NVVFX_FX_VIDEO_SUPER_RES, &fx);
+    if (st != NVCV_SUCCESS)
+        return sdk_fail(rt, NVVFX_LOG_ERROR, 0, st, "NvVFX_CreateEffect(\"%s\")", NVVFX_FX_VIDEO_SUPER_RES);
+    st = rt->vfx.GetString(fx, NVVFX_INFO, &s);
+    if (st == NVCV_SUCCESS)
+        str_copy(buf, size, s);
+    rt->vfx.DestroyEffect(fx);
+    return st;
+}
