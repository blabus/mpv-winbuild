+    case NVCV_ERR_VERSION_MISMATCH:
+    case NVCV_ERR_CUDA_INIT:
+    case NVCV_ERR_CUDA_DRIVER:
+    case NVCV_ERR_CUDA_KERNEL:
+    case NVCV_ERR_CUDA_UNSUPPORTED:
+        return 1;
+    default:
+        return 0;
+    }
