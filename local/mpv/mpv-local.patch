+int nvvfx_runtime_d3d_format(nvvfx_runtime *rt, DXGI_FORMAT fmt,
+                             int *pixel_format, int *component_type, int *layout)
+{
+    int pf = 0, ct = 0;
+    unsigned char lay = 0;
+    NvCV_Status st;
+    if (!rt)
+        return NVVFX_E_ARG;
+    if (!rt->cv.FromD3DFormat)
+        return NVVFX_E_UNSUPPORTED;
+    st = rt->cv.FromD3DFormat(fmt, &pf, &ct, &lay);
+    if (pixel_format)
