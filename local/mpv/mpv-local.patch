+static const char *nvcv_name(NvCV_Status st)
+{
+    size_t i;
+    for (i = 0; i < sizeof(nvcv_names) / sizeof(nvcv_names[0]); i++) {
+        if (nvcv_names[i].code == st)
+            return nvcv_names[i].name;
+    }
+    if (st <= -1000 && st > -1999)
+        return "NVCV_ERR_CUDA_*";
+    return "unknown status";
+}
