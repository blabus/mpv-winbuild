diff --git a/video/filter/gen_nvvfx_shaders.ps1 b/video/filter/gen_nvvfx_shaders.ps1
new file mode 100644
index 0000000..6fbeacf
--- /dev/null
+++ b/video/filter/gen_nvvfx_shaders.ps1
@@ -0,0 +1,60 @@
+# gen_nvvfx_shaders.ps1 - regenerates nvvfx_shaders.h from nvvfx_repack.hlsl.
+#
+# Development-time only: the generated header is checked in, so building mpv
+# needs neither fxc nor d3dcompiler. Run after editing nvvfx_repack.hlsl:
+#
+#   powershell -ExecutionPolicy Bypass -File video\filter\gen_nvvfx_shaders.ps1 [-Fxc <path\to\fxc.exe>]
+#
+# Without -Fxc it uses the newest x64 fxc.exe under the Windows 10/11 SDK.
+
+param([string]$Fxc)
+
+$ErrorActionPreference = 'Stop'
+$here = Split-Path -Parent $MyInvocation.MyCommand.Path
+$src = Join-Path $here 'nvvfx_repack.hlsl'
+$out = Join-Path $here 'nvvfx_shaders.h'
+
+if (-not $Fxc) {
+    $kits = Join-Path ${env:ProgramFiles(x86)} 'Windows Kits\10\bin'
+    $cand = Get-ChildItem -Path $kits -Directory -ErrorAction SilentlyContinue |
+        Where-Object { Test-Path (Join-Path $_.FullName 'x64\fxc.exe') } |
+        Sort-Object { [version]($_.Name -replace '[^0-9.]', '') } -Descending |
+        Select-Object -First 1
+    if (-not $cand) { throw "fxc.exe not found under $kits; pass -Fxc" }
+    $Fxc = Join-Path $cand.FullName 'x64\fxc.exe'
+}
+
+$entries = @(
+    @{ Entry = 'pack_r32';     Name = 'nvvfx_cs_pack_r32' },
+    @{ Entry = 'unpack_r32';   Name = 'nvvfx_cs_unpack_r32' },
+    @{ Entry = 'pack_rgba8';   Name = 'nvvfx_cs_pack_rgba8' },
+    @{ Entry = 'unpack_rgba8'; Name = 'nvvfx_cs_unpack_rgba8' }
+)
+
+$nl = "`n"
+$text = '/* Generated by gen_nvvfx_shaders.ps1 from nvvfx_repack.hlsl - do not edit. */' + $nl
+$text += '/* fxc /T cs_5_0 /O3 /Qstrip_debug /Qstrip_reflect /Qstrip_priv */' + $nl + $nl
+$text += '#ifndef MP_NVVFX_SHADERS_H' + $nl + '#define MP_NVVFX_SHADERS_H' + $nl
+
+$tmp = [System.IO.Path]::GetTempFileName()
+try {
+    foreach ($e in $entries) {
+        & $Fxc /nologo /T cs_5_0 /E $e.Entry /O3 /WX /Qstrip_debug /Qstrip_reflect /Qstrip_priv /Fo $tmp $src | Out-Null
+        if ($LASTEXITCODE -ne 0) { throw "fxc failed for entry $($e.Entry)" }
+        $bytes = [System.IO.File]::ReadAllBytes($tmp)
+        $text += $nl + "static const unsigned char $($e.Name)[$($bytes.Length)] = {" + $nl
+        for ($i = 0; $i -lt $bytes.Length; $i += 12) {
+            $n = [Math]::Min(12, $bytes.Length - $i)
+            $row = @()
+            for ($j = 0; $j -lt $n; $j++) { $row += ('0x{0:x2}' -f $bytes[$i + $j]) }
+            $text += '    ' + ($row -join ', ') + ',' + $nl
+        }
+        $text += '};' + $nl
+    }
+} finally {
+    Remove-Item $tmp -ErrorAction SilentlyContinue
+}
+
+$text += $nl + '#endif' + $nl
+[System.IO.File]::WriteAllText($out, $text, (New-Object System.Text.UTF8Encoding($false)))
+Write-Host "wrote $out using $Fxc"
diff --git a/video/filter/nvvfx_core.c b/video/filter/nvvfx_core.c
new file mode 100644
index 0000000..8290b15
--- /dev/null
+++ b/video/filter/nvvfx_core.c
@@ -0,0 +1,3525 @@
+/*
+ * nvvfx_core.c - see nvvfx_core.h.
+ *
+ * Every NVIDIA name, enum value and call-order rule that did not come from
+ * NVIDIA's official headers was marked UNCONFIRMED where it is defined. They
+ * have since been checked against the installed 1.3.0.0 runtime (nvidia-vfx
+ * 0.2.0.0: the DLLs' exports, the VideoSuperRes Info string, and
+ * nvvfx-harness on an RTX 4090); each is now marked "Verified (1.3 runtime)"
+ * with what showed it. What is still UNCONFIRMED is marked so.
+ */
+
+#ifndef COBJMACROS
+#define COBJMACROS
+#endif
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "nvvfx_core.h"
+#include "nvvfx_shaders.h"
+
+/* ========================================================================
+ * NVIDIA ABI
+ *
+ * Declared here from NVIDIA's official 1.0.0.0 headers (nvVideoEffects.h,
+ * nvCVImage.h, nvCVStatus.h, nvTransferD3D11.h) unless marked UNCONFIRMED.
+ * NvVFX_API / NvCV_API are __cdecl; on x64 there is only one convention.
+ * ======================================================================== */
+
+#define NV_API __cdecl
+
+typedef int NvCV_Status;
+typedef struct CUstream_st *CUstream;
+typedef struct NvVFX_Object *NvVFX_Handle;
+
+/* NvCV_Status, 1.x numbering (0.7.x used other numbers for the CUDA/D3D codes). */
+#define NVCV_SUCCESS                   0
+#define NVCV_ERR_GENERAL              -1
+#define NVCV_ERR_UNIMPLEMENTED        -2
+#define NVCV_ERR_MEMORY               -3
+#define NVCV_ERR_EFFECT               -4
+#define NVCV_ERR_SELECTOR             -5
+#define NVCV_ERR_BUFFER               -6
+#define NVCV_ERR_PARAMETER            -7
+#define NVCV_ERR_MISMATCH             -8
+#define NVCV_ERR_PIXELFORMAT          -9
+#define NVCV_ERR_MODEL               -10
+#define NVCV_ERR_LIBRARY             -11
+#define NVCV_ERR_INITIALIZATION      -12
+#define NVCV_ERR_FILE                -13
+#define NVCV_ERR_FEATURENOTFOUND     -14
+#define NVCV_ERR_MISSINGINPUT        -15
+#define NVCV_ERR_RESOLUTION          -16
+#define NVCV_ERR_UNSUPPORTEDGPU      -17
+#define NVCV_ERR_WRONGGPU            -18
+#define NVCV_ERR_UNSUPPORTEDDRIVER   -19
+#define NVCV_ERR_MODELDEPENDENCIES   -20
+#define NVCV_ERR_PARSE               -21
+#define NVCV_ERR_MODELSUBSTITUTION   -22
+#define NVCV_ERR_READ                -23
+#define NVCV_ERR_WRITE               -24
+#define NVCV_ERR_PARAMREADONLY       -25
+#define NVCV_ERR_TRT_ENQUEUE         -26
+#define NVCV_ERR_TRT_BINDINGS        -27
+#define NVCV_ERR_TRT_CONTEXT         -28
+#define NVCV_ERR_TRT_INFER           -29
+#define NVCV_ERR_TRT_ENGINE          -30
+#define NVCV_ERR_NPP                 -31
+#define NVCV_ERR_CONFIG              -32
+#define NVCV_ERR_TOOSMALL            -33
+#define NVCV_ERR_TOOBIG              -34
+#define NVCV_ERR_WRONGSIZE           -35
+#define NVCV_ERR_OBJECTNOTFOUND      -36
+#define NVCV_ERR_SINGULAR            -37
+#define NVCV_ERR_NOTHINGRENDERED     -38
+#define NVCV_ERR_CONVERGENCE         -39
+#define NVCV_ERR_EOF                 -40
+#define NVCV_ERR_VERSION_MISMATCH    -41
+#define NVCV_ERR_TRITON_NOSERVICE   -100
+#define NVCV_ERR_OPENGL             -208
+#define NVCV_ERR_DIRECT3D           -210
+#define NVCV_ERR_CUDA_VALUE        -1001
+#define NVCV_ERR_CUDA_MEMORY       -1002
+#define NVCV_ERR_CUDA_INIT         -1003
+#define NVCV_ERR_CUDA_PITCH        -1012
+#define NVCV_ERR_CUDA_DRIVER       -1035
+#define NVCV_ERR_CUDA_KERNEL       -1209
+#define NVCV_ERR_CUDA_ILLEGAL_ADDRESS -1700
+#define NVCV_ERR_CUDA_LAUNCH       -1719
+#define NVCV_ERR_CUDA_UNSUPPORTED  -1801
+#define NVCV_ERR_CUDA              -1999
+
+/* NvCVImage: 64 bytes on x64. Layout from the 1.0 header; pitch is signed.
+ * Verified (1.3 runtime): Alloc/Init/InitFromD3D11Texture fill it as laid out
+ * here (pixelBytes 4, gpuMem NVCV_CUDA_ARRAY for a wrapped R32_UINT texture) and
+ * the effect accepts images described with it. */
+typedef struct NvCVImage {
+    unsigned int width;
+    unsigned int height;
+    int pitch;
+    int pixelFormat;            /* NvCVImage_PixelFormat */
+    int componentType;          /* NvCVImage_ComponentType */
+    unsigned char pixelBytes;
+    unsigned char componentBytes;
+    unsigned char numComponents;
+    unsigned char planar;
+    unsigned char gpuMem;
+    unsigned char colorspace;
+    unsigned char reserved[2];
+    void *pixels;
+    void *deletePtr;
+    void (*deleteProc)(void *p);
+    unsigned long long bufferBytes;
+} NvCVImage;
+
+#ifdef _WIN64
+_Static_assert(sizeof(NvCVImage) == 64, "NvCVImage must be 64 bytes on x64");
+#endif
+
+/* Pixel formats, component types, layout, memory space (1.0 header values). */
+#define NVCV_FORMAT_UNKNOWN  0
+#define NVCV_Y               1
+#define NVCV_RGBA            6
+#define NVCV_BGRA            7
+#define NVCV_RGB10A2        13  /* Verified (1.3 runtime): NvCVImage_Alloc accepts 13/11 and */
+#define NVCV_U8              1  /* VideoSuperRes takes the images, whose SetImage check is   */
+#define NVCV_U32             5  /* "Supported: (RGBA|BGRA)+U8 or RGB10A2+P32" and rejects    */
+#define NVCV_P32            11  /* anything else; FromD3DFormat(R32_UINT) = 1/5, RGBA8 = 6/1 */
+#define NVCV_CHUNKY          0
+#define NVCV_GPU             1
+#define NVCV_CUDA_ARRAY      3
+#define NVCV_LOG_WARNING     2
+
+/* Effect and parameter selectors. */
+/* Effect and parameter selectors. Verified (1.3 runtime): NvVFX_CreateEffect
+ * accepts "VideoSuperRes" (NVIDIA's docs print "Video Super Res", which is
+ * stale), and the effect's own Info string lists exactly these parameters:
+ * CudaStream, SrcImage0, DstImage0, QualityLevel (unsigned, valid "0-4, 8-19,
+ * 21, 23"), Strength (float 0..1, default 1.0), BatchSize (only 1) and
+ * ImageEncodingMode ("0=8-bit RGBA/BGRA, 1=10-bit RGB10A2. Set before Load();
+ * input/output images must match this mode"; the feature DLL also says "set
+ * NVVFX_IMAGE_ENCODING_MODE before the image"). There is no "Mode". */
+#define NVVFX_FX_VIDEO_SUPER_RES   "VideoSuperRes"
+#define NVVFX_INPUT_IMAGE          "SrcImage0"
+#define NVVFX_OUTPUT_IMAGE         "DstImage0"
+#define NVVFX_CUDA_STREAM          "CudaStream"
+#define NVVFX_INFO                 "Info"
+#define NVVFX_STRENGTH             "Strength"
+#define NVVFX_MODE                 "Mode"              /* not a VSR parameter in 1.3; kept as the
+                                                          fallback for a runtime without QualityLevel */
+#define NVVFX_QUALITY_LEVEL        "QualityLevel"
+#define NVVFX_IMAGE_ENCODING_MODE  "ImageEncodingMode"
+#define NVVFX_IMAGE_ENCODING_RGB10A2 1u
+
+/* QualityLevel numbers (1.3 docs' mode table = the Info string's: 0 Bicubic,
+ * 1-4 VSR, 8-11 Denoise, 12-15 Deblur, 16-19 HighBitrate, 21/23 Streaming).
+ * Verified (1.3 runtime): every one of 1-4, 12-19 loads and runs; 16-19 and
+ * 1-4 are accepted at 1x as well as upscaling (third parties said not). */
+#define NV_QL_VSR(level)          ((unsigned)(level))        /* 1..4  VSR Low..Ultra */
+#define NV_QL_DEBLUR(level)       (11u + (unsigned)(level))  /* 12..15 Deblur Low..Ultra */
+#define NV_QL_HIGHBITRATE(level)  (15u + (unsigned)(level))  /* 16..19 HighBitrate Low..Ultra */
+
+/* GPU buffer alignment for NvCVImage_Alloc. NVIDIA's docs say "a byte alignment
+ * of 1 is required by all GPU buffers that are used by the video effect
+ * filters"; NVIDIA's 1.3 sample uses 32. Verified (1.3 runtime): 1 works,
+ * including at odd widths (1919, 1279). */
+#define NV_GPU_ALIGNMENT 1u
+
+/* Files. Verified (1.3 runtime, nvidia-vfx 0.2.0.0, dumpbin): one flat folder
+ * holding NVVideoEffects.dll (imports cudart64_12.dll, NVCVImage.dll; loads
+ * features itself with LoadLibraryExW), NVCVImage.dll (no CUDA import: it
+ * carries a static CUDA runtime), nvVFXVideoSuperRes.dll (imports
+ * nvngxruntime.dll, cudart64_12.dll, NVCVImage.dll, nvcuda.dll; exports only
+ * CreateObject/DestroyObject/SetLogger), nvngxruntime.dll, nvngx_vsr.dll
+ * (1.8.3.0). All need MSVCP140/VCRUNTIME140.
+ * UNCONFIRMED: the NGC SDK layout (bin\ + features\nvvfxvideosuperres\bin\)
+ * is supported by the search but no such install has been tried. */
+#define NV_DLL_VFX       L"NVVideoEffects.dll"
+#define NV_DLL_CVIMAGE   L"NVCVImage.dll"
+#define NV_FEATURE_SUB   L"features\\nvvfxvideosuperres\\bin"
+#define NV_DLL_NGXRT     L"nvngxruntime.dll"
+#define NV_DLL_FEATURE   L"nvVFXVideoSuperRes.dll"
+#define NV_DLL_NGX_VSR   L"nvngx_vsr.dll"
+#define NV_CUDART_GLOB   L"cudart64_*.dll"
+#define NV_CUDART_PREFER L"cudart64_12.dll"
+
+typedef NvCV_Status (NV_API *PFN_NvVFX_GetVersion)(unsigned int *version);
+typedef NvCV_Status (NV_API *PFN_NvVFX_CreateEffect)(const char *code, NvVFX_Handle *effect);
+typedef void        (NV_API *PFN_NvVFX_DestroyEffect)(NvVFX_Handle effect);
+typedef NvCV_Status (NV_API *PFN_NvVFX_SetU32)(NvVFX_Handle effect, const char *sel, unsigned int val);
+typedef NvCV_Status (NV_API *PFN_NvVFX_SetF32)(NvVFX_Handle effect, const char *sel, float val);
+typedef NvCV_Status (NV_API *PFN_NvVFX_GetU32)(NvVFX_Handle effect, const char *sel, unsigned int *val);
+typedef NvCV_Status (NV_API *PFN_NvVFX_SetImage)(NvVFX_Handle effect, const char *sel, NvCVImage *im);
+typedef NvCV_Status (NV_API *PFN_NvVFX_SetCudaStream)(NvVFX_Handle effect, const char *sel, CUstream stream);
+typedef NvCV_Status (NV_API *PFN_NvVFX_GetString)(NvVFX_Handle effect, const char *sel, const char **str);
+typedef NvCV_Status (NV_API *PFN_NvVFX_Load)(NvVFX_Handle effect);
+typedef NvCV_Status (NV_API *PFN_NvVFX_Run)(NvVFX_Handle effect, int async);
+typedef NvCV_Status (NV_API *PFN_NvVFX_CudaStreamCreate)(CUstream *stream);
+typedef NvCV_Status (NV_API *PFN_NvVFX_CudaStreamDestroy)(CUstream stream);
+typedef NvCV_Status (NV_API *PFN_NvVFX_CudaStreamSynchronize)(CUstream stream);
+typedef void (*nv_logger_cb)(void *data, const char *msg);
+typedef NvCV_Status (NV_API *PFN_NvVFX_ConfigureLogger)(int verbosity, const char *file,
+                                                        nv_logger_cb cb, void *cb_data);
+
+typedef NvCV_Status (NV_API *PFN_NvCVImage_Init)(NvCVImage *im, unsigned width, unsigned height,
+                                                 int pitch, void *pixels, int format, int type,
+                                                 unsigned layout, unsigned mem_space);
+typedef NvCV_Status (NV_API *PFN_NvCVImage_Alloc)(NvCVImage *im, unsigned width, unsigned height,
+                                                  int format, int type, unsigned layout,
+                                                  unsigned mem_space, unsigned alignment);
+typedef void        (NV_API *PFN_NvCVImage_Dealloc)(NvCVImage *im);
+typedef NvCV_Status (NV_API *PFN_NvCVImage_Transfer)(const NvCVImage *src, NvCVImage *dst, float scale,
+                                                     CUstream stream, NvCVImage *tmp);
+typedef NvCV_Status (NV_API *PFN_NvCVImage_MapResource)(NvCVImage *im, CUstream stream);
+typedef NvCV_Status (NV_API *PFN_NvCVImage_UnmapResource)(NvCVImage *im, CUstream stream);
+typedef NvCV_Status (NV_API *PFN_NvCVImage_InitFromD3D11Texture)(NvCVImage *im, ID3D11Texture2D *tx);
+typedef NvCV_Status (NV_API *PFN_NvCVImage_FromD3DFormat)(DXGI_FORMAT fmt, int *format, int *type,
+                                                          unsigned char *layout);
+typedef const char *(NV_API *PFN_NvCV_GetErrorStringFromCode)(NvCV_Status code);
+
+/* ========================================================================
+ * CUDA runtime
+ *
+ * The SDK's own cudart64_*.dll, loaded from the SDK's folder so the device
+ * selected here is the device the SDK sees. Prototypes from the CUDA runtime
+ * API (cuda_runtime_api.h, cuda_d3d11_interop.h); CUDARTAPI is __stdcall.
+ * ======================================================================== */
+
+#define CUDART __stdcall
+typedef int cudaError_t;
+typedef struct CUevent_st *cudaEvent_t;
+
+typedef cudaError_t (CUDART *PFN_cudaD3D11GetDevice)(int *device, IDXGIAdapter *adapter);
+typedef cudaError_t (CUDART *PFN_cudaSetDevice)(int device);
+typedef cudaError_t (CUDART *PFN_cudaGetDevice)(int *device);
+typedef cudaError_t (CUDART *PFN_cudaDeviceSynchronize)(void);
+typedef cudaError_t (CUDART *PFN_cudaEventCreate)(cudaEvent_t *event);
+typedef cudaError_t (CUDART *PFN_cudaEventDestroy)(cudaEvent_t event);
+typedef cudaError_t (CUDART *PFN_cudaEventRecord)(cudaEvent_t event, CUstream stream);
+typedef cudaError_t (CUDART *PFN_cudaEventSynchronize)(cudaEvent_t event);
+typedef cudaError_t (CUDART *PFN_cudaEventElapsedTime)(float *ms, cudaEvent_t start, cudaEvent_t end);
+typedef const char *(CUDART *PFN_cudaGetErrorString)(cudaError_t error);
+typedef cudaError_t (CUDART *PFN_cudaRuntimeGetVersion)(int *version);
+typedef cudaError_t (CUDART *PFN_cudaDriverGetVersion)(int *version);
+typedef cudaError_t (CUDART *PFN_cudaMemGetInfo)(size_t *free_bytes, size_t *total_bytes);
+
+/* IID_ID3D10Multithread == IID_ID3D11Multithread. Declared locally so this file
+ * works with and without INITGUID and needs no dxguid.lib. */
+static const GUID nv_iid_multithread =
+    {0x9b7e4e00, 0x342c, 0x4106, {0xa1, 0x9f, 0x4f, 0x27, 0x04, 0xf6, 0x89, 0xf0}};
+static const GUID nv_iid_dxgi_device =
+    {0x54ec77fa, 0x1377, 0x44e6, {0x8c, 0x32, 0x88, 0xfd, 0x5f, 0x44, 0xc8, 0x4c}};
+
+/* ======================================================================== utils */
+
+#define NV_PATH 1024
+
+static double now_ms(void)
+{
+    LARGE_INTEGER t, f;
+    QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&t);
+    return (double)t.QuadPart * 1000.0 / (double)f.QuadPart;
+}
+
+static void str_copy(char *dst, size_t n, const char *src)
+{
+    size_t i = 0;
+    if (!n)
+        return;
+    if (src) {
+        for (; src[i] && i + 1 < n; i++)
+            dst[i] = src[i];
+    }
+    dst[i] = 0;
+}
+
+static void str_cat(char *dst, size_t n, const char *src)
+{
+    size_t l = strlen(dst);
+    if (l < n)
+        str_copy(dst + l, n - l, src);
+}
+
+static void wstr_copy(wchar_t *dst, size_t n, const wchar_t *src)
+{
+    size_t i = 0;
+    if (!n)
+        return;
+    if (src) {
+        for (; src[i] && i + 1 < n; i++)
+            dst[i] = src[i];
+    }
+    dst[i] = 0;
+}
+
+static void wstr_cat(wchar_t *dst, size_t n, const wchar_t *src)
+{
+    size_t l = wcslen(dst);
+    if (l < n)
+        wstr_copy(dst + l, n - l, src);
+}
+
+static void path_join(wchar_t *dst, size_t n, const wchar_t *a, const wchar_t *b)
+{
+    size_t l;
+    wstr_copy(dst, n, a);
+    l = wcslen(dst);
+    if (b && b[0]) {
+        if (l && dst[l - 1] != L'\\' && dst[l - 1] != L'/')
+            wstr_cat(dst, n, L"\\");
+        wstr_cat(dst, n, b);
+    }
+}
+
+static void utf8(char *dst, size_t n, const wchar_t *src)
+{
+    if (!n)
+        return;
+    dst[0] = 0;
+    if (!src)
+        return;
+    if (WideCharToMultiByte(CP_UTF8, 0, src, -1, dst, (int)n, NULL, NULL) <= 0)
+        dst[n - 1] = 0;
+}
+
+static int wstr_ieq(const wchar_t *a, const wchar_t *b)
+{
+    return CompareStringOrdinal(a, -1, b, -1, TRUE) == CSTR_EQUAL;
+}
+
+static int file_exists(const wchar_t *path)
+{
+    DWORD a = GetFileAttributesW(path);
+    return a != INVALID_FILE_ATTRIBUTES && !(a & FILE_ATTRIBUTE_DIRECTORY);
+}
+
+static int dir_exists(const wchar_t *path)
+{
+    DWORD a = GetFileAttributesW(path);
+    return a != INVALID_FILE_ATTRIBUTES && (a & FILE_ATTRIBUTE_DIRECTORY);
+}
+
+static int full_path(wchar_t *dst, size_t n, const wchar_t *src)
+{
+    DWORD r = GetFullPathNameW(src, (DWORD)n, dst, NULL);
+    size_t l;
+    if (!r || r >= n)
+        return 0;
+    l = wcslen(dst);
+    while (l > 3 && (dst[l - 1] == L'\\' || dst[l - 1] == L'/'))
+        dst[--l] = 0;
+    return 1;
+}
+
+static int get_env(const wchar_t *name, wchar_t *buf, size_t n)
+{
+    DWORD r = GetEnvironmentVariableW(name, buf, (DWORD)n);
+    if (!r || r >= n) {
+        buf[0] = 0;
+        return 0;
+    }
+    return 1;
+}
+
+static void win32_message(DWORD err, char *out, size_t n)
+{
+    wchar_t w[256];
+    DWORD len = FormatMessageW(FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS,
+                               NULL, err, 0, w, 256, NULL);
+    while (len && (w[len - 1] == L'\r' || w[len - 1] == L'\n' || w[len - 1] == L' ' ||
+                   w[len - 1] == L'.'))
+        w[--len] = 0;
+    if (!len)
+        w[0] = 0;
+    utf8(out, n, w);
+}
+
+/* GetProcAddress into a typed function-pointer slot without a cast between
+ * function and data pointers (all function pointers have one size on Windows). */
+static int resolve(HMODULE m, const char *name, void *slot)
+{
+    FARPROC f = m ? GetProcAddress(m, name) : NULL;
+    if (!f)
+        return 0;
+    memcpy(slot, &f, sizeof(f));
+    return 1;
+}
