+static int cuda_device_of(nvvfx_runtime *rt, ID3D11Device *dev, int *cuda_dev, char *name, size_t name_n)
+{
+    IDXGIDevice *dxgi = NULL;
+    IDXGIAdapter *ad = NULL;
+    HRESULT hr;
+    cudaError_t e;
+    int d = -1;
+
+    hr = ID3D11Device_QueryInterface(dev, &nv_iid_dxgi_device, (void **)&dxgi);
+    if (FAILED(hr))
+        return d3d_fail(&rt->lg, hr, "ID3D11Device::QueryInterface(IDXGIDevice)");
+    hr = IDXGIDevice_GetAdapter(dxgi, &ad);
+    IDXGIDevice_Release(dxgi);
+    if (FAILED(hr))
+        return d3d_fail(&rt->lg, hr, "IDXGIDevice::GetAdapter");
+    if (name && name_n) {
+        DXGI_ADAPTER_DESC ad_desc;
+        name[0] = 0;
+        if (SUCCEEDED(IDXGIAdapter_GetDesc(ad, &ad_desc)))
+            utf8(name, name_n, ad_desc.Description);
+    }
+    e = rt->cu.D3D11GetDevice(&d, ad);
+    IDXGIAdapter_Release(ad);
+    if (e != 0)
+        return cuda_fail(rt, e, "cudaD3D11GetDevice (is the D3D11 device on the NVIDIA adapter?)");
+    *cuda_dev = d;
+    return NVVFX_OK;
+}
+
+int nvvfx_runtime_cuda_mem(nvvfx_runtime *rt, ID3D11Device *dev,
+                           unsigned long long *free_bytes, unsigned long long *total_bytes)
+{
+    size_t fb = 0, tb = 0;
+    cudaError_t e;
+    if (!rt)
+        return NVVFX_E_ARG;
+    if (!rt->cu.MemGetInfo)
+        return NVVFX_E_UNSUPPORTED;
+    if (dev) {
+        int d = 0, r = cuda_device_of(rt, dev, &d, NULL, 0);
+        if (r)
+            return r;
+        e = rt->cu.SetDevice(d);
+        if (e)
+            return cuda_fail(rt, e, "cudaSetDevice");
+    }
+    e = rt->cu.MemGetInfo(&fb, &tb);
+    if (e)
+        return cuda_fail(rt, e, "cudaMemGetInfo");
+    if (free_bytes)
+        *free_bytes = fb;
+    if (total_bytes)
+        *total_bytes = tb;
+    return NVVFX_OK;
+}
+
+/* ======================================================================== D3D11 helpers */
+
+static ID3D10Multithread *get_multithread(ID3D11Device *dev, const struct nv_log *lg)
+{
+    ID3D10Multithread *mt = NULL;
+    HRESULT hr = ID3D11Device_QueryInterface(dev, &nv_iid_multithread, (void **)&mt);
+    if (FAILED(hr) || !mt) {
+        logm(lg, NVVFX_LOG_WARN, "the D3D11 device has no ID3D10Multithread (HRESULT 0x%08lx); "
+             "immediate-context calls are not locked", (unsigned long)hr);
+        return NULL;
+    }
+    if (!ID3D10Multithread_GetMultithreadProtected(mt)) {
+        ID3D10Multithread_SetMultithreadProtected(mt, TRUE);
+        logm(lg, NVVFX_LOG_INFO, "turned on multithread protection for the shared D3D11 device");
+    }
+    return mt;
+}
+
+static void mt_enter(ID3D10Multithread *mt)
+{
+    if (mt)
+        ID3D10Multithread_Enter(mt);
+}
+
+static void mt_leave(ID3D10Multithread *mt)
+{
+    if (mt)
+        ID3D10Multithread_Leave(mt);
+}
+
+static int is_rgb10(DXGI_FORMAT f)
+{
+    return f == DXGI_FORMAT_R10G10B10A2_UNORM || f == DXGI_FORMAT_R10G10B10A2_TYPELESS;
+}
+
+/* 1 = R32_UINT words, 2 = R8G8B8A8_UINT words, 0 = neither */
+static int word_kind(DXGI_FORMAT f)
+{
+    if (f == DXGI_FORMAT_R32_UINT || f == DXGI_FORMAT_R32_TYPELESS)
+        return 1;
+    if (f == DXGI_FORMAT_R8G8B8A8_UINT || f == DXGI_FORMAT_R8G8B8A8_TYPELESS)
+        return 2;
+    return 0;
+}
+
+static int make_texture(ID3D11Device *dev, const struct nv_log *lg, int w, int h, DXGI_FORMAT fmt,
+                        UINT bind, ID3D11Texture2D **out)
+{
+    D3D11_TEXTURE2D_DESC d = {
+        .Width = (UINT)w,
+        .Height = (UINT)h,
+        .MipLevels = 1,
+        .ArraySize = 1,
+        .Format = fmt,
+        .SampleDesc = {1, 0},
+        .Usage = D3D11_USAGE_DEFAULT,
+        .BindFlags = bind,
+    };
+    char what[96];
+    HRESULT hr = ID3D11Device_CreateTexture2D(dev, &d, NULL, out);
+    if (FAILED(hr)) {
+        *out = NULL;
+        snprintf(what, sizeof(what), "CreateTexture2D(%s %dx%d)", dxgi_format_name(fmt), w, h);
+        return d3d_fail(lg, hr, what);
+    }
+    return NVVFX_OK;
+}
+
+static void copy_tex(ID3D11DeviceContext *ctx, ID3D10Multithread *mt,
+                     ID3D11Texture2D *dst, ID3D11Texture2D *src)
+{
+    /* Subresource 0 to subresource 0: works whatever the source's mip count. */
+    mt_enter(mt);
+    ID3D11DeviceContext_CopySubresourceRegion(ctx, (ID3D11Resource *)dst, 0, 0, 0, 0,
+                                              (ID3D11Resource *)src, 0, NULL);
+    mt_leave(mt);
+}
+
+/* ======================================================================== repack */
+
+struct nvvfx_repack {
+    struct nv_log lg;
+    nvvfx_error err;
+    ID3D11Device *dev;
+    ID3D11DeviceContext *ctx;
+    ID3D10Multithread *mt;
+    ID3D11ComputeShader *cs[4];   /* pack_r32, unpack_r32, pack_rgba8, unpack_rgba8 */
+};
+
+static nvvfx_repack *repack_create(ID3D11Device *dev, const struct nv_log *parent)
+{
+    static const struct { const unsigned char *code; size_t size; } shaders[4] = {
+        {nvvfx_cs_pack_r32, sizeof(nvvfx_cs_pack_r32)},
+        {nvvfx_cs_unpack_r32, sizeof(nvvfx_cs_unpack_r32)},
+        {nvvfx_cs_pack_rgba8, sizeof(nvvfx_cs_pack_rgba8)},
+        {nvvfx_cs_unpack_rgba8, sizeof(nvvfx_cs_unpack_rgba8)},
+    };
+    nvvfx_repack *rp;
+    int i;
+
+    if (!dev) {
+        fail(parent, NVVFX_E_ARG, "repack: no device");
+        return NULL;
+    }
+    if (ID3D11Device_GetFeatureLevel(dev) < D3D_FEATURE_LEVEL_11_0) {
+        fail(parent, NVVFX_E_UNSUPPORTED, "repack: needs D3D feature level 11_0 (cs_5_0)");
+        return NULL;
+    }
+    rp = calloc(1, sizeof(*rp));
+    if (!rp) {
+        fail(parent, NVVFX_E_NOMEM, "repack: out of memory");
+        return NULL;
+    }
+    rp->lg = *parent;
+    if (!rp->lg.err)
+        rp->lg.err = &rp->err;
+    rp->dev = dev;
+    ID3D11Device_AddRef(dev);
+    ID3D11Device_GetImmediateContext(dev, &rp->ctx);
+    rp->mt = get_multithread(dev, &rp->lg);
+    for (i = 0; i < 4; i++) {
+        HRESULT hr = ID3D11Device_CreateComputeShader(dev, shaders[i].code, shaders[i].size,
+                                                      NULL, &rp->cs[i]);
+        if (FAILED(hr)) {
+            d3d_fail(&rp->lg, hr, "repack: CreateComputeShader");
+            nvvfx_repack_destroy(rp);
+            return NULL;
+        }
+    }
+    return rp;
+}
+
+nvvfx_repack *nvvfx_repack_create(ID3D11Device *dev, nvvfx_log_fn log_fn, void *log_ctx)
+{
+    struct nv_log lg = {log_fn, log_ctx, NULL};
+    return repack_create(dev, &lg);
+}
+
+void nvvfx_repack_destroy(nvvfx_repack *rp)
+{
+    int i;
+    if (!rp)
+        return;
+    for (i = 0; i < 4; i++) {
+        if (rp->cs[i])
+            ID3D11ComputeShader_Release(rp->cs[i]);
+    }
+    if (rp->mt)
+        ID3D10Multithread_Release(rp->mt);
+    if (rp->ctx)
+        ID3D11DeviceContext_Release(rp->ctx);
+    if (rp->dev)
+        ID3D11Device_Release(rp->dev);
+    free(rp);
+}
+
+/* The immediate-context state a repack pass touches. */
+struct cs_state {
+    ID3D11ComputeShader *cs;
+    ID3D11ClassInstance *inst[256];
+    UINT ninst;
+    ID3D11ShaderResourceView *srv;
+    ID3D11UnorderedAccessView *uav;
+};
+
+static void cs_save(ID3D11DeviceContext *ctx, struct cs_state *s)
+{
+    s->cs = NULL;
+    s->ninst = 256;
+    ID3D11DeviceContext_CSGetShader(ctx, &s->cs, s->inst, &s->ninst);
+    if (s->ninst > 256)
+        s->ninst = 256;
+    s->srv = NULL;
+    ID3D11DeviceContext_CSGetShaderResources(ctx, 0, 1, &s->srv);
+    s->uav = NULL;
+    ID3D11DeviceContext_CSGetUnorderedAccessViews(ctx, 0, 1, &s->uav);
+}
+
+static void cs_restore(ID3D11DeviceContext *ctx, struct cs_state *s)
+{
+    UINT keep_counter = (UINT)-1;
+    UINT i;
+    ID3D11DeviceContext_CSSetShader(ctx, s->cs, s->ninst ? s->inst : NULL, s->ninst);
+    ID3D11DeviceContext_CSSetUnorderedAccessViews(ctx, 0, 1, &s->uav, &keep_counter);
+    ID3D11DeviceContext_CSSetShaderResources(ctx, 0, 1, &s->srv);
+    if (s->cs)
+        ID3D11ComputeShader_Release(s->cs);
+    for (i = 0; i < s->ninst; i++) {
+        if (s->inst[i])
+            ID3D11ClassInstance_Release(s->inst[i]);
+    }
+    if (s->srv)
+        ID3D11ShaderResourceView_Release(s->srv);
+    if (s->uav)
+        ID3D11UnorderedAccessView_Release(s->uav);
+}
+
+static int repack_pass(nvvfx_repack *rp, int unpack, ID3D11Texture2D *src, ID3D11Texture2D *dst)
+{
+    D3D11_TEXTURE2D_DESC sd, dd;
+    const D3D11_TEXTURE2D_DESC *wd, *cd;
+    D3D11_SHADER_RESOURCE_VIEW_DESC svd;
+    D3D11_UNORDERED_ACCESS_VIEW_DESC uvd;
+    ID3D11ShaderResourceView *srv = NULL;
+    ID3D11UnorderedAccessView *uav = NULL;
+    ID3D11ShaderResourceView *null_srv = NULL;
+    ID3D11UnorderedAccessView *null_uav = NULL;
+    struct cs_state saved;
+    DXGI_FORMAT word_view;
+    HRESULT hr;
+    int kind;
+    const char *op = unpack ? "unpack" : "pack";
+
+    if (!rp || !src || !dst)
+        return rp ? fail(&rp->lg, NVVFX_E_ARG, "repack %s: NULL texture", op) : NVVFX_E_ARG;
+    ID3D11Texture2D_GetDesc(src, &sd);
+    ID3D11Texture2D_GetDesc(dst, &dd);
+    wd = unpack ? &sd : &dd;
+    cd = unpack ? &dd : &sd;
+    kind = word_kind(wd->Format);
+    if (!kind || !is_rgb10(cd->Format))
+        return fail(&rp->lg, NVVFX_E_ARG, "repack %s: wants R10G10B10A2 <-> R32_UINT/R8G8B8A8_UINT, "
+                    "got DXGI formats %d -> %d", op, (int)sd.Format, (int)dd.Format);
+    if (sd.Width != dd.Width || sd.Height != dd.Height)
+        return fail(&rp->lg, NVVFX_E_ARG, "repack %s: %ux%u -> %ux%u, sizes differ", op,
+                    sd.Width, sd.Height, dd.Width, dd.Height);
+    if (!(sd.BindFlags & D3D11_BIND_SHADER_RESOURCE) || !(dd.BindFlags & D3D11_BIND_UNORDERED_ACCESS))
+        return fail(&rp->lg, NVVFX_E_ARG, "repack %s: the source needs SHADER_RESOURCE and the "
+                    "destination UNORDERED_ACCESS", op);
+    if (sd.SampleDesc.Count != 1 || dd.SampleDesc.Count != 1)
+        return fail(&rp->lg, NVVFX_E_ARG, "repack %s: multisampled textures", op);
+
+    word_view = kind == 1 ? DXGI_FORMAT_R32_UINT : DXGI_FORMAT_R8G8B8A8_UINT;
+    memset(&svd, 0, sizeof(svd));
+    svd.Format = unpack ? word_view : DXGI_FORMAT_R10G10B10A2_UNORM;
+    svd.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE2D;
+    svd.Texture2D.MostDetailedMip = 0;
+    svd.Texture2D.MipLevels = 1;
+    memset(&uvd, 0, sizeof(uvd));
+    uvd.Format = unpack ? DXGI_FORMAT_R10G10B10A2_UNORM : word_view;
+    uvd.ViewDimension = D3D11_UAV_DIMENSION_TEXTURE2D;
+    uvd.Texture2D.MipSlice = 0;
+
+    hr = ID3D11Device_CreateShaderResourceView(rp->dev, (ID3D11Resource *)src, &svd, &srv);
+    if (FAILED(hr))
+        return d3d_fail(&rp->lg, hr, unpack ? "repack unpack: CreateShaderResourceView"
+                                             : "repack pack: CreateShaderResourceView");
+    hr = ID3D11Device_CreateUnorderedAccessView(rp->dev, (ID3D11Resource *)dst, &uvd, &uav);
+    if (FAILED(hr)) {
+        ID3D11ShaderResourceView_Release(srv);
+        return d3d_fail(&rp->lg, hr, unpack ? "repack unpack: CreateUnorderedAccessView"
+                                             : "repack pack: CreateUnorderedAccessView");
+    }
+
+    mt_enter(rp->mt);
+    cs_save(rp->ctx, &saved);
+    ID3D11DeviceContext_CSSetShader(rp->ctx, rp->cs[(kind - 1) * 2 + unpack], NULL, 0);
+    /* UAV first: if `src` happens to be bound as CS UAV 0, replacing that
+     * binding first keeps the SRV bind below from being refused. */
+    ID3D11DeviceContext_CSSetUnorderedAccessViews(rp->ctx, 0, 1, &uav, NULL);
+    ID3D11DeviceContext_CSSetShaderResources(rp->ctx, 0, 1, &srv);
+    ID3D11DeviceContext_Dispatch(rp->ctx, (sd.Width + 15) / 16, (sd.Height + 15) / 16, 1);
+    ID3D11DeviceContext_CSSetShaderResources(rp->ctx, 0, 1, &null_srv);
+    ID3D11DeviceContext_CSSetUnorderedAccessViews(rp->ctx, 0, 1, &null_uav, NULL);
+    cs_restore(rp->ctx, &saved);
+    mt_leave(rp->mt);
+
+    ID3D11UnorderedAccessView_Release(uav);
+    ID3D11ShaderResourceView_Release(srv);
+    return NVVFX_OK;
+}
+
+int nvvfx_repack_pack(nvvfx_repack *rp, ID3D11Texture2D *src, ID3D11Texture2D *dst)
+{
+    return repack_pass(rp, 0, src, dst);
+}
+
+int nvvfx_repack_unpack(nvvfx_repack *rp, ID3D11Texture2D *src, ID3D11Texture2D *dst)
+{
+    return repack_pass(rp, 1, src, dst);
+}
+
+/* ======================================================================== pipeline */
+
+struct stage {
+    int live;
+    unsigned quality;
+    float strength;
+    NvVFX_Handle fx;
+};
+
+struct ring {
+    double v[NVVFX_STATS_RING];
+    int n, pos;
+};
+
+struct transport;
+
+struct nvvfx_pipeline {
+    nvvfx_runtime *rt;
+    nvvfx_config cfg;
+    nvvfx_pipeline_info info;
+    char adapter[128];
+
+    ID3D11Device *dev;
+    ID3D11DeviceContext *ctx;
+    ID3D10Multithread *mt;
+    ID3D11Query *query;
+
+    CUstream stream;
+    int have_stream;
+    const char *qsel;              /* the selector that took the quality level */
+
+    struct stage st[2];            /* [0] deblur, [1] upscale */
+    NvCVImage buf_src;             /* in size, RGB10A2/P32, linear CUDA */
+    NvCVImage buf_deb;             /* in size, deblur output (if deblur live) */
+    NvCVImage buf_up;              /* out size, upscale output (if upscale live) */
+    NvCVImage *final;              /* what transport-out reads */
+    NvCVImage tmp;                 /* NvCVImage_Transfer scratch */
+
+    const struct transport *tp;
+    DXGI_FORMAT tx_format;         /* the format registered with CUDA */
+    ID3D11Texture2D *tx_in, *tx_out;
+    NvCVImage img_in, img_out;     /* tx_in / tx_out wrapped (CUDA arrays) */
+    int wrapped_in, wrapped_out;
+    NvCVImage alias_src, alias_final; /* buf_src / *final described in the wrapped format */
+    nvvfx_repack *rp;
+    ID3D11Texture2D *tx_in_copy;   /* R32: for an `in` without SHADER_RESOURCE */
+    ID3D11Texture2D *tx_out_copy;  /* R32: for an `out` without UNORDERED_ACCESS */
+
+    cudaEvent_t ev[8];
+    int have_events;
+    int ev_pending;                /* timing EVENTS: the last run's events are still to be read */
+    CRITICAL_SECTION stats_lock;   /* the rings: stats may be read while a run is in progress */
+    int stats_lock_ok;
+    struct ring wall[NVVFX_STAGE_COUNT];
+    struct ring gpu[NVVFX_STAGE_COUNT];
+
+    int broken, broken_logged;
+};
+
+struct transport {
+    int id;
+    const char *name;
+    int (*d3d_in)(nvvfx_pipeline *p, ID3D11Texture2D *in, const D3D11_TEXTURE2D_DESC *d);
+    int (*d3d_out)(nvvfx_pipeline *p, ID3D11Texture2D *out, const D3D11_TEXTURE2D_DESC *d);
+};
+
+void nvvfx_config_defaults(nvvfx_config *cfg)
+{
+    if (!cfg)
+        return;
+    memset(cfg, 0, sizeof(*cfg));
+    cfg->deblur_strength = 1.0f;
+    cfg->upscale_strength = 1.0f;
+    cfg->upscale_level = 1;
+    cfg->transport = NVVFX_TRANSPORT_AUTO;
+    cfg->sync = NVVFX_SYNC_NONE;
+}
+
+const char *nvvfx_strerror(int err)
+{
+    switch (err) {
+    case NVVFX_OK:             return "ok";
+    case NVVFX_E_ARG:          return "bad argument";
+    case NVVFX_E_D3D:          return "Direct3D 11 failure";
+    case NVVFX_E_SDK:          return "NVIDIA Video Effects SDK failure";
+    case NVVFX_E_CUDA:         return "CUDA failure";
+    case NVVFX_E_NOMEM:        return "out of memory";
+    case NVVFX_E_UNSUPPORTED:  return "unsupported";
+    case NVVFX_E_BROKEN:       return "pipeline unusable, recreate it";
+    case NVVFX_E_RUNTIME:      return "runtime not found or incomplete";
+    case NVVFX_E_TIMEOUT:      return "the GPU did not finish in time";
+    case NVVFX_E_LOST:         return "the NVIDIA device was removed (GPU reset)";
+    case NVVFX_E_PEER_LOST:    return "the video device was removed";
+    default:                   return "unknown error";
+    }
+}
+
+const char *nvvfx_stage_name(int stage)
+{
+    static const char *const names[NVVFX_STAGE_COUNT] = {
+        "transfer in", "deblur", "upscale", "transfer out", "total"};
+    return stage >= 0 && stage < NVVFX_STAGE_COUNT ? names[stage] : "?";
+}
+
+static void ring_push(struct ring *r, double v)
+{
+    r->v[r->pos] = v;
+    r->pos = (r->pos + 1) % NVVFX_STATS_RING;
+    if (r->n < NVVFX_STATS_RING)
+        r->n++;
+}
+
+static int cmp_double(const void *a, const void *b)
+{
+    double x = *(const double *)a, y = *(const double *)b;
+    return (x > y) - (x < y);
+}
+
+static void stats_push(nvvfx_pipeline *p, struct ring *r, double v)
+{
+    EnterCriticalSection(&p->stats_lock);
+    ring_push(r, v);
+    LeaveCriticalSection(&p->stats_lock);
+}
+
+static void ring_stats(const struct ring *r, int *count, double *median, double *p99,
+                       double *max, double *last)
+{
+    double tmp[NVVFX_STATS_RING];
+    int n = r->n, k;
+    *count = n;
+    if (!n) {
+        *median = *p99 = 0;
+        if (max)
+            *max = 0;
+        if (last)
+            *last = 0;
+        return;
+    }
+    /* Until the ring wraps, the first n slots are the samples; after, all are. */
+    memcpy(tmp, r->v, (size_t)n * sizeof(double));
+    qsort(tmp, (size_t)n, sizeof(double), cmp_double);
+    *median = (n & 1) ? tmp[n / 2] : (tmp[n / 2 - 1] + tmp[n / 2]) / 2;
+    k = (99 * n + 99) / 100 - 1;   /* nearest rank */
+    if (k < 0)
+        k = 0;
+    if (k > n - 1)
+        k = n - 1;
+    *p99 = tmp[k];
+    if (max)
+        *max = tmp[n - 1];
+    if (last)
+        *last = r->v[(r->pos + NVVFX_STATS_RING - 1) % NVVFX_STATS_RING];
+}
+
+static int cuda_select(nvvfx_pipeline *p)
+{
+    /* The SDK "uses the CUDA runtime's current device". NVVideoEffects.dll and
+     * the feature import the cudart64_12.dll loaded here, so they share this
+     * selection; NVCVImage.dll carries a static CUDA runtime, which picks up
+     * the primary context this call makes current on the thread.
+     * UNCONFIRMED on a multi-GPU machine: the 4090 is the only CUDA device
+     * here, so a wrong selection could not have shown. */
+    cudaError_t e = p->rt->cu.SetDevice(p->info.cuda_device);
+    if (e)
+        return cuda_fail(p->rt, e, "cudaSetDevice");
+    return NVVFX_OK;
+}
+
+static int stream_sync(nvvfx_pipeline *p)
+{
+    NvCV_Status st = p->rt->vfx.CudaStreamSynchronize(p->stream);
+    if (st != NVCV_SUCCESS)
+        return sdk_fail(p->rt, NVVFX_LOG_ERROR, 0, st, "NvVFX_CudaStreamSynchronize");
+    return NVVFX_OK;
+}
+
+static int sync_after_run(nvvfx_pipeline *p)
+{
+    if (p->cfg.sync == NVVFX_SYNC_DEVICE && p->rt->cu.DeviceSynchronize) {
+        cudaError_t e = p->rt->cu.DeviceSynchronize();
+        if (e)
+            return cuda_fail(p->rt, e, "cudaDeviceSynchronize");
+        return NVVFX_OK;
+    }
+    if (p->cfg.sync != NVVFX_SYNC_NONE ||
+        (p->cfg.timing && p->cfg.timing != NVVFX_TIMING_EVENTS))
+        return stream_sync(p);
+    return NVVFX_OK;
+}
+
+static void d3d_wait(nvvfx_pipeline *p)
+{
+    double deadline;
+    if (!p->query)
+        return;
+    mt_enter(p->mt);
+    ID3D11DeviceContext_End(p->ctx, (ID3D11Asynchronous *)p->query);
+    ID3D11DeviceContext_Flush(p->ctx);
+    mt_leave(p->mt);
+    deadline = now_ms() + 5000.0;
+    for (;;) {
+        BOOL done = FALSE;
+        HRESULT hr;
+        mt_enter(p->mt);
+        hr = ID3D11DeviceContext_GetData(p->ctx, (ID3D11Asynchronous *)p->query, &done,
+                                         sizeof(done), D3D11_ASYNC_GETDATA_DONOTFLUSH);
+        mt_leave(p->mt);
+        if (hr != S_FALSE || now_ms() > deadline)
+            break;
+        SwitchToThread();
+    }
+}
+
+static void ev_record(nvvfx_pipeline *p, int i)
+{
+    if (p->have_events)
+        p->rt->cu.EventRecord(p->ev[i], p->stream);
+}
+
+/* CUDA side of a transport: map the registered texture, copy between it and the
+ * linear buffer, unmap - unmapping whatever happened in between. */
+static int cuda_copy(nvvfx_pipeline *p, int in, int ev_a, int ev_b)
+{
+    nvvfx_runtime *rt = p->rt;
+    NvCVImage *tex = in ? &p->img_in : &p->img_out;
+    const char *dir = in ? "in" : "out";
+    NvCV_Status st, st2;
+
+    /* Never hold the D3D11 device lock across a CUDA call. The CUDA driver
+     * takes its own context lock first and then the device's multithread
+     * critical section inside its interop calls (map, unmap, register,
+     * unregister), so holding the device lock here and calling in is a
+     * lock-order inversion: nvvfx-harness "concurrent" deadlocked with this
+     * thread in cuGraphicsMapResources (holding the D3D lock, waiting for
+     * CUDA's) and a worker destroying another pipeline in
+     * cuGraphicsUnregisterResource (holding CUDA's, waiting for the D3D lock). */
+    st = rt->cv.MapResource(tex, p->stream);
+    if (st != NVCV_SUCCESS)
+        return sdk_fail(rt, NVVFX_LOG_ERROR, 0, st, "NvCVImage_MapResource(%s)", dir);
+    if (ev_a >= 0)
+        ev_record(p, ev_a);
+    if (in)
+        st = rt->cv.Transfer(tex, &p->alias_src, 1.0f, p->stream, &p->tmp);
+    else
+        st = rt->cv.Transfer(&p->alias_final, tex, 1.0f, p->stream, &p->tmp);
+    if (ev_b >= 0)
+        ev_record(p, ev_b);
+    st2 = rt->cv.UnmapResource(tex, p->stream);
+    if (st2 != NVCV_SUCCESS) {
+        p->broken = 1;
+        return sdk_fail(rt, NVVFX_LOG_ERROR, 0, st2, "NvCVImage_UnmapResource(%s)", dir);
+    }
+    if (st != NVCV_SUCCESS)
+        return sdk_fail(rt, NVVFX_LOG_ERROR,
+                        st == NVCV_ERR_PIXELFORMAT || st == NVCV_ERR_MISMATCH ||
+                        st == NVCV_ERR_UNIMPLEMENTED, st,
+                        "NvCVImage_Transfer(%s, %s)", dir, dxgi_format_name(p->tx_format));
+    return NVVFX_OK;
+}
+
+/* ---- transports: the D3D11 halves */
+
+static int direct_in(nvvfx_pipeline *p, ID3D11Texture2D *in, const D3D11_TEXTURE2D_DESC *d)
+{
+    (void)d;
+    copy_tex(p->ctx, p->mt, p->tx_in, in);
+    return NVVFX_OK;
+}
+
+static int direct_out(nvvfx_pipeline *p, ID3D11Texture2D *out, const D3D11_TEXTURE2D_DESC *d)
+{
+    (void)d;
+    copy_tex(p->ctx, p->mt, out, p->tx_out);
+    return NVVFX_OK;
+}
+
+static int r32_in(nvvfx_pipeline *p, ID3D11Texture2D *in, const D3D11_TEXTURE2D_DESC *d)
+{
+    ID3D11Texture2D *src = in;
+    if (!(d->BindFlags & D3D11_BIND_SHADER_RESOURCE)) {
+        if (!p->tx_in_copy) {
+            int r = make_texture(p->dev, &p->rt->lg, p->info.in_w, p->info.in_h,
+                                 DXGI_FORMAT_R10G10B10A2_UNORM, D3D11_BIND_SHADER_RESOURCE,
+                                 &p->tx_in_copy);
+            if (r)
+                return r;
+        }
+        copy_tex(p->ctx, p->mt, p->tx_in_copy, in);
+        src = p->tx_in_copy;
+    }
+    return nvvfx_repack_pack(p->rp, src, p->tx_in);
+}
+
+static int r32_out(nvvfx_pipeline *p, ID3D11Texture2D *out, const D3D11_TEXTURE2D_DESC *d)
+{
+    ID3D11Texture2D *dst = out;
+    int r;
+    if (!(d->BindFlags & D3D11_BIND_UNORDERED_ACCESS)) {
+        if (!p->tx_out_copy) {
+            r = make_texture(p->dev, &p->rt->lg, p->info.out_w, p->info.out_h,
+                             DXGI_FORMAT_R10G10B10A2_UNORM, D3D11_BIND_UNORDERED_ACCESS,
+                             &p->tx_out_copy);
+            if (r)
+                return r;
+        }
+        dst = p->tx_out_copy;
+    }
+    r = nvvfx_repack_unpack(p->rp, p->tx_out, dst);
+    if (!r && dst != out)
+        copy_tex(p->ctx, p->mt, out, dst);
+    return r;
+}
+
+static const struct transport transport_direct = {
+    NVVFX_TRANSPORT_DIRECT, "direct", direct_in, direct_out,
+};
+
+static const struct transport transport_r32 = {
+    NVVFX_TRANSPORT_R32, "r32", r32_in, r32_out,
+};
+
+static void transport_uninit(nvvfx_pipeline *p)
+{
+    nvvfx_runtime *rt = p->rt;
+    /* Dealloc of a wrapped image unregisters its CUDA graphics resource; the
+     * texture must still exist then. */
+    if (p->wrapped_in)
+        rt->cv.Dealloc(&p->img_in);
+    if (p->wrapped_out)
+        rt->cv.Dealloc(&p->img_out);
+    p->wrapped_in = p->wrapped_out = 0;
+    memset(&p->img_in, 0, sizeof(p->img_in));
+    memset(&p->img_out, 0, sizeof(p->img_out));
+    memset(&p->alias_src, 0, sizeof(p->alias_src));
+    memset(&p->alias_final, 0, sizeof(p->alias_final));
+    if (p->tx_in)
+        ID3D11Texture2D_Release(p->tx_in);
+    if (p->tx_out)
+        ID3D11Texture2D_Release(p->tx_out);
+    if (p->tx_in_copy)
+        ID3D11Texture2D_Release(p->tx_in_copy);
+    if (p->tx_out_copy)
+        ID3D11Texture2D_Release(p->tx_out_copy);
+    p->tx_in = p->tx_out = p->tx_in_copy = p->tx_out_copy = NULL;
+    nvvfx_repack_destroy(p->rp);
+    p->rp = NULL;
+    p->tp = NULL;
+}
+
+static int wrap_texture(nvvfx_pipeline *p, ID3D11Texture2D *tx, NvCVImage *img, int *wrapped,
+                        int w, int h, int level)
+{
+    nvvfx_runtime *rt = p->rt;
+    NvCV_Status st;
+    memset(img, 0, sizeof(*img));
+    /* Verified (1.3 runtime): InitFromD3D11Texture refuses R10G10B10A2_UNORM
+     * with NVCV_ERR_PIXELFORMAT, and wraps R32_UINT as NVCV_Y/NVCV_U32 (and
+     * R8G8B8A8_UINT as NVCV_RGBA/NVCV_U8), 4 bytes per pixel, NVCV_CUDA_ARRAY;
+     * the same-format Transfer to and from the linear buffer is bit-exact. */
+    st = rt->cv.InitFromD3D11Texture(img, tx);
+    if (st != NVCV_SUCCESS)
+        return sdk_fail(rt, level, 1, st, "%s(%s %dx%d)", rt->info.wrap_export,
+                        dxgi_format_name(p->tx_format), w, h);
+    *wrapped = 1;
+    if (img->pixelBytes != 4 || img->gpuMem != NVCV_CUDA_ARRAY)
+        return fail_at(&rt->lg, level, NVVFX_E_UNSUPPORTED, 0, 1,
+                       "%s wraps %s as NvCVImage format %d / component %d / %u bytes per pixel / "
+                       "memory %u; a raw 4-byte copy needs 4 bytes per pixel in a CUDA array",
+                       rt->info.wrap_export, dxgi_format_name(p->tx_format), img->pixelFormat,
+                       img->componentType, (unsigned)img->pixelBytes, (unsigned)img->gpuMem);
+    return NVVFX_OK;
+}
+
+static int transport_init(nvvfx_pipeline *p, const struct transport *tp, DXGI_FORMAT fmt, int level)
+{
+    nvvfx_runtime *rt = p->rt;
+    UINT bind = D3D11_BIND_SHADER_RESOURCE;
+    NvCV_Status st;
+    int r;
+
+    p->tp = tp;
+    p->tx_format = fmt;
+    if (tp->id == NVVFX_TRANSPORT_R32) {
+        bind |= D3D11_BIND_UNORDERED_ACCESS;
+        p->rp = repack_create(p->dev, &rt->lg);
+        if (!p->rp)
+            return rt->err.code ? rt->err.code : NVVFX_E_D3D;
+    }
+    r = make_texture(p->dev, &rt->lg, p->info.in_w, p->info.in_h, fmt, bind, &p->tx_in);
+    if (!r)
+        r = make_texture(p->dev, &rt->lg, p->info.out_w, p->info.out_h, fmt, bind, &p->tx_out);
+    if (!r)
+        r = wrap_texture(p, p->tx_in, &p->img_in, &p->wrapped_in, p->info.in_w, p->info.in_h, level);
+    if (!r)
+        r = wrap_texture(p, p->tx_out, &p->img_out, &p->wrapped_out, p->info.out_w, p->info.out_h,
+                         level);
+    if (r)
+        return r;
+
+    /* The linear buffers, re-described in whatever 4-byte format the wrapped
+     * textures came back as: the transfer is then a same-format copy (a
+     * cudaMemcpy2D from/to the array), which NvCVImage accommodates for every
+     * format, and the bits are the R10G10B10A2 word either way. */
+    st = rt->cv.Init(&p->alias_src, p->buf_src.width, p->buf_src.height, p->buf_src.pitch,
+                     p->buf_src.pixels, p->img_in.pixelFormat, p->img_in.componentType,
+                     NVCV_CHUNKY, NVCV_GPU);
+    if (st == NVCV_SUCCESS)
+        st = rt->cv.Init(&p->alias_final, p->final->width, p->final->height, p->final->pitch,
+                         p->final->pixels, p->img_out.pixelFormat, p->img_out.componentType,
+                         NVCV_CHUNKY, NVCV_GPU);
+    if (st != NVCV_SUCCESS)
+        return sdk_fail(rt, level, 1, st, "NvCVImage_Init(alias as format %d/%d)",
+                        p->img_in.pixelFormat, p->img_in.componentType);
+
+    /* Prove both CUDA directions once now, so "auto" falls back here and not
+     * on the first frame. */
+    r = cuda_copy(p, 1, -1, -1);
+    if (!r)
+        r = cuda_copy(p, 0, -1, -1);
+    if (!r)
+        r = stream_sync(p);
+    if (r)
+        return r;
+    logm(&rt->lg, NVVFX_LOG_DEBUG, "transport %s: %s wraps as NvCVImage format %d/%d",
+         tp->name, dxgi_format_name(fmt), p->img_in.pixelFormat, p->img_in.componentType);
+    return NVVFX_OK;
+}
+
+static NvCV_Status set_quality(nvvfx_pipeline *p, NvVFX_Handle fx, unsigned q)
+{
+    nvvfx_runtime *rt = p->rt;
+    NvCV_Status st;
+    if (!p->qsel || strcmp(p->qsel, NVVFX_QUALITY_LEVEL) == 0) {
+        st = rt->vfx.SetU32(fx, NVVFX_QUALITY_LEVEL, q);
+        if (st != NVCV_ERR_SELECTOR) {
+            if (st == NVCV_SUCCESS)
+                p->qsel = NVVFX_QUALITY_LEVEL;
+            return st;
+        }
+    }
+    st = rt->vfx.SetU32(fx, NVVFX_MODE, q);
+    if (st == NVCV_SUCCESS)
+        p->qsel = NVVFX_MODE;
+    return st;
+}
+
+static unsigned quality_for(const nvvfx_pipeline *p, int stage, int level)
+{
+    if (stage == 0)
+        return NV_QL_DEBLUR(level);
+    if (p->cfg.upscale_family == NVVFX_UPSCALE_HIGHBITRATE)
+        return NV_QL_HIGHBITRATE(level);
+    return NV_QL_VSR(level);
+}
+
+/*
+ * Create, configure, load and run once one VideoSuperRes instance.
+ * Returns 0 on success, 1 if the SDK refused the configuration (recorded in
+ * rt->err, logged at `level`), negative on a failure that is not a refusal.
+ *
+ * Call order (NVIDIA's 1.3 sample; Verified (1.3 runtime), and the feature
+ * DLL's own messages require ImageEncodingMode before the images and Load):
+ * ImageEncodingMode, images, stream, quality, strength, Load, Run. The first
+ * Load in a process with no other VideoSuperRes effect alive costs ~400 ms;
+ * later ones ~25 ms (see nvvfx_runtime_keep_warm).
+ */
+static int stage_create(nvvfx_pipeline *p, int idx, unsigned quality, float strength,
+                        NvCVImage *src, NvCVImage *dst, int level)
+{
+    nvvfx_runtime *rt = p->rt;
+    struct stage *s = &p->st[idx];
+    const char *name = idx ? "upscale" : "deblur";
+    NvVFX_Handle fx = NULL;
+    NvCV_Status st;
+    double t0, t1, t2, t3;
+    int r = NVVFX_OK;
+
+    t0 = now_ms();
+    st = rt->vfx.CreateEffect(NVVFX_FX_VIDEO_SUPER_RES, &fx);
+    if (st != NVCV_SUCCESS)
+        return sdk_fail(rt, NVVFX_LOG_ERROR, 0, st, "NvVFX_CreateEffect(\"%s\")",
+                        NVVFX_FX_VIDEO_SUPER_RES);
+
+    st = rt->vfx.SetU32(fx, NVVFX_IMAGE_ENCODING_MODE, NVVFX_IMAGE_ENCODING_RGB10A2);
+    if (st == NVCV_ERR_SELECTOR) {
+        if (p->info.encoding_mode_supported != 0)
+            logm(&rt->lg, NVVFX_LOG_WARN, "VideoSuperRes does not understand \"%s\"; relying on "
+                 "the RGB10A2 image format alone", NVVFX_IMAGE_ENCODING_MODE);
+        p->info.encoding_mode_supported = 0;
+    } else if (st != NVCV_SUCCESS) {
+        sdk_fail(rt, level, 1, st, "%s: SetU32(%s, %u)", name, NVVFX_IMAGE_ENCODING_MODE,
+                     NVVFX_IMAGE_ENCODING_RGB10A2);
+        goto refused;
+    } else {
+        p->info.encoding_mode_supported = 1;
+    }
+
+    st = rt->vfx.SetImage(fx, NVVFX_INPUT_IMAGE, src);
+    if (st != NVCV_SUCCESS) {
+        sdk_fail(rt, level, 1, st, "%s: SetImage(%s, %ux%u RGB10A2)", name, NVVFX_INPUT_IMAGE,
+                     src->width, src->height);
+        goto refused;
+    }
+    st = rt->vfx.SetImage(fx, NVVFX_OUTPUT_IMAGE, dst);
+    if (st != NVCV_SUCCESS) {
+        sdk_fail(rt, level, 1, st, "%s: SetImage(%s, %ux%u RGB10A2)", name, NVVFX_OUTPUT_IMAGE,
+                     dst->width, dst->height);
+        goto refused;
+    }
+    /* A blocking stream (NvVFX_CudaStreamCreate wraps cudaStreamCreate; a
+     * third party saw VideoSuperRes queue work on the legacy default stream,
+     * which only a blocking stream is ordered against). Verified (1.3
+     * runtime): CUDA events on this stream bracket the effect's full GPU time,
+     * and pipelined frames with no CPU sync come out right (harness "order"). */
+    st = rt->vfx.SetCudaStream(fx, NVVFX_CUDA_STREAM, p->stream);
+    if (st != NVCV_SUCCESS) {
+        sdk_fail(rt, level, 1, st, "%s: SetCudaStream", name);
+        goto refused;
+    }
+    st = set_quality(p, fx, quality);
+    if (st != NVCV_SUCCESS) {
+        sdk_fail(rt, level, 1, st, "%s: SetU32(%s|%s, %u)", name, NVVFX_QUALITY_LEVEL,
+                     NVVFX_MODE, quality);
+        goto refused;
+    }
+    st = rt->vfx.SetF32(fx, NVVFX_STRENGTH, strength);
+    if (st == NVCV_ERR_SELECTOR) {
+        logm(&rt->lg, NVVFX_LOG_WARN, "%s: VideoSuperRes does not understand \"%s\"; the "
+             "strength is ignored", name, NVVFX_STRENGTH);
+        p->info.strength_supported[idx] = 0;
+    } else if (st != NVCV_SUCCESS) {
+        sdk_fail(rt, level, 1, st, "%s: SetF32(%s, %.2f)", name, NVVFX_STRENGTH, strength);
+        goto refused;
+    } else {
+        p->info.strength_supported[idx] = 1;
+    }
+    t1 = now_ms();
+
+    st = rt->vfx.Load(fx);
+    if (st != NVCV_SUCCESS) {
+        sdk_fail(rt, level, 1, st, "%s: NvVFX_Load(QualityLevel %u, %ux%u -> %ux%u)", name,
+                     quality, src->width, src->height, dst->width, dst->height);
+        goto refused;
+    }
+    t2 = now_ms();
+    if (rt->cu.GetDevice) {
+        int d = -1;
+        /* NvVFX_Load switches to "the best GPU" when the current one is
+         * unsupported (docs: Multi-GPU Default Behavior). */
+        if (rt->cu.GetDevice(&d) == 0 && d != p->info.cuda_device) {
+            r = fail_at(&rt->lg, NVVFX_LOG_ERROR, NVVFX_E_UNSUPPORTED, 0, 0,
+                        "%s: NvVFX_Load moved the CUDA device from %d to %d (the D3D11 adapter's "
+                        "GPU is not supported)", name, p->info.cuda_device, d);
+            rt->vfx.DestroyEffect(fx);
+            return r;
+        }
+    }
+    st = rt->vfx.Run(fx, p->cfg.run_async);
+    if (st == NVCV_SUCCESS)
+        st = rt->vfx.CudaStreamSynchronize(p->stream);
+    if (st != NVCV_SUCCESS) {
+        sdk_fail(rt, level, 1, st, "%s: NvVFX_Run(QualityLevel %u, %ux%u -> %ux%u)", name,
+                     quality, src->width, src->height, dst->width, dst->height);
+        goto refused;
+    }
+    t3 = now_ms();
+
+    s->fx = fx;
+    s->live = 1;
+    s->quality = quality;
+    s->strength = strength;
+    p->info.create_ms[idx] = t1 - t0;
+    p->info.load_ms[idx] = t2 - t1;
+    p->info.first_run_ms[idx] = t3 - t2;
+    return 0;
+
+refused:
+    rt->vfx.DestroyEffect(fx);
+    return 1;
+}
+
+static int alloc_buffer(nvvfx_pipeline *p, NvCVImage *img, int w, int h, int level)
+{
+    NvCV_Status st;
+    memset(img, 0, sizeof(*img));
+    st = p->rt->cv.Alloc(img, (unsigned)w, (unsigned)h, NVCV_RGB10A2, NVCV_P32, NVCV_CHUNKY,
+                         NVCV_GPU, NV_GPU_ALIGNMENT);
+    if (st != NVCV_SUCCESS) {
+        memset(img, 0, sizeof(*img));
+        return sdk_fail(p->rt, level, st == NVCV_ERR_MEMORY || st == NVCV_ERR_CUDA_MEMORY, st,
+                        "NvCVImage_Alloc(%dx%d NVCV_RGB10A2/NVCV_P32 on the GPU)", w, h);
+    }
+    return NVVFX_OK;
+}
+
+static void free_buffer(nvvfx_pipeline *p, NvCVImage *img)
+{
+    if (img->deletePtr || img->pixels)
+        p->rt->cv.Dealloc(img);
+    memset(img, 0, sizeof(*img));
+}
+
+static void fit_box(int iw, int ih, int bw, int bh, int *ow, int *oh)
+{
+    long long a = (long long)bw * ih, b = (long long)bh * iw;
+    int w, h;
+    if (a <= b) {   /* the width runs out first */
+        w = bw;
+        h = (int)((2LL * ih * bw + iw) / (2LL * iw));
+        if (h > bh)
+            h = bh;
+    } else {
+        h = bh;
+        w = (int)((2LL * iw * bh + ih) / (2LL * ih));
+        if (w > bw)
+            w = bw;
+    }
+    *ow = w & ~1;
+    *oh = h & ~1;
+}
+
+static int validate_cfg(nvvfx_runtime *rt, const nvvfx_config *c)
+{
+    if (c->in_w < 16 || c->in_h < 16 || c->in_w > 16384 || c->in_h > 16384)
+        return fail(&rt->lg, NVVFX_E_ARG, "input size %dx%d out of range", c->in_w, c->in_h);
+    if (c->deblur_level < 0 || c->deblur_level > 4)
+        return fail(&rt->lg, NVVFX_E_ARG, "deblur level %d (want 0..4)", c->deblur_level);
+    if (c->upscale_family < NVVFX_UPSCALE_OFF || c->upscale_family > NVVFX_UPSCALE_VSR)
+        return fail(&rt->lg, NVVFX_E_ARG, "upscale family %d", c->upscale_family);
+    if (c->upscale_family != NVVFX_UPSCALE_OFF && (c->upscale_level < 1 || c->upscale_level > 4))
+        return fail(&rt->lg, NVVFX_E_ARG, "upscale level %d (want 1..4)", c->upscale_level);
+    if (!(c->deblur_strength >= 0.0f && c->deblur_strength <= 1.0f) ||
+        !(c->upscale_strength >= 0.0f && c->upscale_strength <= 1.0f))
+        return fail(&rt->lg, NVVFX_E_ARG, "strength out of 0..1");
+    if (c->target_w < 0 || c->target_h < 0 || c->target_w > 16384 || c->target_h > 16384)
+        return fail(&rt->lg, NVVFX_E_ARG, "target box %dx%d out of range", c->target_w, c->target_h);
+    if (c->transport < NVVFX_TRANSPORT_AUTO || c->transport > NVVFX_TRANSPORT_R32)
+        return fail(&rt->lg, NVVFX_E_ARG, "transport %d", c->transport);
+    if (c->sync < NVVFX_SYNC_NONE || c->sync > NVVFX_SYNC_DEVICE)
+        return fail(&rt->lg, NVVFX_E_ARG, "sync mode %d", c->sync);
+    return NVVFX_OK;
+}
+
+static int choose_transport(nvvfx_pipeline *p)
+{
+    nvvfx_runtime *rt = p->rt;
+    static const DXGI_FORMAT word_formats[2] = {DXGI_FORMAT_R32_UINT, DXGI_FORMAT_R8G8B8A8_UINT};
+    char why[sizeof(rt->err.msg)] = "";
+    int r, i;
+
+    if (p->cfg.transport == NVVFX_TRANSPORT_DIRECT)
+        return transport_init(p, &transport_direct, DXGI_FORMAT_R10G10B10A2_UNORM, NVVFX_LOG_ERROR);
+
+    if (p->cfg.transport == NVVFX_TRANSPORT_AUTO) {
+        r = transport_init(p, &transport_direct, DXGI_FORMAT_R10G10B10A2_UNORM, NVVFX_LOG_DEBUG);
+        if (!r)
+            return NVVFX_OK;
+        str_copy(why, sizeof(why), rt->err.msg);
+        transport_uninit(p);
+        logm(&rt->lg, NVVFX_LOG_INFO, "direct transport unavailable (%s); using r32", why);
+    }
+    for (i = 0; i < 2; i++) {
+        r = transport_init(p, &transport_r32, word_formats[i], i ? NVVFX_LOG_ERROR : NVVFX_LOG_DEBUG);
+        if (!r)
+            return NVVFX_OK;
+        str_copy(why, sizeof(why), rt->err.msg);
+        transport_uninit(p);
+        if (!i)
+            logm(&rt->lg, NVVFX_LOG_INFO, "r32 transport: R32_UINT unusable (%s); trying "
+                 "R8G8B8A8_UINT words", why);
+    }
+    return r;
+}
+
+nvvfx_pipeline *nvvfx_pipeline_create(nvvfx_runtime *rt, ID3D11Device *dev, const nvvfx_config *cfg)
+{
+    nvvfx_pipeline *p;
+    NvCV_Status st;
+    HRESULT hr;
+    int r, i;
+    int fit_w = 0, fit_h = 0;
+    int want_up;
+    int level = NVVFX_LOG_DEBUG;   /* refusals during negotiation are summarised, not logged */
+
+    if (!rt)
+        return NULL;
+    memset(&rt->err, 0, sizeof(rt->err));
+    if (!dev || !cfg) {
+        fail(&rt->lg, NVVFX_E_ARG, "nvvfx_pipeline_create: NULL device or config");
+        return NULL;
+    }
+    if (validate_cfg(rt, cfg))
+        return NULL;
+
+    p = calloc(1, sizeof(*p));
+    if (!p) {
+        fail(&rt->lg, NVVFX_E_NOMEM, "out of memory");
+        return NULL;
+    }
+    p->rt = rt;
+    InterlockedIncrement(&rt->pipelines);
+    InitializeCriticalSection(&p->stats_lock);
+    p->stats_lock_ok = 1;
+    p->cfg = *cfg;
+    p->dev = dev;
+    ID3D11Device_AddRef(dev);
+    ID3D11Device_GetImmediateContext(dev, &p->ctx);
+    p->mt = get_multithread(dev, &rt->lg);
+    p->info.in_w = cfg->in_w;
+    p->info.in_h = cfg->in_h;
+    p->info.encoding_mode_supported = -1;
+    p->final = &p->buf_src;
+    if (cfg->exact)
+        level = NVVFX_LOG_ERROR;
+
+    {
+        D3D11_QUERY_DESC qd = {D3D11_QUERY_EVENT, 0};
+        hr = ID3D11Device_CreateQuery(dev, &qd, &p->query);
+        if (FAILED(hr)) {
+            d3d_fail(&rt->lg, hr, "CreateQuery(EVENT)");
+            goto fail;
+        }
+    }
+
+    r = cuda_device_of(rt, dev, &p->info.cuda_device, p->adapter, sizeof(p->adapter));
+    if (r || cuda_select(p))
+        goto fail;
+
+    st = rt->vfx.CudaStreamCreate(&p->stream);
+    if (st != NVCV_SUCCESS) {
+        sdk_fail(rt, NVVFX_LOG_ERROR, 0, st, "NvVFX_CudaStreamCreate");
+        goto fail;
+    }
+    p->have_stream = 1;
+
+    if (alloc_buffer(p, &p->buf_src, cfg->in_w, cfg->in_h, NVVFX_LOG_ERROR))
+        goto fail;
+
+    /* ---- stage 1: deblur at the input size */
+    if (cfg->deblur_level > 0) {
+        if (alloc_buffer(p, &p->buf_deb, cfg->in_w, cfg->in_h, NVVFX_LOG_ERROR))
+            goto fail;
+        r = stage_create(p, 0, NV_QL_DEBLUR(cfg->deblur_level), cfg->deblur_strength,
+                         &p->buf_src, &p->buf_deb, level);
+        if (r < 0 || (r > 0 && cfg->exact))
+            goto fail;
+        if (r > 0) {
+            snprintf(p->info.fallback, sizeof(p->info.fallback), "deblur dropped: %s", rt->err.msg);
+            logm(&rt->lg, NVVFX_LOG_WARN, "deblur (QualityLevel %u) refused, continuing without it: %s",
+                 NV_QL_DEBLUR(cfg->deblur_level), rt->err.msg);
+            free_buffer(p, &p->buf_deb);
+        } else {
+            p->final = &p->buf_deb;
+        }
+    }
+
+    /* ---- stage 2: upscale into the target box */
+    want_up = cfg->upscale_family != NVVFX_UPSCALE_OFF;
+    if (want_up && cfg->exact) {
+        fit_w = cfg->target_w;
+        fit_h = cfg->target_h;
+        if (fit_w < 16 || fit_h < 16) {
+            fail(&rt->lg, NVVFX_E_ARG, "exact mode needs a target size");
+            goto fail;
+        }
+    } else if (want_up) {
+        if (cfg->target_w > 0 && cfg->target_h > 0)
+            fit_box(cfg->in_w, cfg->in_h, cfg->target_w, cfg->target_h, &fit_w, &fit_h);
+        if (!(fit_w > cfg->in_w && fit_h > cfg->in_h)) {
+            logm(&rt->lg, NVVFX_LOG_INFO, "no upscale: the target box %dx%d does not exceed the "
+                 "input %dx%d", cfg->target_w, cfg->target_h, cfg->in_w, cfg->in_h);
+            want_up = 0;
+        }
+    }
+    if (want_up) {
+        int cw[4], ch[4], nc = 0, k;
+        unsigned q = quality_for(p, 1, cfg->upscale_level);
+        NvCVImage *up_src = p->st[0].live ? &p->buf_deb : &p->buf_src;
+        char tried[200] = "";
+
+        cw[nc] = fit_w;
+        ch[nc++] = fit_h;
+        for (k = 4; k >= 2 && !cfg->exact; k--) {
+            int w = k * cfg->in_w, h = k * cfg->in_h;
+            if (w <= cfg->target_w && h <= cfg->target_h && !(w == fit_w && h == fit_h)) {
+                cw[nc] = w;
+                ch[nc++] = h;
+            }
+        }
+        for (i = 0; i < nc; i++) {
+            char one[64];
+            r = alloc_buffer(p, &p->buf_up, cw[i], ch[i], level);
+            if (r == NVVFX_OK) {
+                r = stage_create(p, 1, q, cfg->upscale_strength, up_src, &p->buf_up, level);
+                if (r == 0) {
+                    p->info.out_w = cw[i];
+                    p->info.out_h = ch[i];
+                    p->final = &p->buf_up;
+                    break;
+                }
+                free_buffer(p, &p->buf_up);
+                if (r < 0 || cfg->exact)
+                    goto fail;
+            } else if (cfg->exact || !rt->err.refused) {
+                goto fail;
+            }
+            snprintf(one, sizeof(one), "%s%dx%d", tried[0] ? ", " : "", cw[i], ch[i]);
+            str_cat(tried, sizeof(tried), one);
+            if (status_not_size_related(rt->err.sdk_status))
+                break;
+        }
+        if (!p->st[1].live) {
+            char msg[sizeof(p->info.fallback)];
+            snprintf(msg, sizeof(msg), "upscale refused at %s; no upscale (%s)", tried, rt->err.msg);
+            logm(&rt->lg, NVVFX_LOG_WARN, "%s", msg);
+            if (p->info.fallback[0])
+                str_cat(p->info.fallback, sizeof(p->info.fallback), "; ");
+            str_cat(p->info.fallback, sizeof(p->info.fallback), msg);
+        } else if (tried[0]) {
+            char msg[sizeof(p->info.fallback)];
+            snprintf(msg, sizeof(msg), "upscale refused at %s; using %dx%d (%s)", tried,
+                     p->info.out_w, p->info.out_h, rt->err.msg);
+            logm(&rt->lg, NVVFX_LOG_WARN, "%s", msg);
+            if (p->info.fallback[0])
+                str_cat(p->info.fallback, sizeof(p->info.fallback), "; ");
+            str_cat(p->info.fallback, sizeof(p->info.fallback), msg);
+        }
+    }
+    if (!p->st[1].live) {
+        p->info.out_w = cfg->in_w;
+        p->info.out_h = cfg->in_h;
+    }
+    if (!p->st[0].live && !p->st[1].live && (cfg->deblur_level > 0 || want_up))
+        logm(&rt->lg, NVVFX_LOG_WARN, "no VideoSuperRes stage is live: frames pass through unchanged");
+
+    /* ---- transport */
+    if (choose_transport(p))
+        goto fail;
+
+    if (cfg->timing && rt->cu.EventCreate && rt->cu.EventRecord && rt->cu.EventElapsedTime &&
+        rt->cu.EventDestroy) {
+        p->have_events = 1;
+        for (i = 0; i < 8 && p->have_events; i++) {
+            if (rt->cu.EventCreate(&p->ev[i]) != 0) {
+                int j;
+                for (j = 0; j < i; j++)
+                    rt->cu.EventDestroy(p->ev[j]);
+                memset(p->ev, 0, sizeof(p->ev));
+                p->have_events = 0;
+            }
+        }
+    }
+
+    for (i = 0; i < 2; i++) {
+        p->info.strength_supported[i] = p->st[i].live ? p->info.strength_supported[i] : 0;
+    }
+    p->info.deblur_live = p->st[0].live;
+    p->info.upscale_live = p->st[1].live;
+    p->info.deblur_quality = p->st[0].live ? p->st[0].quality : 0;
+    p->info.upscale_quality = p->st[1].live ? p->st[1].quality : 0;
+    p->info.deblur_strength = p->st[0].live ? p->st[0].strength : 0.0f;
+    p->info.upscale_strength = p->st[1].live ? p->st[1].strength : 0.0f;
+    p->info.quality_selector = p->qsel ? p->qsel : "";
+    p->info.transport = p->tp->id;
+    p->info.transport_format = (int)p->tx_format;
+    if (p->info.encoding_mode_supported < 0)
+        p->info.encoding_mode_supported = 0;
+
+    {
+        char deb[48] = "off", up[48] = "off";
+        if (p->st[0].live)
+            snprintf(deb, sizeof(deb), "QualityLevel %u strength %.2f", p->st[0].quality,
+                     p->st[0].strength);
+        if (p->st[1].live)
+            snprintf(up, sizeof(up), "QualityLevel %u strength %.2f", p->st[1].quality,
+                     p->st[1].strength);
+        logm(&rt->lg, NVVFX_LOG_INFO, "VideoSuperRes %dx%d -> %dx%d: deblur %s, upscale %s, "
+             "transport %s (%s), CUDA device %d (%s)", p->info.in_w, p->info.in_h, p->info.out_w,
+             p->info.out_h, deb, up, p->tp->name, dxgi_format_name(p->tx_format),
+             p->info.cuda_device, p->adapter);
+    }
+    memset(&rt->err, 0, sizeof(rt->err));
+    return p;
+
+fail:
+    {
+        nvvfx_error keep = rt->err;
+        nvvfx_pipeline_destroy(p);
+        rt->err = keep;
+    }
+    return NULL;
+}
+
+void nvvfx_pipeline_destroy(nvvfx_pipeline *p)
+{
+    nvvfx_runtime *rt;
+    int i;
+    if (!p)
+        return;
+    rt = p->rt;
+    if (p->have_stream) {
+        rt->cu.SetDevice(p->info.cuda_device);
+        rt->vfx.CudaStreamSynchronize(p->stream);
+    }
+    for (i = 0; i < 2; i++) {
+        if (p->st[i].fx)
+            rt->vfx.DestroyEffect(p->st[i].fx);
+        p->st[i].fx = NULL;
+    }
+    transport_uninit(p);
+    free_buffer(p, &p->buf_up);
+    free_buffer(p, &p->buf_deb);
+    free_buffer(p, &p->buf_src);
+    free_buffer(p, &p->tmp);
+    if (p->have_events) {
+        for (i = 0; i < 8; i++)
+            rt->cu.EventDestroy(p->ev[i]);
+    }
+    if (p->have_stream)
+        rt->vfx.CudaStreamDestroy(p->stream);
+    if (p->query)
+        ID3D11Query_Release(p->query);
+    if (p->mt)
+        ID3D10Multithread_Release(p->mt);
+    if (p->ctx)
+        ID3D11DeviceContext_Release(p->ctx);
+    if (p->dev)
+        ID3D11Device_Release(p->dev);
+    if (p->stats_lock_ok)
+        DeleteCriticalSection(&p->stats_lock);
+    InterlockedDecrement(&rt->pipelines);
+    free(p);
+}
+
+const nvvfx_pipeline_info *nvvfx_pipeline_get_info(const nvvfx_pipeline *p)
+{
+    return p ? &p->info : NULL;
+}
+
+void nvvfx_pipeline_out_desc(const nvvfx_pipeline *p, D3D11_TEXTURE2D_DESC *desc)
+{
+    if (!desc)
+        return;
+    memset(desc, 0, sizeof(*desc));
+    if (!p)
+        return;
+    desc->Width = (UINT)p->info.out_w;
+    desc->Height = (UINT)p->info.out_h;
+    desc->MipLevels = 1;
+    desc->ArraySize = 1;
+    desc->Format = DXGI_FORMAT_R10G10B10A2_UNORM;
+    desc->SampleDesc.Count = 1;
+    desc->Usage = D3D11_USAGE_DEFAULT;
+    desc->BindFlags = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_UNORDERED_ACCESS;
+}
+
+static int check_tex(nvvfx_pipeline *p, ID3D11Texture2D *t, int w, int h, const char *what,
+                     int is_out, D3D11_TEXTURE2D_DESC *d)
+{
+    const struct nv_log *lg = &p->rt->lg;
+    ID3D11Device *td = NULL;
+    int same;
+    if (!t)
+        return fail(lg, NVVFX_E_ARG, "the %s texture is NULL", what);
+    ID3D11Texture2D_GetDesc(t, d);
+    if (!is_rgb10(d->Format))
+        return fail(lg, NVVFX_E_ARG, "the %s texture is DXGI format %d, not R10G10B10A2_UNORM",
+                    what, (int)d->Format);
+    if ((int)d->Width != w || (int)d->Height != h)
+        return fail(lg, NVVFX_E_ARG, "the %s texture is %ux%u; the pipeline was negotiated for %dx%d",
+                    what, d->Width, d->Height, w, h);
+    if (d->ArraySize != 1 || d->SampleDesc.Count != 1)
+        return fail(lg, NVVFX_E_ARG, "the %s texture must be a non-array, single-sample texture", what);
+    if (is_out && d->Usage != D3D11_USAGE_DEFAULT)
+        return fail(lg, NVVFX_E_ARG, "the output texture must be D3D11_USAGE_DEFAULT");
+    ID3D11Texture2D_GetDevice(t, &td);
+    same = td == p->dev;
+    if (td)
+        ID3D11Device_Release(td);
+    if (!same)
+        return fail(lg, NVVFX_E_ARG, "the %s texture belongs to another D3D11 device", what);
+    return NVVFX_OK;
+}
+
+static void harvest_gpu(nvvfx_pipeline *p)
+{
+    nvvfx_runtime *rt = p->rt;
+    static const int stage_of[4] = {NVVFX_STAGE_IN, NVVFX_STAGE_DEBLUR, NVVFX_STAGE_UPSCALE,
+                                    NVVFX_STAGE_OUT};
+    int i;
+    if (rt->cu.EventSynchronize)
+        rt->cu.EventSynchronize(p->ev[7]);
+    for (i = 0; i < 4; i++) {
+        float ms = 0;
+        if ((i == 1 && !p->st[0].live) || (i == 2 && !p->st[1].live))
+            continue;
+        if (rt->cu.EventElapsedTime(&ms, p->ev[2 * i], p->ev[2 * i + 1]) == 0)
+            stats_push(p, &p->gpu[stage_of[i]], ms);
+    }
+    {
+        float ms = 0;
+        if (rt->cu.EventElapsedTime(&ms, p->ev[0], p->ev[7]) == 0)
+            stats_push(p, &p->gpu[NVVFX_STAGE_TOTAL], ms);
+    }
+}
+
+int nvvfx_pipeline_run(nvvfx_pipeline *p, ID3D11Texture2D *in, ID3D11Texture2D *out)
+{
+    D3D11_TEXTURE2D_DESC din, dout;
+    nvvfx_runtime *rt;
+    double t0, ts;
+    int timing, events, r, i;
+
+    if (!p)
+        return NVVFX_E_ARG;
+    rt = p->rt;
+    if (p->broken) {
+        if (!p->broken_logged)
+            fail(&rt->lg, NVVFX_E_BROKEN, "pipeline unusable after an earlier failure; recreate it");
+        p->broken_logged = 1;
+        return NVVFX_E_BROKEN;
+    }
+    r = check_tex(p, in, p->info.in_w, p->info.in_h, "input", 0, &din);
+    if (!r)
+        r = check_tex(p, out, p->info.out_w, p->info.out_h, "output", 1, &dout);
+    if (!r)
+        r = cuda_select(p);
+    if (r)
+        return r;
+
+    /* Timing EVENTS: the previous run's events, read now rather than waited
+     * for then. That run was queued a frame ago and has normally finished, so
+     * the event synchronise in harvest_gpu returns at once. */
+    events = p->cfg.timing == NVVFX_TIMING_EVENTS && p->have_events;
+    if (events && p->ev_pending)
+        harvest_gpu(p);
+    p->ev_pending = 0;
+
+    timing = p->cfg.timing && p->cfg.timing != NVVFX_TIMING_EVENTS;
+    if (timing)
+        d3d_wait(p);   /* so "transfer in" is our work, not the caller's queue */
+    t0 = now_ms();
+
+    /* transfer in */
+    r = p->tp->d3d_in(p, in, &din);
+    if (!r)
+        r = cuda_copy(p, 1, 0, 1);
+    if (!r && timing)
+        r = stream_sync(p);
+    if (r)
+        return r;
+    if (timing)
+        stats_push(p, &p->wall[NVVFX_STAGE_IN], now_ms() - t0);
+
+    /* the effects */
+    for (i = 0; i < 2; i++) {
+        NvCV_Status st;
+        if (!p->st[i].live)
+            continue;
+        ts = now_ms();
+        ev_record(p, 2 + 2 * i);
+        st = rt->vfx.Run(p->st[i].fx, p->cfg.run_async);
+        ev_record(p, 3 + 2 * i);
+        if (st != NVCV_SUCCESS)
+            return sdk_fail(rt, NVVFX_LOG_ERROR, 1, st, "%s: NvVFX_Run", i ? "upscale" : "deblur");
+        r = sync_after_run(p);
+        if (r)
+            return r;
+        if (timing)
+            stats_push(p, &p->wall[NVVFX_STAGE_DEBLUR + i], now_ms() - ts);
+    }
+
+    /* transfer out */
+    ts = now_ms();
+    r = cuda_copy(p, 0, 6, 7);
+    if (!r)
+        r = p->tp->d3d_out(p, out, &dout);
+    if (r)
+        return r;
+    if (timing) {
+        d3d_wait(p);
+        stats_push(p, &p->wall[NVVFX_STAGE_OUT], now_ms() - ts);
+    }
+    stats_push(p, &p->wall[NVVFX_STAGE_TOTAL], now_ms() - t0);
+    if (timing && p->have_events)
+        harvest_gpu(p);
+    if (events)
+        p->ev_pending = 1;
+    return NVVFX_OK;
+}
+
+int nvvfx_pipeline_set_strength(nvvfx_pipeline *p, float deblur, float upscale)
+{
+    nvvfx_runtime *rt;
+    float v[2];
+    int i, all = 1;
+    if (!p)
+        return NVVFX_E_ARG;
+    rt = p->rt;
+    if (p->broken)
+        return NVVFX_E_BROKEN;
+    v[0] = deblur;
+    v[1] = upscale;
+    for (i = 0; i < 2; i++) {
+        if (v[i] > 1.0f)
+            return fail(&rt->lg, NVVFX_E_ARG, "strength %.3f out of 0..1", v[i]);
+    }
+    if (cuda_select(p))
+        return rt->err.code;
+    for (i = 0; i < 2; i++) {
+        NvCV_Status st;
+        if (!(v[i] >= 0.0f) || !p->st[i].live || v[i] == p->st[i].strength)
+            continue;
+        st = rt->vfx.SetF32(p->st[i].fx, NVVFX_STRENGTH, v[i]);
+        if (st != NVCV_SUCCESS) {
+            sdk_fail(rt, NVVFX_LOG_WARN, 1, st, "%s: live SetF32(%s, %.2f)", i ? "upscale" : "deblur",
+                     NVVFX_STRENGTH, v[i]);
+            all = 0;
+            continue;
+        }
+        p->st[i].strength = v[i];
+        if (i)
+            p->info.upscale_strength = v[i];
+        else
+            p->info.deblur_strength = v[i];
+    }
+    return all;
+}
+
+int nvvfx_pipeline_set_levels(nvvfx_pipeline *p, int deblur_level, int upscale_level)
+{
+    nvvfx_runtime *rt;
+    int lv[2];
+    int i, all = 1, changed;
+    if (!p)
+        return NVVFX_E_ARG;
+    rt = p->rt;
+    if (p->broken)
+        return NVVFX_E_BROKEN;
+    lv[0] = deblur_level;
+    lv[1] = upscale_level;
+    for (i = 0; i < 2; i++) {
+        if (lv[i] > 4)
+            return fail(&rt->lg, NVVFX_E_ARG, "level %d (want 0..4)", lv[i]);
+    }
+    changed = 0;
+    if (cuda_select(p))
+        return rt->err.code;
+    for (i = 0; i < 2; i++) {
+        const char *name = i ? "upscale" : "deblur";
+        unsigned q;
+        NvCV_Status st;
+        if (lv[i] < 0)
+            continue;
+        if (lv[i] == 0 || !p->st[i].live) {
+            if ((lv[i] == 0) != !p->st[i].live) {
+                fail_at(&rt->lg, NVVFX_LOG_WARN, NVVFX_E_UNSUPPORTED, 0, 1, "turning the %s stage "
+                        "%s needs a new pipeline", name, lv[i] ? "on" : "off");
+                all = 0;
+            }
+            continue;
+        }
+        q = quality_for(p, i, lv[i]);
+        if (q == p->st[i].quality)
+            continue;
+        st = set_quality(p, p->st[i].fx, q);
+        if (st != NVCV_SUCCESS) {
+            sdk_fail(rt, NVVFX_LOG_WARN, 1, st, "%s: live %s(%u)", name, p->qsel ? p->qsel :
+                     NVVFX_QUALITY_LEVEL, q);
+            all = 0;
+            continue;
+        }
+        p->st[i].quality = q;
+        if (i)
+            p->info.upscale_quality = q;
+        else
+            p->info.deblur_quality = q;
+        changed = 1;
+    }
+    /* The medians describe the levels in force: start them again, and drop
+     * the events of the last run (made at the old level) unread. */
+    if (changed) {
+        nvvfx_pipeline_reset_stats(p);
+        p->ev_pending = 0;
+    }
+    return all;
+}
+
+int nvvfx_pipeline_reload(nvvfx_pipeline *p)
+{
+    nvvfx_runtime *rt;
+    int i;
+    if (!p)
+        return NVVFX_E_ARG;
+    rt = p->rt;
+    if (p->broken)
+        return NVVFX_E_BROKEN;
+    if (cuda_select(p))
+        return rt->err.code;
+    for (i = 0; i < 2; i++) {
+        NvCV_Status st;
+        if (!p->st[i].live)
+            continue;
+        st = rt->vfx.Load(p->st[i].fx);
+        if (st != NVCV_SUCCESS) {
+            p->broken = 1;
+            return sdk_fail(rt, NVVFX_LOG_ERROR, 0, st, "%s: NvVFX_Load (reload)",
+                            i ? "upscale" : "deblur");
+        }
+    }
+    return NVVFX_OK;
+}
+
+void nvvfx_pipeline_stats(const nvvfx_pipeline *p, int stage, nvvfx_stage_stats *out)
+{
+    if (!out)
+        return;
+    memset(out, 0, sizeof(*out));
+    if (!p || stage < 0 || stage >= NVVFX_STAGE_COUNT)
+        return;
+    EnterCriticalSection((CRITICAL_SECTION *)&p->stats_lock);
+    ring_stats(&p->wall[stage], &out->count, &out->median_ms, &out->p99_ms, &out->max_ms,
+               &out->last_ms);
+    ring_stats(&p->gpu[stage], &out->gpu_count, &out->gpu_median_ms, &out->gpu_p99_ms,
+               &out->gpu_max_ms, NULL);
+    LeaveCriticalSection((CRITICAL_SECTION *)&p->stats_lock);
+}
+
+void nvvfx_pipeline_reset_stats(nvvfx_pipeline *p)
+{
+    if (!p)
+        return;
+    EnterCriticalSection(&p->stats_lock);
+    memset(p->wall, 0, sizeof(p->wall));
+    memset(p->gpu, 0, sizeof(p->gpu));
+    LeaveCriticalSection(&p->stats_lock);
+}
+
+/* ======================================================================== keep warm */
+
+int nvvfx_runtime_keep_warm(nvvfx_runtime *rt, ID3D11Device *dev)
+{
+    nvvfx_config cfg;
+    nvvfx_error keep;
+    if (!rt || !dev)
+        return NVVFX_E_ARG;
+    if (rt->warm && rt->warm_dev == dev)
+        return NVVFX_OK;
+    nvvfx_runtime_cool(rt);
+    /* The smallest useful instance: NVIDIA recommends 360p as the minimum input. */
+    nvvfx_config_defaults(&cfg);
+    cfg.in_w = 640;
+    cfg.in_h = 360;
+    cfg.deblur_level = 1;
+    cfg.exact = 1;
+    keep = rt->err;
+    rt->warm = nvvfx_pipeline_create(rt, dev, &cfg);
+    if (!rt->warm)
+        return rt->err.code ? rt->err.code : NVVFX_E_SDK;
+    rt->err = keep;
+    rt->warm_dev = dev;
+    logm(&rt->lg, NVVFX_LOG_DEBUG, "keeping the SDK warm with a 640x360 deblur instance");
+    return NVVFX_OK;
+}
+
+void nvvfx_runtime_cool(nvvfx_runtime *rt)
+{
+    if (!rt || !rt->warm)
+        return;
+    nvvfx_pipeline_destroy(rt->warm);
+    rt->warm = NULL;
+    rt->warm_dev = NULL;
+}
