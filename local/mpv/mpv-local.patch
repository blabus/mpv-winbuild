+/* ======================================================================== private device */
+
+static const GUID nv_iid_dxgi_factory1 =
+    {0x770aae78, 0xf26f, 0x4dba, {0xa8, 0x29, 0x25, 0x3c, 0x83, 0xd1, 0xb3, 0x87}};
+static const GUID nv_iid_dxgi_resource =
+    {0x035f3ab4, 0x482e, 0x4e50, {0xb4, 0x1f, 0x8a, 0x7f, 0x8b, 0xd8, 0x96, 0x0b}};
+static const GUID nv_iid_texture2d =
+    {0x6f15aaf2, 0xd208, 0x4e89, {0x9a, 0xb4, 0x48, 0x95, 0x35, 0xd3, 0x4f, 0x9c}};
+static const GUID nv_iid_keyed_mutex =
+    {0x9d8e1289, 0xd7b3, 0x465f, {0x81, 0x26, 0x25, 0x0e, 0x34, 0x9a, 0xf8, 0x5d}};
+
+typedef HRESULT (WINAPI *PFN_nv_CreateDXGIFactory1)(REFIID riid, void **factory);
+typedef HRESULT (WINAPI *PFN_nv_D3D11CreateDevice)(IDXGIAdapter *adapter, D3D_DRIVER_TYPE type,
+                                                  HMODULE software, UINT flags,
+                                                  const D3D_FEATURE_LEVEL *levels, UINT nlevels,
+                                                  UINT sdk_version, ID3D11Device **dev,
+                                                  D3D_FEATURE_LEVEL *level, ID3D11DeviceContext **ctx);
+
+struct nvvfx_device {
+    ID3D11Device *dev;
+    LUID luid;
+    char name[128];
+};
+
+static int luid_eq(const LUID *a, const LUID *b)
+{
+    return a->LowPart == b->LowPart && a->HighPart == b->HighPart;
+}
+
+int nvvfx_adapter_luid(ID3D11Device *dev, LUID *luid)
+{
+    IDXGIDevice *dxgi = NULL;
+    IDXGIAdapter *ad = NULL;
+    DXGI_ADAPTER_DESC d;
+    HRESULT hr;
+    if (!dev || !luid)
+        return NVVFX_E_ARG;
+    memset(&d, 0, sizeof(d));
+    hr = ID3D11Device_QueryInterface(dev, &nv_iid_dxgi_device, (void **)&dxgi);
+    if (SUCCEEDED(hr))
+        hr = IDXGIDevice_GetAdapter(dxgi, &ad);
+    if (SUCCEEDED(hr))
+        hr = IDXGIAdapter_GetDesc(ad, &d);
+    if (SUCCEEDED(hr))
+        *luid = d.AdapterLuid;
+    if (ad)
+        IDXGIAdapter_Release(ad);
+    if (dxgi)
+        IDXGIDevice_Release(dxgi);
+    return SUCCEEDED(hr) ? NVVFX_OK : NVVFX_E_D3D;
+}
+
+nvvfx_device *nvvfx_device_create(const LUID *luid, nvvfx_log_fn log_fn, void *log_ctx)
+{
+    static const D3D_FEATURE_LEVEL levels[] = {D3D_FEATURE_LEVEL_11_1, D3D_FEATURE_LEVEL_11_0};
+    struct nv_log lg = {log_fn, log_ctx, NULL};
+    PFN_nv_CreateDXGIFactory1 create_factory = NULL;
+    PFN_nv_D3D11CreateDevice create_device = NULL;
+    HMODULE dxgi_dll, d3d11_dll;
+    IDXGIFactory1 *fac = NULL;
+    IDXGIAdapter1 *ad = NULL, *found = NULL;
+    DXGI_ADAPTER_DESC1 desc, found_desc;
+    ID3D11Device *dev = NULL;
+    ID3D11DeviceContext *ctx = NULL;
+    ID3D10Multithread *mt = NULL;
+    UINT flags = D3D11_CREATE_DEVICE_BGRA_SUPPORT | D3D11_CREATE_DEVICE_VIDEO_SUPPORT;
+    nvvfx_device *d;
+    HRESULT hr;
+    UINT i;
+
+    if (!luid) {
+        fail(&lg, NVVFX_E_ARG, "nvvfx_device_create: no adapter LUID");
+        return NULL;
+    }
+    /* Both stay loaded: a process with a D3D11 device has them loaded anyway. */
+    dxgi_dll = LoadLibraryExW(L"dxgi.dll", NULL, LOAD_LIBRARY_SEARCH_SYSTEM32);
+    d3d11_dll = LoadLibraryExW(L"d3d11.dll", NULL, LOAD_LIBRARY_SEARCH_SYSTEM32);
+    if (!resolve(dxgi_dll, "CreateDXGIFactory1", &create_factory) ||
+        !resolve(d3d11_dll, "D3D11CreateDevice", &create_device)) {
+        fail(&lg, NVVFX_E_D3D, "private device: dxgi.dll/d3d11.dll do not export "
+             "CreateDXGIFactory1/D3D11CreateDevice");
+        return NULL;
+    }
+    hr = create_factory(&nv_iid_dxgi_factory1, (void **)&fac);
+    if (FAILED(hr)) {
+        d3d_fail(&lg, hr, "private device: CreateDXGIFactory1");
+        return NULL;
+    }
+    memset(&found_desc, 0, sizeof(found_desc));
+    for (i = 0; IDXGIFactory1_EnumAdapters1(fac, i, &ad) == S_OK; i++) {
+        if (!found && SUCCEEDED(IDXGIAdapter1_GetDesc1(ad, &desc)) &&
+            luid_eq(&desc.AdapterLuid, luid)) {
+            found = ad;
+            found_desc = desc;
+        } else {
+            IDXGIAdapter1_Release(ad);
+        }
+        ad = NULL;
+    }
+    IDXGIFactory1_Release(fac);
+    if (!found) {
+        fail(&lg, NVVFX_E_UNSUPPORTED, "private device: no adapter with LUID %08lx:%08lx",
+             (unsigned long)luid->HighPart, (unsigned long)luid->LowPart);
+        return NULL;
+    }
+    hr = create_device((IDXGIAdapter *)found, D3D_DRIVER_TYPE_UNKNOWN, NULL, flags, levels, 2,
+                       D3D11_SDK_VERSION, &dev, NULL, &ctx);
+    if (FAILED(hr)) {
+        /* (the flags are the ones nvvfx-harness has always run with; a driver
+         * without video support still gets a device) */
+        flags = 0;
+        hr = create_device((IDXGIAdapter *)found, D3D_DRIVER_TYPE_UNKNOWN, NULL, flags, levels, 2,
+                           D3D11_SDK_VERSION, &dev, NULL, &ctx);
+    }
+    IDXGIAdapter1_Release(found);
+    if (ctx)
+        ID3D11DeviceContext_Release(ctx);
+    if (FAILED(hr)) {
+        d3d_fail(&lg, hr, "private device: D3D11CreateDevice");
+        return NULL;
+    }
+    if (SUCCEEDED(ID3D11Device_QueryInterface(dev, &nv_iid_multithread, (void **)&mt))) {
+        ID3D10Multithread_SetMultithreadProtected(mt, TRUE);
+        ID3D10Multithread_Release(mt);
+    }
+    d = calloc(1, sizeof(*d));
+    if (!d) {
+        ID3D11Device_Release(dev);
+        fail(&lg, NVVFX_E_NOMEM, "out of memory");
+        return NULL;
+    }
+    d->dev = dev;
+    d->luid = *luid;
+    utf8(d->name, sizeof(d->name), found_desc.Description);
+    logm(&lg, NVVFX_LOG_INFO, "private D3D11 device on %s (LUID %08lx:%08lx), feature level %x, "
+         "flags 0x%x", d->name, (unsigned long)luid->HighPart, (unsigned long)luid->LowPart,
+         (unsigned)ID3D11Device_GetFeatureLevel(dev), flags);
+    return d;
+}
+
+void nvvfx_device_destroy(nvvfx_device *d)
+{
+    if (!d)
+        return;
+    if (d->dev)
+        ID3D11Device_Release(d->dev);
+    free(d);
+}
