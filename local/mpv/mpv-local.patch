+int nvvfx_runtime_set_sdk_log(nvvfx_runtime *rt, int verbosity)
+{
+    NvCV_Status st;
+    if (!rt)
+        return NVVFX_E_ARG;
+    if (!rt->vfx.ConfigureLogger)
+        return NVVFX_E_UNSUPPORTED;
+    if (verbosity < 0) {
+        st = rt->vfx.ConfigureLogger(0, NULL, NULL, NULL);
+        rt->logger_on = 0;
+    } else {
+        st = rt->vfx.ConfigureLogger(verbosity, NULL, sdk_log_cb, rt);
+        rt->logger_on = st == NVCV_SUCCESS;
+    }
+    return st == NVCV_SUCCESS ? NVVFX_OK : sdk_fail(rt, NVVFX_LOG_WARN, 0, st, "NvVFX_ConfigureLogger");
+}
