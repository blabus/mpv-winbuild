+static int sdk_fail(nvvfx_runtime *rt, int level, int refused, NvCV_Status st, const char *fmt, ...)
+{
+    char what[256];
+    const char *name = nvcv_name(st);
+    const char *s = rt->cv.GetErrorStringFromCode ? rt->cv.GetErrorStringFromCode(st) : NULL;
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(what, sizeof(what), fmt, ap);
+    va_end(ap);
+    what[sizeof(what) - 1] = 0;
+    if (s && strcmp(s, name) == 0)
+        s = NULL;
+    return fail_at(&rt->lg, level, NVVFX_E_SDK, st, refused, "%s failed: %s (%d)%s%s",
+                   what, name, st, s ? " - " : "", s ? s : "");
+}
